{
  "name": "hobbes",
  "version": "0.9.58",
  "description": "A local-first, hotkey-summoned AI assistant.",
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.css -o ./assets/tailwind.css",
    "watch:css": "tailwindcss -i ./tailwind.css -o ./assets/tailwind.css --watch",
    "sync:mermaid": "cp node_modules/mermaid/dist/mermaid.min.js assets/mermaid.min.js"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "mermaid": "^12.0.0",
    "tailwindcss": "^3.4.1"
  }
}
