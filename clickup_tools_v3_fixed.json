event: message
data: {"result":{"tools":[{"name":"ABSTRACT_VALIDATE_EMAIL","description":"Tool to validate whether an email address is real and deliverable. Use after collecting an email address to confirm deliverability.","inputSchema":{"type":"object","properties":{"auto_correct":{"type":["boolean","null"],"description":"Whether to auto-correct typos in the submitted email (default: True).\nExamples:\n  true\n  false","default":true},"email":{"type":"string","description":"The email address to validate.\nExample: \"johnsmith@gmail.com\""}},"required":["email"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Email Validation","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"ABUSELPDB_CHECK_IP","description":"Tool to check the reputation of an IP address. Use when you need to determine if an IP address has been reported for abusive activity within a specified look-back period. Example: CheckIp(ipAddress='8.8.8.8', maxAgeInDays=90).","inputSchema":{"type":"object","properties":{"ipAddress":{"type":"string","description":"IPv4 address to check for abuse reports.\nExample: \"8.8.8.8\""},"maxAgeInDays":{"anyOf":[{"type":"integer","minimum":0,"maximum":365},{"type":"null"}],"description":"Look-back period for reports in days (default=30, max=365).\nExample: 30","default":30},"verbose":{"type":["boolean","null"],"description":"Include additional data such as hostnames and domains.\nExample: true","default":false}},"required":["ipAddress"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Check IP Reputation","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"ACTIVE_CAMPAIGN_CREATE_CONTACT","description":"Creates a new contact in ActiveCampaign with the specified details. This action allows you to create a new contact with basic information like email, name, phone, organization details, and tags. The email address is the only required field, while all other fields are optional.","inputSchema":{"type":"object","properties":{"email":{"type":"string","format":"email","description":"The email address of the contact\nExample: \"example@domain.com\""},"first_name":{"type":["string","null"],"description":"The contact's first name\nExample: \"John\"","default":null},"job_title":{"type":["string","null"],"description":"The contact's job title\nExample: \"Manager\"","default":null},"last_name":{"type":["string","null"],"description":"The contact's last name\nExample: \"Doe\"","default":null},"organization_name":{"type":["string","null"],"description":"The name of the contact's organization\nExample: \"Company Inc\"","default":null},"phone":{"type":["string","null"],"description":"The contact's phone number\nExample: \"1234567890\"","default":null},"tags":{"type":["string","null"],"description":"Comma-separated list of tags to apply to the contact\nExample: \"lead, customer\"","default":null}},"required":["email"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create contact","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"ACTIVE_CAMPAIGN_FIND_CONTACT","description":"Find a specific contact in ActiveCampaign using either their email address, ID, or phone number. This action provides a more efficient way to find a specific contact instead of listing all contacts.","inputSchema":{"type":"object","properties":{"email":{"type":["string","null"],"description":"The email address of the contact\nExample: \"user@example.com\"","default":null},"id":{"type":["string","null"],"description":"The ActiveCampaign ID of the contact\nExample: \"123\"","default":null},"phone":{"type":["string","null"],"description":"The phone number of the contact. Note: Phone search uses the general search parameter internally, which may return partial matches. When combined with email, results are filtered client-side to match both criteria.\nExample: \"+1234567890\"","default":null}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Find contact","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"ACTIVE_CAMPAIGN_MANAGE_CONTACT_TAG","description":"Manage tags for a contact in ActiveCampaign. This action allows adding or removing tags from a contact. The action can be performed using either the contact's ID or email address.","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["Add","Remove"],"description":"The action to perform on the tags\nExamples:\n  \"Add\"\n  \"Remove\""},"contact_email":{"anyOf":[{"type":"string","format":"email"},{"type":"null"}],"description":"The email of the contact (used if contact_id is not provided)\nExample: \"example@email.com\"","default":null},"contact_id":{"type":["string","null"],"description":"The ID of the contact to manage tags for\nExample: \"123\"","default":null},"tags":{"anyOf":[{"type":"string"},{"type":"array","items":{"type":"string"}}],"description":"Tags to add/remove. Can be a comma-separated string or list of strings\nExamples:\n  \"tag1, tag2\"\n  [\"tag1\",\"tag2\"]"}},"required":["action","tags"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Manage contact tag","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"ACTIVE_CAMPAIGN_TRACK_EVENT","description":"This tool creates a custom website or application event in ActiveCampaign by recording events through a POST API endpoint. It allows tracking of specific actions performed by contacts, and includes parameters such as event_key, event_actid, event_name, event_value, and event_contact_email for authentication, recording, and contextual information. The tool aids in automating workflows and monitoring user engagement.","inputSchema":{"type":"object","properties":{"event_actid":{"type":"string","description":"Your ActiveCampaign Account ID (9-digit number)."},"event_contact_email":{"type":"string","description":"Email address of the contact for whom the event is being tracked. Must be an existing contact in ActiveCampaign.\nExample: \"user@example.com\""},"event_key":{"type":"string","description":"Your Event Key from ActiveCampaign settings."},"event_name":{"type":"string","description":"Name of the event to track. This should be whitelisted in ActiveCampaign for automation usage.\nExamples:\n  \"file_download\"\n  \"button_click\"\n  \"login\""},"event_value":{"type":["string","null"],"description":"Additional data or value associated with the event (optional).\nExamples:\n  \"https://example.com/downloads/file.pdf\"\n  \"premium_subscription\"","default":null}},"required":["event_actid","event_contact_email","event_key","event_name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Track Event in ActiveCampaign","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENT_MAIL_LIST_MESSAGES","description":"List messages from an AgentMail inbox","inputSchema":{"type":"object","properties":{"ascending":{"type":["boolean","null"],"description":"Whether to sort messages in ascending order by timestamp\nExamples:\n  true\n  false","default":false},"inbox_id":{"type":"string","description":"The inbox ID or email address to list messages from\nExamples:\n  \"agent@agentmail.to\"\n  \"inbox_123\""},"labels":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"default":null,"description":"Filter messages by labels\nExamples:\n  [\"unread\"]\n  [\"important\",\"inbox\"]"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Maximum number of messages to return (1-100)\nExamples:\n  10\n  50\n  100","default":50},"page_token":{"type":["string","null"],"default":null,"description":"Token for pagination to get the next set of results\nExample: \"next_page_token_123\""}},"required":["inbox_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List Messages","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENT_MAIL_SEND_EMAIL","description":"Send an email using AgentMail API","inputSchema":{"type":"object","properties":{"bcc":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"default":null,"description":"List of BCC recipient email addresses\nExample: [\"audit@example.com\"]"},"cc":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"default":null,"description":"List of CC recipient email addresses\nExample: [\"manager@example.com\",\"team@example.com\"]"},"html":{"type":["string","null"],"default":null,"description":"HTML content of the email. If provided, both text and html should be included for best compatibility.\nExample: \"<p>Hello, this is an <strong>HTML</strong> email.</p>\""},"inbox_id":{"type":"string","description":"The inbox ID or email address to send from (e.g., 'agent@agentmail.to')\nExamples:\n  \"agent@agentmail.to\"\n  \"inbox_123\""},"labels":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"default":null,"description":"Labels to apply to the sent message\nExamples:\n  [\"important\"]\n  [\"campaign\",\"outreach\"]"},"reply_to":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"default":null,"description":"Reply-to email addresses\nExample: [\"noreply@example.com\"]"},"subject":{"type":["string","null"],"default":null,"description":"Email subject line\nExamples:\n  \"Meeting invitation\"\n  \"Project update\""},"text":{"type":["string","null"],"default":null,"description":"Plain text content of the email\nExample: \"Hello, this is a plain text email.\""},"to":{"type":"array","items":{"type":"string"},"description":"List of recipient email addresses\nExamples:\n  [\"recipient@example.com\"]\n  [\"user1@example.com\",\"user2@example.com\"]"}},"required":["inbox_id","to"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Send Email","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENTQL_AGENTQL_QUERY_DATA","description":"Tool to query structured data as JSON from a web page using an AgentQL query or natural language prompt. Use after defining your query or prompt and a URL or HTML.","inputSchema":{"type":"object","properties":{"html":{"type":["string","null"],"default":null,"description":"Raw HTML content to query. Provide either 'html' or 'url'."},"params":{"anyOf":[{"type":"object","properties":{"is_screenshot_enabled":{"type":"boolean","description":"Whether to take a screenshot before extracting data. Included in metadata if enabled.\nExample: false","default":false},"is_scroll_to_bottom_enabled":{"type":"boolean","description":"Whether to scroll to the bottom of the page before querying.\nExample: false","default":false},"mode":{"type":"string","enum":["standard","fast"],"description":"Extraction mode: 'standard' for deeper analysis or 'fast' for speed.\nExamples:\n  \"standard\"\n  \"fast\"","default":"fast"},"wait_for":{"type":"number","minimum":0,"description":"Seconds to wait for the page to load before querying.\nExample: 0","default":0}},"additionalProperties":false},{"type":"null"}],"default":null,"description":"Parameters controlling wait time, scrolling, extraction mode, and screenshot."},"prompt":{"type":["string","null"],"default":null,"description":"Natural language prompt describing data to extract. Provide either 'prompt' or 'query'.\nExample: \"List all product names and their prices.\""},"query":{"type":["string","null"],"default":null,"description":"AgentQL query string. Provide either 'query' or 'prompt'.\nExample: \"{ products[] { name price } }\""},"url":{"type":["string","null"],"default":null,"description":"URL of the public web page to query. Provide either 'url' or 'html'.\nExample: \"https://example.com/products\""}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Query Data","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENTQL_CREATE_REMOTE_BROWSER_SESSION","description":"Tool to create a remote browser session. Use when you need to run browser automation on remote infrastructure.","inputSchema":{"type":"object","properties":{"browser_ua_preset":{"anyOf":[{"type":"string","enum":["windows","macos","linux"]},{"type":"null"}],"default":null,"description":"User agent preset to simulate different operating systems. Supported values: 'windows', 'macos', 'linux'.\nExample: \"windows\""}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create Remote Browser Session","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENTY_AGENTS_CONTROLLER_CREATE_AGENT","description":"Tool to create a new agent. Use when you need to add an agent with configuration and optional auto-start.","inputSchema":{"type":"object","properties":{"account_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Account ID associated with the agent","default":null},"agent_id":{"type":["string","null"],"description":"Unique agent ID. If omitted, generated by server","default":null},"config":{"type":"object","properties":{},"additionalProperties":true,"description":"Configuration object for the agent"},"created_at":{"type":["string","null"],"description":"Creation timestamp","default":null},"description":{"type":["string","null"],"description":"Description of the agent, max 1000 characters\nExample: \"My scraping agent\"","default":null},"icon":{"type":["string","null"],"description":"URL or name of the icon","default":null},"is_managed":{"type":["boolean","null"],"description":"Whether the agent is managed by system","default":null},"is_public":{"type":["boolean","null"],"description":"Whether the agent is public","default":null},"name":{"type":"string","description":"Agent name, max 100 characters\nExample: \"My Agent\""},"project_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Project ID to associate with the agent","default":null},"scheduler":{"anyOf":[{"type":"object","properties":{"description":{"type":["string","null"],"description":"Human-readable description of the schedule","default":null},"expression":{"type":["string","null"],"description":"CRON expression for the schedule","default":null},"frequency":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Interval frequency in seconds","default":null},"is_enabled":{"type":["boolean","null"],"description":"Whether the schedule is enabled","default":null},"type":{"type":["string","null"],"description":"Schedule type (e.g., 'cron' or 'interval')","default":null}},"additionalProperties":false,"description":"Scheduler"},{"type":"null"}],"description":"Scheduler configuration for the agent","default":null},"scripts":{"anyOf":[{"type":"object","properties":{"post":{"anyOf":[{"type":"object","properties":{"code":{"type":["string","null"],"description":"Script code","default":null},"is_enabled":{"type":["boolean","null"],"description":"Whether the script is enabled","default":null},"is_parallel_execution":{"type":["boolean","null"],"description":"Whether post script runs in parallel","default":null}},"additionalProperties":false,"description":"Script"},{"type":"null"}],"description":"Post-execution script","default":null},"pre":{"anyOf":[{"type":"object","properties":{"code":{"type":["string","null"],"description":"Script code","default":null},"is_enabled":{"type":["boolean","null"],"description":"Whether the script is enabled","default":null},"is_parallel_execution":{"type":["boolean","null"],"description":"Whether post script runs in parallel","default":null}},"additionalProperties":false,"description":"Script"},{"type":"null"}],"description":"Pre-execution script","default":null}},"additionalProperties":false,"description":"Scripts"},{"type":"null"}],"description":"Scripts to run pre- and post-execution","default":null},"start":{"type":["boolean","null"],"description":"Auto-start the agent after creation (true or false)","default":null},"tags":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"List of tags for categorizing the agent","default":null},"type":{"type":"string","enum":["scraping","changedetection","crawling","mapmonitoring","brandmonitoring"],"description":"Type of the agent"},"updated_at":{"type":["string","null"],"description":"Last update timestamp","default":null},"user_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"User ID associated with the agent","default":null},"version":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Version number of the agent","default":null}},"required":["config","name","type"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create Agent","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENTY_AGENTS_GET_ALL","description":"Tool to fetch all active agents under an account. Use after authenticating when you need to list agents with pagination and sorting.","inputSchema":{"type":"object","properties":{"limit":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}],"description":"Maximum number of records to return.\nExample: 50","default":null},"offset":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}],"description":"Number of records to skip before starting to return results.\nExample: 0","default":null},"order":{"anyOf":[{"type":"string","enum":["asc","desc"]},{"type":"null"}],"description":"Order of sorting; possible values are 'asc' (ascending) and 'desc' (descending).\nExample: \"asc\"","default":null},"sort":{"type":["string","null"],"description":"Field by which to sort the results, e.g., 'name' or 'created_at'.\nExample: \"name\"","default":null}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Fetch all agents","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENTY_JOBS_DOWNLOAD_RESULT_BY_ID","description":"Tool to download the agent output result by job ID. Use when you need to fetch the final output of a completed job in CSV, TSV, or JSON format.","inputSchema":{"type":"object","properties":{"collection":{"type":"integer","minimum":1,"description":"Result collection number to fetch\nExample: 1","default":1},"format":{"type":"string","enum":["CSV","TSV","JSON"],"description":"Format of the downloaded file: CSV, TSV, or JSON\nExample: \"CSV\""},"job_id":{"type":"integer","minimum":1,"description":"Unique identifier of the job to download result for\nExample: 123"},"limit":{"type":"integer","minimum":1,"maximum":1000,"description":"Maximum number of items to return\nExample: 1000","default":1000},"offset":{"type":"integer","minimum":0,"description":"Number of items to skip before starting to collect the result set\nExample: 0","default":0},"order":{"anyOf":[{"type":"string","enum":["asc","desc"]},{"type":"null"}],"description":"Sort order: asc or desc\nExample: \"asc\"","default":null},"sort":{"type":["string","null"],"description":"Field name to sort by\nExample: \"created_at\"","default":null}},"required":["format","job_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Download Job Result by ID","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENTY_JOBS_START","description":"Tool to start a new agent job. Use when you need to trigger execution of an existing agent.","inputSchema":{"type":"object","properties":{"agent_id":{"type":"string","description":"Unique identifier of the agent to start the job for.\nExample: \"agent_1234\""}},"required":["agent_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Start Agent Job","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENTY_LISTS_CONTROLLER_CREATE_LIST","description":"Tool to create a new list. Use after preparing the list name and optional description. Example: \"Create a list named 'Contacts' with description 'Potential leads'.\"","inputSchema":{"type":"object","properties":{"description":{"type":["string","null"],"description":"Description of the list, max 250 characters\nExample: \"A sample list of contacts\"","default":null},"name":{"type":"string","description":"Name of the list, max 100 characters\nExample: \"My List\""}},"required":["name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create List","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGENTY_LISTS_GET_ROWS_BY_ID","description":"Tool to fetch all rows in a specified list. Use when you need to retrieve all data entries from a list with optional pagination and sorting. Example: \"Fetch rows from list '61db...' with limit=50\".","inputSchema":{"type":"object","properties":{"limit":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}],"description":"Number of rows to return per request\nExample: 100","default":null},"list_id":{"type":"string","minLength":1,"description":"Unique identifier of the list to fetch rows from\nExample: \"61dbdbe71659fbc4670959db\""},"offset":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}],"description":"Number of rows to skip before starting to return rows\nExample: 0","default":null},"order":{"anyOf":[{"type":"string","enum":["asc","desc"]},{"type":"null"}],"description":"Sort order, either 'asc' or 'desc'\nExample: \"asc\"","default":null},"sort":{"type":["string","null"],"description":"Column name to sort the results by\nExample: \"col1\"","default":null}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Fetch List Rows by ID","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGILED_CREATE_PROJECT","description":"Tool to create a new project in Agiled. Use when you have collected all project details and need to set up the project before assigning tasks. Example: \"Create a new project named Website Redesign with start date 2023-09-01 and status in progress.\"","inputSchema":{"type":"object","properties":{"deadline":{"type":["string","null"],"description":"Deadline of the project in YYYY-MM-DD format\nExample: \"2023-12-31\"","default":null},"notes":{"type":["string","null"],"description":"Internal notes or comments for the project\nExample: \"Kickoff meeting scheduled.\"","default":null},"project_name":{"type":"string","description":"Title of the project\nExample: \"Website Redesign\""},"project_summary":{"type":["string","null"],"description":"Brief summary of the project\nExample: \"Redesign the corporate website for improved UX.\"","default":null},"start_date":{"type":"string","description":"Start date of the project in YYYY-MM-DD format\nExample: \"2023-09-01\""},"status":{"type":"string","enum":["in progress","on hold","canceled","finished","not started"],"description":"Current status of the project\nExamples:\n  \"in progress\"\n  \"not started\""}},"required":["project_name","start_date","status"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create Project","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGILED_CREATE_TASK","description":"Tool to create a new task in Agiled. Use when you have all task details and want to add it to your project board. Example: \"Create a task titled 'Draft specs' for project 45, assigned to user 7, priority normal, due date 2025-11-05.\"","inputSchema":{"type":"object","properties":{"assigned_to":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"User ID to assign this task to\nExample: 7","default":null},"description":{"type":["string","null"],"description":"Detailed description of the task\nExample: \"Write tests for task creation endpoint\"","default":null},"due_date":{"type":["string","null"],"description":"Due date of the task in YYYY-MM-DD format\nExample: \"2025-11-05\"","default":null},"followers":{"anyOf":[{"type":"array","items":{"type":"integer"}},{"type":"null"}],"description":"List of user IDs who will follow the task\nExample: [2,5]","default":null},"list_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"ID of the task list/column (e.g., backlog, in_progress)\nExample: 3","default":null},"priority":{"anyOf":[{"type":"string","enum":["low","normal","high"]},{"type":"null"}],"description":"Priority level of the task\nExample: \"normal\"","default":null},"project_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"ID of the project to which this task belongs\nExample: 45","default":null},"start_date":{"type":["string","null"],"description":"Start date of the task in YYYY-MM-DD format\nExample: \"2025-11-01\"","default":null},"status":{"anyOf":[{"type":"string","enum":["to_do","in_progress","done"]},{"type":"null"}],"description":"Current status of the task\nExample: \"to_do\"","default":null},"title":{"type":"string","description":"Title or summary of the task\nExample: \"Write unit tests\""}},"required":["title"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create Task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"AGILED_GET_EMPLOYEES","description":"Tool to retrieve a list of all employees. Use when you need up-to-date employee directory from Agiled.","inputSchema":{"type":"object","properties":{},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Employees","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"AGILED_GET_PROJECTS","description":"Tool to retrieve a list of all projects. Use after obtaining the API token.","inputSchema":{"type":"object","properties":{},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Projects","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"AGILED_GET_TASKS","description":"Tool to retrieve a list of all tasks. Use when you need to fetch all tasks across your account after authentication.","inputSchema":{"type":"object","properties":{},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"GET_TASKS","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"AGILITY_CMS_GET_CONTENT_ITEM","description":"Tool to fetch details of a content item by Content ID. Use when you need item fields and metadata from Agility CMS.","inputSchema":{"type":"object","properties":{"content_id":{"type":"integer","description":"Unique numeric ID of the content item.\nExample: 123"},"content_link_depth":{"type":"integer","minimum":0,"maximum":5,"description":"Depth for expanding linked content (0=none to 5=full). Default is 1.\nExample: 1","default":1},"expand_all_content_links":{"type":"boolean","description":"Whether to fully expand linked content objects. Default is False.\nExample: false","default":false},"locale":{"type":"string","description":"Locale code for the content (e.g., 'en-us').\nExample: \"en-us\"","default":"en-us"}},"required":["content_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Content Item","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"AGILITY_CMS_GET_CONTENT_LIST","description":"Tool to retrieve a list of content items by reference name. Use when you need to fetch and page through content list data with optional filtering, sorting, and link expansions.","inputSchema":{"type":"object","properties":{"contentLinkDepth":{"type":"integer","minimum":0,"maximum":5,"description":"Depth to which linked content items should be expanded (0 to 5).\nExample: 1","default":1},"direction":{"type":"string","enum":["asc","desc"],"description":"Sort direction: 'asc' or 'desc'.\nExamples:\n  \"asc\"\n  \"desc\"","default":"asc"},"expandAllContentLinks":{"type":"boolean","description":"Whether to fully expand all linked content items.\nExample: false","default":false},"fields":{"type":["string","null"],"description":"Comma-separated list of fields to include in the response.","default":null},"filter":{"type":["string","null"],"description":"Filter expression to apply to the content list.","default":null},"locale":{"type":"string","description":"Locale code for the content items (e.g., 'en-us').\nExample: \"en-us\""},"referenceName":{"type":"string","description":"Reference name of the content list to retrieve.\nExample: \"BlogPosts\""},"skip":{"type":"integer","minimum":0,"description":"Number of items to skip for pagination. Default is 0.\nExample: 0","default":0},"sort":{"type":["string","null"],"description":"Field to sort the results by.","default":null},"take":{"type":"integer","minimum":1,"description":"Number of items to retrieve per page. Default is 10.\nExample: 10","default":10}},"required":["locale","referenceName"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Content List","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_ADD_DEPENDENCY","description":"Adds a 'waiting on' or 'blocking' dependency to a task, requiring either `depends_on` (task becomes waiting on) or `dependency_of` (task becomes blocking), but not both; `team_id` is required if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"If true, `task_id` and related task IDs are custom (text-based), requiring `team_id`.\nExamples:\n  \"true\"\n  \"false\"","default":null},"dependency_of":{"type":["string","null"],"description":"ID of the task that will depend on `task_id` ('blocking' relationship). Use this or `depends_on`, not both.\nExamples:\n  \"task_id_C\"\n  \"custom_ref_789\"","default":null},"depends_on":{"type":["string","null"],"description":"ID of the task that `task_id` will depend on ('waiting on' relationship). Use this or `dependency_of`, not both.\nExamples:\n  \"task_id_B\"\n  \"custom_ref_456\"","default":null},"task_id":{"type":"string","description":"Unique identifier of the task to which a dependency relationship will be added.\nExamples:\n  \"123\"\n  \"custom_id_abc\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Team ID, required if `custom_task_ids` is true to look up tasks by custom IDs (unique per team).\nExamples:\n  \"12345\"\n  \"67890\"","default":null}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add dependency","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_GUEST_TO_FOLDER","description":"Adds a guest to a folder with specified permissions; requires a ClickUp Enterprise Plan.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"The unique identifier of the folder to which the guest will be added."},"guest_id":{"type":"integer","description":"The unique identifier of the guest user to be added to the folder."},"include_shared":{"type":["boolean","null"],"description":"If `true`, include shared item details (API default if parameter is omitted); if `false`, exclude them.","default":null},"permission_level":{"type":"string","description":"Permission level for the guest. Options are 'read' (view only), 'comment', 'edit', or 'create' (full access).\nExamples:\n  \"read\"\n  \"comment\"\n  \"edit\"\n  \"create\""}},"required":["folder_id","guest_id","permission_level"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add guest to folder","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_GUEST_TO_LIST","description":"Shares a ClickUp List with an existing guest user, granting them specified permissions; requires the Workspace to be on the ClickUp Enterprise Plan.","inputSchema":{"type":"object","properties":{"guest_id":{"type":"integer","description":"The unique numerical identifier of the guest user to be added to the List."},"include_shared":{"type":"boolean","description":"A boolean indicating whether to include details of items shared with the guest in the response. Set to `false` to exclude these details. If not provided or set to `true` (the API default), shared item details are included."},"list_id":{"type":"integer","description":"The unique numerical identifier of the List to which the guest will be added."},"permission_level":{"type":"string","description":"The permission level to be granted to the guest on this List. Accepted values are: `read` (view-only), `comment` (can add comments), `edit` (can edit existing items), or `create` (full access, including creating new items).\nExamples:\n  \"read\"\n  \"comment\"\n  \"edit\"\n  \"create\""}},"required":["guest_id","list_id","permission_level"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add guest to list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_GUEST_TO_TASK","description":"Assigns a guest to a task with specified permissions; requires ClickUp Enterprise Plan, and `team_id` if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Optional. Set to `true` if you are referencing the task by its custom task ID. If `true`, `team_id` must also be provided.\nExamples:\n  \"true\"\n  \"false\""},"guest_id":{"type":"integer","description":"The unique identifier of the guest user to be added to the task.\nExamples:\n  \"12345\"\n  \"67890\""},"include_shared":{"type":"boolean","description":"Optional. If set to `false`, details of items already shared with the guest will be excluded. The API defaults to `true` if this parameter is not explicitly set to `false`.\nExamples:\n  \"true\"\n  \"false\""},"permission_level":{"type":"string","description":"Permission level for the guest on this task. Must be one of: `read` (view only), `comment` (view and comment), `edit` (view, comment, and edit), or `create` (full permissions).\nExamples:\n  \"read\"\n  \"comment\"\n  \"edit\"\n  \"create\""},"task_id":{"type":"string","description":"The unique identifier of the task to which the guest will be added.\nExamples:\n  \"900900120103\"\n  \"task_123abc\""},"team_id":{"type":"integer","description":"Required if `custom_task_ids` is `true` to correctly identify the task when using a custom task ID.\nExamples:\n  \"123\"\n  \"456\""}},"required":["guest_id","permission_level","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add guest to task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_TAGS_FROM_TIME_ENTRIES","description":"Associates a list of specified tags with one or more time entries within a given Team (Workspace).","inputSchema":{"type":"object","properties":{"tags":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"A list of tag objects to add to the time entries. Each object should define the tag, typically including a 'name', and optionally 'tag_fg' (foreground color hex code) and 'tag_bg' (background color hex code).\nExample: \"[{\\\"name\\\": \\\"Urgent\\\", \\\"tag_fg\\\": \\\"#FFFFFF\\\", \\\"tag_bg\\\": \\\"#FF0000\\\"}, {\\\"name\\\": \\\"Client Review\\\"}]\""},"team_id":{"type":"integer","description":"The ID of the Team (Workspace) where the time entries are located.\nExamples:\n  \"18273645\"\n  \"90210123\""},"time_entry_ids":{"type":"array","items":{"type":"string"},"description":"A list of unique string identifiers for the time entries to which the tags will be added.\nExample: [\"time_entry_uuid_abcdef123\",\"time_entry_uuid_ghijkl456\"]"}},"required":["tags","team_id","time_entry_ids"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add tags from time entries","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_TAG_TO_TASK","description":"Adds an existing tag to a specified task; team_id is required if custom_task_ids is true.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"A boolean flag indicating whether the `task_id` provided is a custom task ID. If `true`, the `team_id` must also be provided.\nExamples:\n  true\n  false"},"tag_name":{"type":"string","description":"The name of the tag to add to the task. The tag must already exist in the workspace.\nExamples:\n  \"urgent\"\n  \"frontend_dev\""},"task_id":{"type":"string","description":"The ID of the task to which the tag will be added. This can be the standard task ID or a custom task ID if `custom_task_ids` is set to `true`.\nExamples:\n  \"task_abc_123\"\n  \"custom_id_456\""},"team_id":{"type":"integer","description":"The ID of the team (formerly Workspace) to which the task belongs. This is required only if `custom_task_ids` is set to `true`. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  123456\n  789012"}},"required":["tag_name","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add tag to task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_TASK_LINK","description":"Links two existing and accessible ClickUp tasks, identified by `task_id` (source) and `links_to` (target).","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"Set to `true` to indicate that `task_id` and `links_to` are custom task IDs rather than standard numerical IDs. If `true`, `team_id` must also be provided.\nExamples:\n  \"true\"\n  \"false\"","default":null},"links_to":{"type":"string","description":"The ID of the target task.\nExamples:\n  \"a5s6d7f8\"\n  \"target_task_id_example\""},"task_id":{"type":"string","description":"The ID of the source task.\nExamples:\n  \"q1w2e3r4\"\n  \"task_id_example\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The ID of the team, used when `custom_task_ids` is true to identify tasks by custom IDs. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"45678\"","default":null}},"required":["links_to","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add task link","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_TASK_TO_LIST","description":"Adds an existing task to an additional ClickUp List; the \"Tasks in Multiple Lists\" ClickApp must be enabled in the Workspace for this.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"Unique identifier of the List to which the task will be added.\nExamples:\n  186000000\n  9005000000"},"task_id":{"type":"string","description":"Unique identifier of the task to add to the List (actual task ID, not Custom Task ID).\nExamples:\n  \"abc123xyz\"\n  \"987defuvw\""}},"required":["list_id","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add task to list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ATTACHMENTS_UPLOAD_FILE_TO_TASK_AS_ATTACHMENT","description":"DEPRECATED: Use `create_task_attachment` to upload a file to a task; requires `multipart/form-data`.","inputSchema":{"type":"object","properties":{"attachment":{"type":"object","properties":{"mimetype":{"type":"string","description":"The MIME type of the file\nExamples:\n  \"application/pdf\"\n  \"image/jpeg\"\n  \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\""},"name":{"type":"string","description":"The filename that will be used when uploading the file to the destination service\nExamples:\n  \"document.pdf\"\n  \"image.jpg\"\n  \"report.docx\""},"s3key":{"type":"string","description":"The S3 key of a publicly accessible file, typically returned from a previous download action that stored the file in S3. This key references an existing file that can be uploaded to another service.\nExample: \"47563/gmail/GET_ATTACHMENT/response/12345\""}},"required":["mimetype","name","s3key"],"additionalProperties":false,"description":"The file to be uploaded as an attachment. FileUploadable object where 'name' should be the filename for the attachment (e.g., 'document.pdf', 'image.png'). Note: Files stored in the cloud (URLs) cannot be used - actual file content must be provided."},"custom_task_ids":{"type":["boolean","null"],"description":"If `true`, indicates that `task_id` should be interpreted as a custom task ID instead of the default ClickUp task ID. If this is `true`, `team_id` must also be provided.\nExamples:\n  \"true\"\n  \"false\"","default":null},"task_id":{"type":"string","description":"The unique identifier of the task to which the attachment will be added.\nExamples:\n  \"9hz456\"\n  \"task_123abc\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The ID of the team. This is required and used only if `custom_task_ids` is `true` to help locate the task by its custom ID. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"4567\"","default":null}},"required":["attachment","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create task attachment","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_AUTHORIZATION_GET_WORK_SPACE_LIST","description":"DEPRECATED: Use `get_authorized_teams_workspaces` instead to retrieve Workspaces (Teams) accessible to the authenticated user.","inputSchema":{"type":"object","properties":{},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get authorized teams workspaces","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CHANGE_TAG_NAMES_FROM_TIME_ENTRIES","description":"Updates the name, background color, and/or foreground color for an existing time entry tag, identified by its current `name` and `team_id`.","inputSchema":{"type":"object","properties":{"name":{"type":"string","description":"The current name of the time entry tag to be modified.\nExamples:\n  \"ClientMeeting\"\n  \"Development\""},"new_name":{"type":"string","description":"The new name to be assigned to the time entry tag.\nExamples:\n  \"Client Call\"\n  \"UrgentDev\""},"tag_bg":{"type":"string","description":"The new background color for the tag, specified as a hexadecimal color code.\nExamples:\n  \"#FF0000\"\n  \"#3366FF\""},"tag_fg":{"type":"string","description":"The new foreground (text) color for the tag, specified as a hexadecimal color code.\nExamples:\n  \"#FFFFFF\"\n  \"#000000\""},"team_id":{"type":"integer","description":"The unique identifier of the Team (Workspace) where the time entry tag exists.\nExample: 123456"}},"required":["name","new_name","tag_bg","tag_fg","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Change tag names from time entries","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CLICK_UP_GET_DOC_CONTENT","description":"Tool to fetch the full content of a ClickUp Doc including metadata and all page contents in markdown format. Use when you need to read or summarize a Doc's content given workspace_id and doc_id.","inputSchema":{"type":"object","properties":{"doc_id":{"type":"string","description":"The unique identifier for the document to retrieve.\nExamples:\n  \"doc_789\"\n  \"xyz456\""},"include_page_listing_only":{"type":["boolean","null"],"description":"If true, only fetch the list of pages without their content. Useful for discovering page structure without the full content retrieval overhead.","default":false},"page_ids":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"Optional list of specific page IDs to fetch. If provided, only these pages will be retrieved. If omitted, all pages in the doc will be fetched.\nExamples:\n  [\"page_1\",\"page_2\"]\n  [\"abc123\"]","default":null},"workspace_id":{"type":"string","description":"The workspace ID containing the document.\nExamples:\n  \"abc123\"\n  \"workspace_456\""}},"required":["doc_id","workspace_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Doc Content","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CLICK_UP_SEARCH_DOCS","description":"Tool to search and list Docs metadata in a ClickUp workspace. Use after confirming the workspace ID to quickly locate relevant meeting notes before fetching pages.","inputSchema":{"type":"object","properties":{"workspace_id":{"type":"string","description":"ID of the ClickUp Workspace to list Docs from\nExample: \"abcd1234\""}},"required":["workspace_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Search Docs","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_A_TIME_ENTRY","description":"Creates a new time entry for a specified team.","inputSchema":{"type":"object","properties":{"assignee":{"type":"integer","description":"The user ID of the person to assign this time entry to. Workspace owners and admins can assign to any user ID. Workspace members can only assign to their own user ID.\nExample: 555123"},"billable":{"type":"boolean","description":"Indicates whether the time entry is billable. Set to `true` if billable, `false` or omit if not.\nExamples:\n  true\n  false"},"custom_task_ids":{"type":"boolean","description":"If `true`, the `tid` parameter will be interpreted as a custom task ID. If this is `true`, the `team_id` query parameter must also be provided to specify the team context for the custom task ID.\nExamples:\n  true\n  false"},"description":{"type":"string","description":"An optional description for the time entry.\nExample: \"Worked on API integration module\""},"duration":{"type":"integer","description":"The duration of the time entry in milliseconds. Note: If `start` and `end` (or `stop`) times are also provided in the request, the ClickUp API will calculate the duration based on `start` and `end`/`stop`, and this `duration` field's value might be ignored or overridden by the server.\nExample: 3600000"},"end":{"type":"integer","description":"Alias for `stop`. The end time of the time entry, as a Unix timestamp in milliseconds. If both `start` and `end` are provided, the API will use these to determine the entry's actual duration, potentially overriding the `duration` field sent in the request.\nExample: 1672534800000"},"start":{"type":"integer","description":"The start time of the time entry, as a Unix timestamp in milliseconds.\nExample: 1672531200000"},"stop":{"type":"integer","description":"The stop time of the time entry, as a Unix timestamp in milliseconds. If both `start` and `stop` are provided, the API will use these to determine the entry's actual duration, potentially overriding the `duration` field sent in the request.\nExample: 1672534800000"},"tags":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"An array of Tag objects to apply to the time entry. Each Tag object should define 'name' (string), 'tag_fg' (hex color string for foreground), and 'tag_bg' (hex color string for background). This feature is available for users on the ClickUp Business Plan and above.\nExample: \"[{\\\"name\\\": \\\"Urgent\\\", \\\"tag_fg\\\": \\\"#FF0000\\\", \\\"tag_bg\\\": \\\"#FFFFFF\\\"}, {\\\"name\\\": \\\"ClientX\\\", \\\"tag_fg\\\": \\\"#0000FF\\\", \\\"tag_bg\\\": \\\"#EEEEEE\\\"}]\""},"team_Id":{"type":"integer","description":"The Workspace ID (also called Team ID in ClickUp API) where the time entry will be added. This goes in the URL path.\nExample: 123456"},"team_id":{"type":"integer","description":"The ID of the Team, required only if `custom_task_ids` is set to `true`. This specifies the team context for the custom task ID. Example: `custom_task_ids=true&team_id=123`.\nExample: 789012"},"tid":{"type":"string","description":"The ID of the task to associate this time entry with. If `custom_task_ids` is `true`, this should be the custom task ID.\nExamples:\n  \"abc123xyz\"\n  \"custom_id_456\""}},"required":["duration","start","team_Id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_CHAT_VIEW_COMMENT","description":"Posts a new comment to a specified ClickUp Chat view; the 'view_id' must correspond to an existing and accessible Chat view.","inputSchema":{"type":"object","properties":{"comment_text":{"type":"string","description":"The text content of the comment to be added.\nExamples:\n  \"This is an important update.\"\n  \"Let's follow up on this tomorrow.\""},"notify_all":{"type":"boolean","description":"If `True`, notifications for this comment will be sent to all members of the Chat view, including the comment creator. If `False`, notifications will follow standard ClickUp behavior.\nExamples:\n  true\n  false"},"view_id":{"type":"string","description":"The unique identifier of the Chat view where the comment will be posted.\nExamples:\n  \"105\"\n  \"chat_view_abc123\""}},"required":["comment_text","notify_all","view_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create chat view comment","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_CHECKLIST","description":"Creates a new checklist with a specified name within an existing task, which can be identified by its standard ID or a custom task ID (if `custom_task_ids` is true, `team_id` is also required).","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"If true, `task_id` is treated as a custom task ID, requiring `team_id`.\nExamples:\n  true\n  false","default":null},"name":{"type":"string","description":"Name for the new checklist.\nExamples:\n  \"Pre-launch Checklist\"\n  \"Onboarding Steps\"\n  \"Daily Review\""},"task_id":{"type":"string","description":"Unique identifier of the task for the new checklist; can be a standard or custom task ID (if `custom_task_ids` is true).\nExamples:\n  \"task_abc_123\"\n  \"custom_id_456\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Team's unique identifier; required only if `custom_task_ids` is true.\nExamples:\n  123456\n  789012","default":null}},"required":["name","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create checklist","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_CHECKLIST_ITEM","description":"Creates a new checklist item within a specified, existing checklist, optionally setting the item's name and assigning it to a user.","inputSchema":{"type":"object","properties":{"assignee":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"User ID of the ClickUp user to whom this item will be assigned. If omitted, the item will be unassigned.\nExamples:\n  \"183\"\n  \"281\"","default":null},"checklist_id":{"type":"string","description":"UUID of the parent checklist where the new item will be created; this checklist must already exist.\nExample: \"7a1b3c5d-04e9-4f6a-882d-1c9b7e0a3d2f\""},"name":{"type":"string","description":"Name for the new checklist item.\nExamples:\n  \"Finalize report\"\n  \"Send follow-up email\""}},"required":["checklist_id","name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create checklist item","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_FOLDER","description":"Creates a new ClickUp Folder within the specified Space, which must exist and be accessible.","inputSchema":{"type":"object","properties":{"name":{"type":"string","description":"The name of the Folder to be created.\nExample: \"New Project Folder\""},"space_id":{"type":"integer","description":"Numerical ID of the Space in which to create the Folder.\nExample: \"12345678\""}},"required":["name","space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create folder","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_FOLDERLESS_LIST","description":"Creates a new folderless list (a list not part of any Folder) directly within a specified ClickUp Space.","inputSchema":{"type":"object","properties":{"assignee":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"`user_id` of the list owner. Null for no specific owner.\nExamples:\n  \"18300\"\n  \"20500\"","default":null},"content":{"type":["string","null"],"description":"Description for the list (plain text or markdown).\nExamples:\n  \"List of all tasks related to Q1 marketing campaigns.\"\n  \"## Project Phoenix\\nAll tasks for the new platform UI.\"","default":null},"due_date":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Due date for the list (POSIX timestamp in milliseconds).\nExamples:\n  \"1678886400000\"\n  \"1700000000000\"","default":null},"due_date_time":{"type":["boolean","null"],"description":"Indicates if `due_date` includes time (`true`) or is all-day (`false`). Required if `due_date` is set.\nExamples:\n  true\n  false","default":null},"name":{"type":"string","description":"Name for the new folderless list.\nExamples:\n  \"Q1 Marketing Initiatives\"\n  \"Development Sprint 3\""},"priority":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Priority level: `1` (Urgent), `2` (High), `3` (Normal), `4` (Low). Null to remove priority.\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\"","default":null},"space_id":{"type":"integer","description":"Identifier of the Space for the new folderless list.\nExamples:\n  \"123456\"\n  \"789012\""},"status":{"type":["string","null"],"description":"List color (e.g., 'red', 'blue_blended'), distinct from task statuses within the list. Null for no color.\nExamples:\n  \"red\"\n  \"green_bright\"\n  \"blue_blended\"","default":null}},"required":["name","space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create folderless list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_FOLDER_VIEW","description":"Creates a new, highly customizable view within a specific ClickUp folder using its `folder_id`.","inputSchema":{"type":"object","properties":{"columns__fields":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"Array of field objects to display as columns in the view. Each element must be an object. Custom Fields require the `_cf` prefix followed by the Custom Field ID (e.g., `_cf_xxxxxxxx`).\nExample: [{\"id\":\"title\"},{\"id\":\"assignee\"},{\"id\":\"_cf_a1b2c3d4\"}]"},"divide__collapsed":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"Array of identifiers for divided sections to collapse by default, or null if no sections should be collapsed.","default":null},"divide__dir":{"type":"null","description":"This field must be `null` (None). It is intended for specifying sort direction within divided sections, but its configuration is not fully detailed."},"divide__field":{"type":"null","description":"This field must be `null` (None). It is intended for view division features (e.g., swimlanes) whose specific configuration via this parameter is not fully detailed."},"filters__fields":{"type":"array","items":{"type":"string"},"description":"Fields to filter by. Each element represents a filter condition. View the list of available fields in ClickUp's API documentation. Required when any filter parameter is provided.\nExample: [\"priority\",\"assignee\"]"},"filters__op":{"type":"string","description":"Operator for combining filters. The available operator (`op`) values are `AND` and `OR`. Required when any filter parameter is provided.\nExamples:\n  \"AND\"\n  \"OR\""},"filters__search":{"type":"string","description":"Text string to search for within tasks, comments, and subtasks in the view. Required when any filter parameter is provided.\nExamples:\n  \"Urgent Task\"\n  \"Client Feedback\""},"filters__show__closed":{"type":"boolean","description":"If `true`, tasks with a closed status are included in the view."},"folder_id":{"type":"integer","description":"Numeric ID of the folder where the new view will be created."},"grouping__collapsed":{"type":"array","items":{"type":"string"},"description":"An array of group identifiers (e.g., status names like 'Open', assignee IDs as strings like '123') that should be initially collapsed in the view. These identifiers depend on the `grouping__field` used. Required when any grouping parameter is provided.\nExamples:\n  [\"Open\",\"In Progress\"]\n  [\"123\",\"456\"]"},"grouping__dir":{"type":"integer","description":"Set a group sort order. Use `1` for ascending (e.g., urgent priority at top of the view, and tasks with no priority at the bottom) or `-1` to reverse the order (e.g., tasks with no priority at the top). Required when any grouping parameter is provided."},"grouping__field":{"type":"string","description":"Field to group tasks by. Options include: `none`, `status`, `priority`, `assignee`, `tag`, or `dueDate`. When any grouping parameter is provided, `grouping__field`, `grouping__dir`, `grouping__collapsed`, and `grouping__ignore` are all required.\nExamples:\n  \"status\"\n  \"priority\"\n  \"assignee\""},"grouping__ignore":{"type":"boolean","description":"If `true`, tasks with no value for the `grouping__field` will not be grouped and will appear in a separate 'Ungrouped' section. Required when any grouping parameter is provided."},"name":{"type":"string","description":"Name for the new view.\nExamples:\n  \"My Team's Board\"\n  \"Project Timeline View\""},"settings__collapse__empty__columns":{"type":"string","description":"Specifies whether to collapse columns with no tasks (e.g., in Board view). Common string values are 'true' or 'false'.\nExamples:\n  \"true\"\n  \"false\""},"settings__me__checklists":{"type":"boolean","description":"In 'Me Mode', if `true`, show only checklists assigned to the current user."},"settings__me__comments":{"type":"boolean","description":"In 'Me Mode', if `true`, show only comments where the current user is mentioned or assigned."},"settings__me__subtasks":{"type":"boolean","description":"In 'Me Mode', if `true`, show only subtasks assigned to the current user."},"settings__show__assignees":{"type":"boolean","description":"If `true`, display task assignees."},"settings__show__closed__subtasks":{"type":"boolean","description":"If `true`, include closed subtasks in the view."},"settings__show__images":{"type":"boolean","description":"If `true`, display task cover images or image attachments."},"settings__show__subtask__parent__names":{"type":"boolean","description":"If `true`, display parent task names for subtasks."},"settings__show__subtasks":{"type":"integer","description":"Controls subtask visibility. Acceptable integer values are `1` (show subtasks as separate tasks), `2` (expand subtasks under parent tasks), or `3` (collapse subtasks under parent tasks). "},"settings__show__task__locations":{"type":"boolean","description":"If `true`, display the List, Folder, and Space location for tasks. When any settings parameter is provided, a complete settings object with all settings keys is required."},"sorting__fields":{"type":"array","description":"Fields to sort tasks by. Each element must be an object with 'field' and 'dir' properties. 'dir' should be 1 for ascending or -1 for descending. Refer to ClickUp API for the exact structure.\nExample: [{\"dir\":1,\"field\":\"priority\"},{\"dir\":-1,\"field\":\"dueDate\"}]"},"team__sidebar__assigned__comments":{"type":"boolean","description":"If `true`, comments assigned to users will be shown in the team sidebar."},"team__sidebar__assignees":{"type":"array","items":{"type":"string"},"description":"List of user IDs (as strings). Tasks assigned to these users will appear in the 'Assignees' section of the team sidebar.\nExample: [\"183\",\"259\"]"},"team__sidebar__unassigned__tasks":{"type":"boolean","description":"If `true`, unassigned tasks will be shown in the team sidebar."},"type":{"type":"string","description":"The type of view to create. Options include: `list`, `board`, `calendar`, `table`, `timeline`, `workload`, `activity`, `map`, `conversation`, or `gantt`. \nExamples:\n  \"list\"\n  \"board\"\n  \"gantt\""}},"required":["folder_id","name","type"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create folder view","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_GOAL","description":"Creates a new goal in a ClickUp Team (Workspace).","inputSchema":{"type":"object","properties":{"color":{"type":"string","description":"Hex color string to associate with the goal.\nExamples:\n  \"#FF5733\"\n  \"#33FF57\""},"description":{"type":"string","description":"Detailed description for the goal.\nExample: \"Achieve a 20% increase in Q3 sales.\""},"due_date":{"type":"integer","description":"Due date for the goal, as a Unix timestamp in milliseconds.\nExample: 1672444800000"},"multiple_owners":{"type":"boolean","description":"Set to `true` if the goal will have multiple owners; `false` for a single owner.\nExamples:\n  true\n  false"},"name":{"type":"string","description":"Name for the goal.\nExample: \"Q3 Sales Target\""},"owners":{"type":"array","items":{"type":"integer"},"description":"List of user IDs to be assigned as owners of the goal.\nExample: [183,281]"},"team_id":{"type":"integer","description":"Numeric ID of the ClickUp Team (Workspace) where the goal will be created.\nExample: 123456"}},"required":["color","description","due_date","multiple_owners","name","owners","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create goal","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_KEY_RESULT","description":"Creates a new Key Result (Target) for a specified Goal in ClickUp to define and track measurable objectives towards achieving that Goal.","inputSchema":{"type":"object","properties":{"goal_id":{"type":"string","description":"The unique identifier (UUID) of the parent Goal for which this Key Result is being created.\nExample: \"900e-462d-a849-4a216b06d930\""},"list_ids":{"type":"array","items":{"type":"string"},"description":"An array of List UUIDs to link to this Key Result. Can be used with 'automatic' type Key Results to track progress based on tasks within these lists.\nExamples:\n  \"list_uuid_x\"\n  \"list_uuid_y\""},"name":{"type":"string","description":"The name for the new Key Result.\nExamples:\n  \"Increase monthly active users by 20%\"\n  \"Finalize Q3 report\""},"owners":{"type":"array","items":{"type":"integer"},"description":"A list of numerical user IDs to be assigned as owners of this Key Result.\nExamples:\n  \"183\"\n  \"255\""},"steps_end":{"type":"integer","description":"The target value indicating Key Result completion. For 'boolean' type, use 1 for true/complete. For 'automatic' type, this is often the total count of items to complete (e.g., number of linked tasks).\nExamples:\n  \"1\"\n  \"1000\"\n  \"10\""},"steps_start":{"type":"integer","description":"The initial value for tracking Key Result progress. For 'boolean' type, use 0 for false/incomplete, 1 for true/complete. For 'automatic' type, this is often the initial count (e.g., 0).\nExamples:\n  \"0\"\n  \"100\""},"task_ids":{"type":"array","items":{"type":"string"},"description":"An array of task UUIDs to link to this Key Result. Often used when `type` is 'automatic' to track progress via the completion status of these linked tasks.\nExamples:\n  \"task_uuid_1\"\n  \"task_uuid_2\""},"type":{"type":"string","description":"Specifies the type of the Key Result, which determines how progress is tracked. Supported types: 'number', 'currency', 'boolean', 'percentage', 'automatic'.\nExamples:\n  \"number\"\n  \"currency\"\n  \"boolean\"\n  \"percentage\"\n  \"automatic\""},"unit":{"type":"string","description":"The unit of measurement for Key Results of type 'number', 'currency', or 'percentage' (e.g., '$', '%', 'items'). This may not be applicable for 'boolean' or 'automatic' types where progress is count-based.\nExamples:\n  \"$\"\n  \"%\"\n  \"items\"\n  \"tasks completed\""}},"required":["goal_id","list_ids","name","owners","steps_end","steps_start","task_ids","type","unit"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create key result","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_LIST","description":"Creates a new list in ClickUp within an existing folder. This action requires a folder_id - lists cannot be created directly in a Space using this action. If you need to create a list directly in a Space (without placing it in a folder), use the 'CLICKUP_CREATE_FOLDERLESS_LIST' action with space_id instead.","inputSchema":{"type":"object","properties":{"assignee":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Optional. Numerical user ID of the assignee.\nExample: \"9876543\"","default":null},"content":{"type":["string","null"],"description":"Optional descriptive content or notes for the list.\nExamples:\n  \"Detailed plan for all Q3 marketing activities.\"\n  \"Tasks related to the initial phase of Project Alpha.\"","default":null},"due_date":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Optional due date for the list, represented as a POSIX timestamp in milliseconds. For example, `1695110307000` for September 19, 2023, 07:58:27 AM GMT.\nExample: \"1695110307000\"","default":null},"due_date_time":{"type":["boolean","null"],"description":"Optional. A boolean flag indicating whether the `due_date` includes a specific time. If `True`, the time component of `due_date` is respected. If `False` or not provided, the list is considered due on the entire day specified by `due_date`.\nExamples:\n  \"true\"\n  \"false\"","default":null},"folder_id":{"type":"integer","description":"The unique numerical identifier of the folder where the new list will be created. Note: This action creates a list within an existing folder. A folder_id is required and space_id cannot be used. If you want to create a list directly in a Space (without a folder), use the 'CLICKUP_CREATE_FOLDERLESS_LIST' action instead.\nExample: \"123456789\""},"name":{"type":"string","description":"The name to be assigned to the new list.\nExamples:\n  \"Q3 Marketing Plan\"\n  \"Project Alpha Tasks\""},"priority":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Optional priority level for the list. Integer values map to: 1 (Urgent), 2 (High), 3 (Normal), 4 (Low).\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\"","default":null},"status":{"type":["string","null"],"description":"Optional. Defines the list's color in the ClickUp UI (e.g., 'red', 'blue'). **Important:** This 'status' refers to the visual color of the list itself, not the workflow statuses (like 'To Do', 'In Progress') of tasks within the list.\nExamples:\n  \"red\"\n  \"blue\"\n  \"custom_color_status\"","default":null}},"required":["folder_id","name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_LIST_COMMENT","description":"Adds a new comment with specific text to an existing and accessible ClickUp List, assigns it to a user, and sets notification preferences for all list members.","inputSchema":{"type":"object","properties":{"assignee":{"type":"integer","description":"The User ID of the ClickUp user to whom this comment should be assigned, turning it into an actionable item.\nExamples:\n  \"183\"\n  \"9012\""},"comment_text":{"type":"string","description":"The textual content of the comment to be posted.\nExamples:\n  \"Please review the attached document.\"\n  \"This task is now unblocked.\""},"list_id":{"type":"integer","description":"The numerical ID of the ClickUp List where the comment will be posted.\nExamples:\n  \"1234567\"\n  \"9876543\""},"notify_all":{"type":"boolean","description":"If `true`, notifications about this comment will be sent to all members of the list, including the comment's creator. If `false` or omitted, default notification rules (e.g., based on mentions or assignments) will apply.\nExamples:\n  true\n  false"}},"required":["assignee","comment_text","list_id","notify_all"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create list comment","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_LIST_VIEW","description":"Creates a new, customizable view (e.g., list, board, calendar) within a specified ClickUp List, requiring an existing list_id accessible by the user.","inputSchema":{"type":"object","properties":{"columns__fields":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"field":{"type":"string","description":"Field identifier for the column (e.g., 'name', 'status', 'assignee', 'dueDate', or '_cf_FIELD_ID' for Custom Fields)."}},"required":["field"],"additionalProperties":false,"description":"Input model for column field configuration."}},{"type":"null"}],"description":"Array of column field objects. Each object must have 'field' (e.g., 'name', 'status', 'assignee', 'dueDate', or '_cf_FIELD_ID' for Custom Fields).\nExamples:\n  [{\"field\":\"assignee\"},{\"field\":\"dueDate\"}]\n  [{\"field\":\"name\"},{\"field\":\"status\"}]","default":null},"divide__collapsed":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"Array of identifiers for divided sections to collapse by default, or null if no sections should be collapsed.","default":null},"divide__dir":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Direction for secondary grouping: `1` for ascending, `-1` for descending.","default":null},"divide__field":{"type":["string","null"],"description":"Field for secondary grouping (dividing tasks within primary groups).","default":null},"filters__fields":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"field":{"type":"string","description":"Field to filter on (e.g., 'assignee', 'status', 'priority', 'tags')."},"op":{"type":["string","null"],"description":"Filter operator (e.g., 'EQ', 'NOT', 'IN', 'ANY', 'ALL', 'NOT ANY', 'NOT ALL', 'IS SET', 'IS NOT SET').","default":null},"values":{"anyOf":[{"type":"array"},{"type":"null"}],"description":"Values to filter against.","default":null}},"required":["field"],"additionalProperties":false,"description":"Input model for filter field configuration."}},{"type":"null"}],"description":"Array of filter field objects. Each object must have 'field' (e.g., 'assignee', 'status', 'priority', 'tags'), 'op' (e.g., 'EQ', 'NOT', 'IN', 'ANY'), and 'values' (array of filter values). Required when any filter parameter is provided.\nExamples:\n  [{\"field\":\"status\",\"op\":\"EQ\",\"values\":[\"in progress\"]}]\n  [{\"field\":\"priority\",\"op\":\"IN\",\"values\":[1,2]}]","default":null},"filters__op":{"type":["string","null"],"description":"Logical operator for combining filters: `AND` for all conditions, `OR` for any condition.\nExamples:\n  \"AND\"\n  \"OR\"","default":null},"filters__search":{"type":["string","null"],"description":"Search string to filter tasks by name or content.\nExamples:\n  \"API integration\"\n  \"urgent fix\"","default":null},"filters__show__closed":{"type":["boolean","null"],"description":"If `true`, includes closed tasks in the view.","default":null},"grouping__collapsed":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"List of group identifiers (e.g., status names, assignee IDs) to collapse by default.\nExamples:\n  [\"Closed\",\"Done\"]\n  [\"user_id_123\"]","default":null},"grouping__dir":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Group sort order: `1` for ascending (e.g., urgent priority top), `-1` for descending (e.g., no priority top).","default":null},"grouping__field":{"type":["string","null"],"description":"Field for grouping tasks (e.g., `none`, `status`, `priority`, `assignee`, `tag`, `dueDate`).\nExamples:\n  \"status\"\n  \"priority\"\n  \"assignee\"","default":null},"grouping__ignore":{"type":["boolean","null"],"description":"If `true`, hides tasks not falling into any specified group.","default":null},"list_id":{"type":"integer","description":"Numeric ID of the List where the new view will be created."},"name":{"type":"string","description":"Name for the new view.\nExamples:\n  \"New Project Board\"\n  \"Urgent Tasks List\""},"settings__collapse__empty__columns":{"type":["string","null"],"description":"Controls collapsing of empty columns. Values like 'true', 'false', or specific keywords (see ClickUp API).\nExamples:\n  \"true\"\n  \"false\"","default":null},"settings__me__checklists":{"type":["boolean","null"],"description":"If `true`, enables 'Me Mode' for checklists, filtering to tasks with checklists assigned to the current user.","default":null},"settings__me__comments":{"type":["boolean","null"],"description":"If `true`, enables 'Me Mode' for comments, filtering to tasks where the current user is involved in comments.","default":null},"settings__me__subtasks":{"type":["boolean","null"],"description":"If `true`, enables 'Me Mode' for subtasks, filtering to subtasks assigned to the current user.","default":null},"settings__show__assignees":{"type":["boolean","null"],"description":"If `true`, shows assignees' avatars or names on tasks.","default":null},"settings__show__closed__subtasks":{"type":["boolean","null"],"description":"If `true`, displays closed subtasks in the view.","default":null},"settings__show__images":{"type":["boolean","null"],"description":"If `true`, displays cover images or image attachments for tasks.","default":null},"settings__show__subtask__parent__names":{"type":["boolean","null"],"description":"If `true`, displays parent task names alongside subtasks.","default":null},"settings__show__subtasks":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Subtask visibility: `1` (separate tasks), `2` (expanded under parent), `3` (collapsed under parent).","default":null},"settings__show__task__locations":{"type":["boolean","null"],"description":"If `true`, displays task's location (e.g., List, Folder, Space) in the view.","default":null},"sorting__fields":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"dir":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Sort direction: 1 for ascending, -1 for descending.","default":null},"field":{"type":"string","description":"Field to sort by (e.g., 'dateCreated', 'name', 'dueDate', 'priority')."}},"required":["field"],"additionalProperties":false,"description":"Input model for sort field configuration."}},{"type":"null"}],"description":"Array of sort field objects. Each object must have 'field' (e.g., 'dateCreated', 'name', 'dueDate', 'priority') and optionally 'dir' (1 for ascending, -1 for descending).\nExamples:\n  [{\"dir\":-1,\"field\":\"dueDate\"}]\n  [{\"dir\":1,\"field\":\"name\"}]","default":null},"team__sidebar__assigned__comments":{"type":["boolean","null"],"description":"If `true`, team sidebar includes filter for tasks with assigned comments.","default":null},"team__sidebar__assignees":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"List of user IDs for quick assignee filtering in the team sidebar.\nExamples:\n  [\"12345\",\"67890\"]\n  [\"18\"]","default":null},"team__sidebar__unassigned__tasks":{"type":["boolean","null"],"description":"If `true`, team sidebar includes filter for unassigned tasks.","default":null},"type":{"type":"string","description":"View type (e.g., `list`, `board`, `calendar`, `table`, `timeline`, `workload`, `activity`, `map`, `conversation`, `gantt`).\nExamples:\n  \"list\"\n  \"board\"\n  \"calendar\""}},"required":["list_id","name","type"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create list view","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_SPACE","description":"Creates a new ClickUp Space within a specified Workspace, allowing feature configuration which defaults to Workspace settings if unspecified.","inputSchema":{"type":"object","properties":{"features__checklists__enabled":{"type":"boolean","description":"Enable/disable Checklists. Defaults to Workspace setting if `None`.\nExample: true"},"features__custom__fields__enabled":{"type":"boolean","description":"Enable/disable Custom Fields. Defaults to Workspace setting if `None`.\nExample: true"},"features__dependency__warning__enabled":{"type":"boolean","description":"Enable/disable Dependency Warning (shows conflict warnings). Defaults to Workspace setting if `None`.\nExample: true"},"features__due__dates__enabled":{"type":"boolean","description":"Enable/disable Due Dates. Defaults to Workspace setting if `None`.\nExample: true"},"features__due__dates__remap__closed__due__date":{"type":"boolean","description":"Enable/disable closed subtask due date remapping (if Due Dates & subtask remapping enabled). Defaults to Workspace setting if `None`.\nExample: false"},"features__due__dates__remap__due__dates":{"type":"boolean","description":"Enable/disable subtask due date remapping (if Due Dates enabled). Defaults to Workspace setting if `None`.\nExample: true"},"features__due__dates__start__date":{"type":"boolean","description":"Enable/disable Start Date for Due Dates (if Due Dates enabled). Defaults to Workspace setting if `None`.\nExample: true"},"features__portfolios__enabled":{"type":"boolean","description":"Enable/disable Portfolios. Defaults to Workspace setting if `None`.\nExample: true"},"features__remap__dependencies__enabled":{"type":"boolean","description":"Enable/disable Remap Dependencies (auto-adjusts task dates). Defaults to Workspace setting if `None`.\nExample: true"},"features__tags__enabled":{"type":"boolean","description":"Enable/disable Tags. Defaults to Workspace setting if `None`.\nExample: true"},"features__time__estimates__enabled":{"type":"boolean","description":"Enable/disable Time Estimates. Defaults to Workspace setting if `None`.\nExample: true"},"features__time__tracking__enabled":{"type":"boolean","description":"Enable/disable Time Tracking. Defaults to Workspace setting if `None`.\nExample: true"},"multiple_assignees":{"type":"boolean","description":"Enable/disable multiple assignees for tasks in this Space.\nExample: true"},"name":{"type":"string","description":"Name for the new Space.\nExample: \"Marketing Q3 Campaign\""},"team_id":{"type":"integer","description":"Numeric ID of the Workspace (Team) for the new Space.\nExample: \"123456\""}},"required":["multiple_assignees","name","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create space","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_SPACE_TAG","description":"Creates a new tag (name, foreground color, background color) in an existing ClickUp Space.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"Numeric ID of the Space to create the tag in.\nExample: 123456"},"tag__name":{"type":"string","description":"Name for the new tag. This parameter maps to the nested `tag.name` field in the API request.\nExamples:\n  \"Urgent\"\n  \"Bug\"\n  \"Feature Request\""},"tag__tag_bg":{"type":"string","description":"Hexadecimal background color for the tag. This parameter maps to the nested `tag.tag_bg` field in the API request.\nExample: \"#FF0000\""},"tag__tag_fg":{"type":"string","description":"Hexadecimal foreground (text) color for the tag. This parameter maps to the nested `tag.tag_fg` field in the API request.\nExample: \"#FFFFFF\""}},"required":["space_id","tag__name","tag__tag_bg","tag__tag_fg"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create space tag","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_SPACE_VIEW","description":"Creates a customizable view (e.g., List, Board, Gantt) within a specified ClickUp Space, allowing configuration of grouping, sorting, filtering, and display settings.","inputSchema":{"type":"object","properties":{"columns__fields":{"type":"array","items":{"type":"string"},"description":"Field identifiers for columns. Use standard field names (e.g., 'status') or Custom Field IDs with `_cf` prefix (e.g., 'ID_cf').\nExamples:\n  [\"name\",\"status\",\"priority\",\"custom_field_id_cf\"]\n  [\"dueDate\"]"},"divide__collapsed":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"Array of identifiers for divided sections to collapse by default, or null if no sections should be collapsed.","default":null},"divide__dir":{"type":"null","description":"Sort order for divided sections. Must be `None` if included, as sort direction for divisions may not be applicable here."},"divide__field":{"type":"null","description":"Field to divide tasks by. Must be `None` if included, as division by field may not be applicable for Space views via this action."},"filters__fields":{"type":"array","items":{"type":"string"},"description":"Fields to apply filters on. Refer to ClickUp API documentation for available filterable fields and their syntax.\nExamples:\n  [\"status__eq__open\",\"priority__gt__2\"]\n  [\"assignee__is__183\"]"},"filters__op":{"type":"string","description":"Logical operator (`AND` or `OR`) for combining filters. Required if multiple `filters__fields` are specified.\nExamples:\n  \"AND\"\n  \"OR\""},"filters__search":{"type":"string","description":"A search string to filter tasks by keywords or specific criteria within the view.\nExamples:\n  \"bug fix\"\n  \"client meeting\""},"filters__show__closed":{"type":"boolean","description":"If `True`, closed tasks are included in the view."},"grouping__collapsed":{"type":"array","items":{"type":"string"},"description":"A list of string identifiers for groups that should be collapsed by default (e.g., status names like 'Closed', or assignee user IDs if grouping by assignee). Required when any grouping parameter is provided.\nExamples:\n  [\"Closed\"]\n  [\"183\",\"512\"]"},"grouping__dir":{"type":"integer","description":"Group sort order: `1` for ascending, `-1` for descending. Required when any grouping parameter is provided.\nExamples:\n  \"1\"\n  \"-1\""},"grouping__field":{"type":"string","description":"The field to group tasks by. Options include: `none`, `status`, `priority`, `assignee`, `tag`, or `dueDate`. When any grouping parameter is provided, `grouping__field`, `grouping__dir`, `grouping__collapsed`, and `grouping__ignore` are all required.\nExamples:\n  \"status\"\n  \"priority\"\n  \"assignee\"\n  \"none\""},"grouping__ignore":{"type":"boolean","description":"If `True`, tasks not matching grouping criteria are hidden; otherwise, they are shown in a default group. Required when any grouping parameter is provided."},"name":{"type":"string","description":"The name for the new view.\nExamples:\n  \"My Custom Board View\"\n  \"Urgent Tasks List\""},"settings__collapse__empty__columns":{"type":"string","description":"If 'true', collapses empty columns (e.g., status columns with no tasks). Use string 'true' or 'false'.\nExamples:\n  \"true\"\n  \"false\""},"settings__me__checklists":{"type":"boolean","description":"If `True`, in 'Me Mode', this setting filters for or highlights tasks with checklist items assigned to the current user."},"settings__me__comments":{"type":"boolean","description":"If `True`, in 'Me Mode', this setting filters for or highlights tasks where the current user has made comments."},"settings__me__subtasks":{"type":"boolean","description":"If `True`, in 'Me Mode', this setting filters for or highlights subtasks assigned to the current user."},"settings__show__assignees":{"type":"boolean","description":"If `True`, displays task assignees in the view (e.g., on task cards)."},"settings__show__closed__subtasks":{"type":"boolean","description":"If `True`, includes closed subtasks in the view according to other filter criteria."},"settings__show__images":{"type":"boolean","description":"If `True`, displays cover images or image attachments directly on task cards in the view."},"settings__show__subtask__parent__names":{"type":"boolean","description":"If `True`, displays the parent task name next to subtasks for clarity."},"settings__show__subtasks":{"type":"integer","description":"How subtasks are displayed: `1` (show as separate tasks), `2` (show expanded under parent task), or `3` (show collapsed under parent task).\nExamples:\n  \"1\"\n  \"2\"\n  \"3\""},"settings__show__task__locations":{"type":"boolean","description":"If `True`, displays the task's location (List, Folder, Space)."},"sorting__fields":{"type":"array","items":{"type":"string"},"description":"Fields to sort tasks by (e.g., `dueDate`, `priority`). Refer to ClickUp API documentation for a complete list of sortable fields.\nExamples:\n  [\"dueDate\",\"priority\"]\n  [\"status\"]"},"space_id":{"type":"integer","description":"The unique identifier of the Space where the new view will be created."},"team__sidebar__assigned__comments":{"type":"boolean","description":"If `True`, shows tasks with comments assigned to the current user in the team sidebar."},"team__sidebar__assignees":{"type":"array","items":{"type":"string"},"description":"A list of user IDs (as strings) to filter by in the team sidebar.\nExample: [\"183\",\"512\"]"},"team__sidebar__unassigned__tasks":{"type":"boolean","description":"If `True`, shows unassigned tasks in the team sidebar."},"type":{"type":"string","description":"The type of view to create. Valid options include: `list`, `board`, `calendar`, `table`, `timeline`, `workload`, `activity`, `map`, `conversation`, or `gantt`.\nExamples:\n  \"list\"\n  \"board\"\n  \"calendar\"\n  \"gantt\""}},"required":["name","space_id","type"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create space view","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_TASK","description":"Creates a new ClickUp task in a specific list, optionally as a subtask if a `parent` task ID (which cannot be a subtask itself and must be in the same list) is provided.","inputSchema":{"type":"object","properties":{"assignees":{"type":"array","items":{"type":"integer"},"description":"User IDs to assign to the task.\nExamples:\n  \"183\"\n  \"281\""},"check_required_custom_fields":{"type":"boolean","description":"`True` to enforce filling all required Custom Fields upon creation."},"custom_fields":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"Custom fields to apply. See ClickUp API for structure."},"custom_item_id":{"type":"integer","description":"Custom task type ID. Omit or use `null` for standard tasks (recommended). Custom task types including Milestones (ID `1`) are subject to workspace plan quotas. Only specify a custom_item_id if you have confirmed the workspace has available quota for that task type. Use GET /team/{team_id}/custom_item to check available custom task types and their quotas."},"custom_task_ids":{"type":"boolean","description":"Enables referencing tasks by custom task ID; requires `team_id` if `true`."},"description":{"type":"string","description":"Task's detailed description."},"due_date":{"type":"integer","description":"Due date as a Unix timestamp in milliseconds.\nExample: \"1700000000000\""},"due_date_time":{"type":"boolean","description":"`True` if `due_date` includes a specific time, `false` if it's an all-day task."},"links_to":{"type":"string","description":"ID of an existing task to link as a dependency."},"list_id":{"type":"integer","description":"The ID of the list where the task will be created."},"name":{"type":"string","description":"The name of the new task.\nExample: \"Implement user authentication module\""},"notify_all":{"type":"boolean","description":"`True` to send notifications to all task watchers, including the creator."},"parent":{"type":"string","description":"ID of an existing task to be the parent (creating a subtask). Parent must not be a subtask and must be in the same list."},"priority":{"type":"integer","description":"Priority level: 1 (Urgent), 2 (High), 3 (Normal), 4 (Low).\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\""},"start_date":{"type":"integer","description":"Start date as a Unix timestamp in milliseconds.\nExample: \"1690000000000\""},"start_date_time":{"type":"boolean","description":"`True` if `start_date` includes a specific time, `false` if it's an all-day task."},"status":{"type":"string","description":"Status to set for the task. Must be an exact match (case-sensitive) to one of the status names configured in the target list. Each ClickUp list has its own set of available statuses. Use the GET /list/{list_id} endpoint to retrieve available statuses before creating tasks. If omitted, the task will be created with the list's default status."},"tags":{"type":"array","items":{"type":"string"},"description":"Tag names to apply.\nExamples:\n  \"important\"\n  \"backend_dev\""},"team_id":{"type":"integer","description":"Team ID, required only if `custom_task_ids` is `true`."},"time_estimate":{"type":"integer","description":"Estimated time to complete, in milliseconds.\nExample: \"3600000\""}},"required":["list_id","name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create a task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_TASK_COMMENT","description":"Adds a comment to a ClickUp task; `team_id` is required if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"assignee":{"type":"integer","description":"The user ID of the person to whom this specific comment should be assigned or mentioned. This assigns the comment, not the task.\nExamples:\n  183\n  54321"},"comment_text":{"type":"string","description":"The text content for the comment. Supports ClickUp's comment formatting (e.g., mentions, markdown).\nExamples:\n  \"@JohnDoe please review this.\"\n  \"Progress update: 75% complete.\"\n  \"This is an important update!\""},"custom_task_ids":{"type":"boolean","description":"Set to `true` to indicate that the `task_id` provided is a custom task ID. If `true`, the `team_id` must also be provided."},"notify_all":{"type":"boolean","description":"If `true`, notifications for this comment will be sent to all users watching the task, including the comment's creator. If `false`, notifications will be sent according to standard ClickUp notification rules (e.g., to mentioned users, comment assignee)."},"task_id":{"type":"string","description":"Unique task identifier for the comment. Can be standard or custom if `custom_task_ids` is true.\nExamples:\n  \"abc123xyz\"\n  \"custom-task-001\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Team ID, required if `custom_task_ids` is true to locate the task by its custom ID.\nExamples:\n  123\n  456","default":null}},"required":["assignee","comment_text","notify_all","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create task comment","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_TASK_FROM_TEMPLATE","description":"Creates a new task in a specified ClickUp list from a task template, using the provided name for the new task.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"Numeric ID of the ClickUp list for task creation, found in the list's URL.\nExample: 123456789"},"name":{"type":"string","description":"Name for the new task created from the template.\nExample: \"Follow up with new client\""},"template_id":{"type":"string","description":"Unique string ID of the task template to use.\nExample: \"041f0c75-b33c-4927-b2d5-8e25b49d995b_t123\""}},"required":["list_id","name","template_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create task from template","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_TEAM","description":"Creates a new team (user group) with specified members in a Workspace; member IDs must be for existing users, and be aware that adding view-only guests as paid members may incur extra charges.","inputSchema":{"type":"object","properties":{"members":{"type":"array","items":{"type":"integer"},"description":"User IDs to be initial members of the new team (user group).\nExamples:\n  [123456,789012]\n  [987654]"},"name":{"type":"string","description":"Name for the new team (user group).\nExamples:\n  \"Marketing Department\"\n  \"Engineering Squad\""},"team_id":{"type":"integer","description":"Workspace ID where the team (user group) will be created (this is referred to as 'Team ID' in the ClickUp API)."}},"required":["members","name","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create team","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_WEBHOOK","description":"Creates a ClickUp webhook for a Team (Workspace) to notify a public URL on specified events (at least one, or '*' for all), optionally scoped to a Space, Folder, List, or Task; the endpoint must accept requests from dynamic IPs.","inputSchema":{"type":"object","properties":{"endpoint":{"type":"string","description":"Publicly accessible URL for ClickUp to send POST notifications for subscribed events.\nExample: \"https://myapplication.com/api/clickup_webhook\""},"events":{"type":"array","items":{"type":"string"},"description":"Event types to subscribe to; use '*' for all events on the resource. Examples: 'taskCreated', 'taskUpdated'.\nExamples:\n  \"*\"\n  \"taskCreated\"\n  \"taskUpdated\"\n  \"listCreated\"\n  \"folderDeleted\""},"folder_id":{"type":"integer","description":"Optional. ID of the Folder to scope the webhook; triggers only for events in this Folder.\nExample: \"345678\""},"list_id":{"type":"integer","description":"Optional. ID of the List to scope the webhook; triggers only for events in this List.\nExample: \"901234\""},"space_id":{"type":"integer","description":"Optional. ID of the Space to scope the webhook; triggers only for events in this Space.\nExample: \"789012\""},"task_id":{"type":"string","description":"Optional. ID of the Task to scope the webhook; triggers only for events for this Task.\nExample: \"3ax5vyt\""},"team_id":{"type":"integer","description":"ID of the Team (Workspace) for the webhook.\nExample: \"1839200\""}},"required":["endpoint","events","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create webhook","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_WORKSPACE_EVERYTHING_LEVEL_VIEW","description":"Creates a new, customizable view (e.g., List, Board) at the 'Everything' level for a specified Team (Workspace ID), encompassing all tasks within that Workspace.","inputSchema":{"type":"object","properties":{"columns__fields":{"type":"array","items":{"type":"string"},"description":"Columns to display and their order. Prefix Custom Fields with `_cf`. For specific configurations, use a JSON object string."},"divide__collapsed":{"type":"array","items":{"type":"string"},"description":"List of division identifiers to be collapsed by default. Must be an array (e.g., []) or null, not a boolean."},"divide__dir":{"type":"null","description":"Sort direction for divided sections: `1` for ascending, `-1` for descending."},"divide__field":{"type":"null","description":"Field to divide the view by, creating separate sections (e.g., 'priority', 'status')."},"filters__fields":{"type":"array","items":{"type":"string"},"description":"Fields to apply filters on. See ClickUp API docs for filterable fields.\nExample: [\"status\",\"assignee\"]"},"filters__op":{"type":"string","description":"Logical operator for combining filters (`AND` or `OR`).\nExamples:\n  \"AND\"\n  \"OR\""},"filters__search":{"type":"string","description":"Search term to filter tasks by name, description, etc.\nExample: \"urgent project update\""},"filters__show__closed":{"type":"boolean","description":"If true, include tasks with 'Closed' status in the view."},"grouping__collapsed":{"type":"array","items":{"type":"string"},"description":"List of group identifiers (e.g., status names, assignee IDs) to be collapsed by default."},"grouping__dir":{"type":"integer","description":"Sort order for grouped tasks: `1` for ascending, `-1` for descending.\nExamples:\n  1\n  -1"},"grouping__field":{"type":"string","description":"Field to group tasks by (e.g., status, priority).\nExamples:\n  \"none\"\n  \"status\"\n  \"priority\"\n  \"assignee\"\n  \"tag\"\n  \"dueDate\""},"grouping__ignore":{"type":"boolean","description":"If true, tasks in closed statuses are excluded from grouping."},"name":{"type":"string","description":"Name for the new view.\nExample: \"All Tasks Overview\""},"settings__collapse__empty__columns":{"type":"string","description":"If true, collapse or hide empty columns.\nExamples:\n  \"true\"\n  \"false\""},"settings__me__checklists":{"type":"boolean","description":"If true, 'Me Mode' filters for tasks where current user is assigned to checklist items."},"settings__me__comments":{"type":"boolean","description":"If true, 'Me Mode' filters for tasks commented on by the current user."},"settings__me__subtasks":{"type":"boolean","description":"If true, 'Me Mode' filters for subtasks assigned to the current user."},"settings__show__assignees":{"type":"boolean","description":"If true, display task assignees."},"settings__show__closed__subtasks":{"type":"boolean","description":"If true, show closed subtasks according to `settings_show_subtasks`."},"settings__show__images":{"type":"boolean","description":"If true, show task cover images or attachment previews."},"settings__show__subtask__parent__names":{"type":"boolean","description":"If true, display parent task name next to subtasks."},"settings__show__subtasks":{"type":"integer","description":"Subtask display mode: `1` (separate), `2` (expand), `3` (collapse).\nExamples:\n  1\n  2\n  3"},"settings__show__task__locations":{"type":"boolean","description":"If true, display breadcrumb path (Space > Folder > List) for each task."},"sorting__fields":{"type":"array","items":{"type":"string"},"description":"Fields to sort tasks by. See ClickUp API docs for sortable fields.\nExample: [\"dueDate\",\"priority\"]"},"team__sidebar__assigned__comments":{"type":"boolean","description":"If true, team sidebar includes filter for tasks with assigned comments."},"team__sidebar__assignees":{"type":"array","items":{"type":"string"},"description":"List of user IDs to filter tasks by in the team sidebar.\nExample: [\"user_id_1\",\"user_id_2\"]"},"team__sidebar__unassigned__tasks":{"type":"boolean","description":"If true, team sidebar includes filter for unassigned tasks."},"team_id":{"type":"integer","description":"Team (Workspace) ID where the 'Everything' level view will be created.\nExample: 123456"},"type":{"type":"string","description":"Type of view to create (e.g., list, board, calendar).\nExamples:\n  \"list\"\n  \"board\"\n  \"calendar\"\n  \"table\"\n  \"timeline\"\n  \"workload\"\n  \"activity\"\n  \"map\"\n  \"conversation\"\n  \"gantt\""}},"required":["name","team_id","type"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create workspace Everything level view","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_A_TIME_ENTRY","description":"Deletes an existing time entry, specified by `timer_id`, from a Workspace identified by `team_id`.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"Unique identifier of the Workspace from which the time entry will be deleted.\nExample: \"1234567\""},"timer_id":{"type":"integer","description":"Unique identifier of the time entry to be deleted.\nExample: \"9876543\""}},"required":["team_id","timer_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_CHECKLIST","description":"Permanently deletes an existing checklist identified by its `checklist_id`.","inputSchema":{"type":"object","properties":{"checklist_id":{"type":"string","description":"The unique identifier (UUID) of the checklist to be deleted.\nExample: \"b8a8-48d8-a0c6-b4200788a683\""}},"required":["checklist_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete checklist","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_DELETE_CHECKLIST_ITEM","description":"Permanently deletes an existing item, identified by `checklist_item_id`, from an existing checklist, identified by `checklist_id`.","inputSchema":{"type":"object","properties":{"checklist_id":{"type":"string","description":"Unique identifier (UUID) of the checklist containing the item to be deleted.\nExample: \"b8a8-48d8-a0c6-b4200788a683\""},"checklist_item_id":{"type":"string","description":"Unique identifier (UUID) of the specific checklist item to be deleted.\nExample: \"e491-47f5-9fd8-d1dc4cedcc6f\""}},"required":["checklist_id","checklist_item_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete checklist item","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_COMMENT","description":"Deletes an existing comment from a task using its `comment_id`.","inputSchema":{"type":"object","properties":{"comment_id":{"type":"integer","description":"The unique identifier of the comment to be deleted.\nExamples:\n  \"123\"\n  \"456\""}},"required":["comment_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete comment","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_DELETE_DEPENDENCY","description":"Removes a dependency relationship for a task. Provide exactly one of: `depends_on` to remove a 'waiting on' dependency (task_id is blocked by another task), or `dependency_of` to remove a 'blocking' dependency (another task is blocked by task_id). `team_id` is required if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"If true, interprets `task_id` and the dependency task ID as custom task IDs; `team_id` also required.\nExamples:\n  \"true\"\n  \"false\"","default":null},"dependency_of":{"type":["string","null"],"description":"Identifier of the task that depends on `task_id` (i.e., this task is blocked by `task_id`). Provide this to remove a 'blocking' dependency. Mutually exclusive with `depends_on` - exactly one must be provided.\nExample: \"ghi789rst\"","default":null},"depends_on":{"type":["string","null"],"description":"Identifier of the task that `task_id` depends on (i.e., `task_id` is waiting on this task). Provide this to remove a 'waiting on' dependency. Mutually exclusive with `dependency_of` - exactly one must be provided.\nExample: \"def456uvw\"","default":null},"task_id":{"type":"string","description":"Identifier of the task from which the dependency relationship will be removed.\nExample: \"abc123xyz\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Numeric team ID, required only when `custom_task_ids` is true to scope custom task IDs.\nExample: \"12345\"","default":null}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete dependency","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_FOLDER","description":"Permanently and irreversibly deletes a specified folder and all its contents (Lists, Tasks) if the folder_id exists.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"The unique numerical identifier of the folder to be deleted."}},"required":["folder_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete folder","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_GOAL","description":"Permanently removes an existing Goal, identified by its `goal_id`, from the Workspace.","inputSchema":{"type":"object","properties":{"goal_id":{"type":"string","description":"The unique identifier (UUID) of the Goal to be deleted.\nExample: \"900e-462d-a849-4a216b06d930\""}},"required":["goal_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete goal","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_KEY_RESULT","description":"Deletes an existing Key Result, also referred to as a Target within a Goal, identified by its `key_result_id`.","inputSchema":{"type":"object","properties":{"key_result_id":{"type":"string","description":"The unique identifier (UUID) of the Key Result to be deleted. This is often referred to as a 'Target' in the context of Goals.\nExample: \"8480-49bc-8c57-e569747efe93\""}},"required":["key_result_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete key result","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_DELETE_LIST","description":"Permanently deletes an existing List and all its contents; this action is destructive and irreversible via the API.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"The unique numerical identifier of the List to be deleted. This ID can be found by navigating to the List in ClickUp; the ID is often present in the URL.\nExamples:\n  \"123\"\n  \"4567\""}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_SPACE","description":"Permanently deletes a specified Space in ClickUp; this action is irreversible as the Space cannot be recovered via the API.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"Unique numerical ID of the Space to be deleted.\nExample: \"183090932\""}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete space","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_SPACE_TAG","description":"Deletes a Tag from a Space, identified by `tag_name` in path; precise matching of Tag details in the request body (`tag_name_1`, `tag_tag_fg`, `tag_tag_bg`) is generally required for successful deletion.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"Numeric identifier of the Space from which the Tag will be deleted.\nExamples:\n  \"12345678\"\n  \"87654321\""},"tag__name":{"type":"string","description":"Name of the Tag in the request body. Though schema-optional, generally required by the API to match the Tag's actual name for successful deletion.\nExamples:\n  \"Urgent\"\n  \"ProjectAlpha\""},"tag__tag__bg":{"type":"string","description":"Background color of the Tag in HEX format (e.g., '#FF5733') in the request body. Though schema-optional, generally required by the API for successful deletion.\nExamples:\n  \"#FF0000\"\n  \"#3498DB\""},"tag__tag__fg":{"type":"string","description":"Foreground (text) color of the Tag in HEX format (e.g., '#FFFFFF') in the request body. Though schema-optional, generally required by the API for successful deletion.\nExamples:\n  \"#FFFFFF\"\n  \"#000000\""},"tag_name":{"type":"string","description":"Name of the Tag to be deleted, used in the URL path to identify it.\nExamples:\n  \"Urgent\"\n  \"ProjectAlpha\""}},"required":["space_id","tag_name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete space tag","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_TASK","description":"Permanently deletes a task, using its standard ID or a custom task ID (requires `custom_task_ids=true` and `team_id`).","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Set to `true` if `task_id` is a custom ID (requires `team_id` if `true`).\nExamples:\n  \"true\"\n  \"false\""},"task_id":{"type":"string","description":"Unique ID of the task to delete. Can be a standard ID or a custom task ID (if custom, `custom_task_ids` must be `true`).\nExample: \"1a2b3c4d\""},"team_id":{"type":"integer","description":"Team ID. Required only if `custom_task_ids` is `true` to identify the team for the custom task ID.\nExample: \"98765\""}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_TASK_LINK","description":"Deletes an existing link, effectively a dependency or relationship, between two ClickUp tasks; set `custom_task_ids=true` and provide `team_id` if using custom task IDs.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"If `task_id` and `links_to` refer to custom task IDs (rather than standard ClickUp task IDs), this parameter must be set to `true`. Setting this to `true` also requires `team_id` to be provided. Defaults to `false` if not specified.\nExample: \"true\""},"links_to":{"type":"string","description":"The ID of the second task involved in the link. If `custom_task_ids` is `true`, this should be its custom task ID.\nExamples:\n  \"task_id_2\"\n  \"custom_task_xyz\""},"task_id":{"type":"string","description":"The ID of the first task involved in the link. If `custom_task_ids` is `true`, this should be its custom task ID.\nExamples:\n  \"task_id_1\"\n  \"custom_task_abc\""},"team_id":{"type":"integer","description":"The numerical ID of the team. This parameter is required and used only when `custom_task_ids` is set to `true` to correctly scope the custom task IDs. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"456\""}},"required":["links_to","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete task link","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_DELETE_TEAM","description":"Permanently deletes an existing Team (user group) from the Workspace using its `group_id`.","inputSchema":{"type":"object","properties":{"group_id":{"type":"string","description":"The unique string identifier for the Team (user group) to be deleted.\nExample: \"7C73-4002-A6A9-310014852858\""}},"required":["group_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete team","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_TIME_TRACKED","description":"Deletes a time-tracked interval from a task; use this legacy endpoint for older time tracking systems.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Set to `true` if `task_id` refers to a custom task ID. If `true`, `team_id` must also be provided. If omitted or `false`, `task_id` is treated as a standard ID.\nExamples:\n  \"true\"\n  \"false\""},"interval_id":{"type":"string","description":"ID of the time tracking interval (entry) to be deleted.\nExamples:\n  \"interval_def_789\"\n  \"time_entry_001\""},"task_id":{"type":"string","description":"Task ID; can be standard or custom if `custom_task_ids` is set to true.\nExamples:\n  \"task_abc_123\"\n  \"custom_id_456\""},"team_id":{"type":"integer","description":"The ID of the team. This is required only if `custom_task_ids` is set to `true` to correctly identify the task using its custom ID. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"12345\"\n  \"67890\""}},"required":["interval_id","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete time tracked","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_VIEW","description":"Permanently and irreversibly deletes an existing View in ClickUp, identified by its `view_id`.","inputSchema":{"type":"object","properties":{"view_id":{"type":"string","description":"The unique identifier of the View to be deleted.\nExamples:\n  \"105\"\n  \"custom_view_id_abc_123\""}},"required":["view_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete view","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_DELETE_WEBHOOK","description":"Permanently removes an existing webhook, specified by its ID, thereby ceasing all its event monitoring and notifications.","inputSchema":{"type":"object","properties":{"webhook_id":{"type":"string","description":"The unique identifier (UUID) of the webhook to be deleted.\nExample: \"e506-4a29-9d42-26e504e3435e\""}},"required":["webhook_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete webhook","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_EDIT_CHECKLIST","description":"Updates an existing checklist's name or position, identified by its `checklist_id`.","inputSchema":{"type":"object","properties":{"checklist_id":{"type":"string","description":"The unique identifier (UUID) of the checklist to be edited.\nExample: \"b8a8-48d8-a0c6-b4200788a683\""},"name":{"type":["string","null"],"description":"New name for the checklist.","default":null},"position":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"New 0-indexed display order for the checklist on a task (e.g., 0 for top).","default":null}},"required":["checklist_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Edit checklist","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_EDIT_CHECKLIST_ITEM","description":"Updates an existing checklist item, allowing modification of its name, assignee, resolution status, or parent item for nesting.","inputSchema":{"type":"object","properties":{"assignee":{"type":["string","null"],"description":"The integer user ID to assign to this checklist item. To unassign, consult ClickUp API documentation for the appropriate value (e.g., 0 or null).\nExamples:\n  \"183\"\n  \"29045\"","default":null},"checklist_id":{"type":"string","description":"The unique identifier (UUID) of the checklist containing the item to be edited.\nExample: \"b8a8-48d8-a0c6-b4200788a683\""},"checklist_item_id":{"type":"string","description":"The unique identifier (UUID) of the checklist item to be edited.\nExample: \"e491-47f5-9fd8-d1dc4cedcc6f\""},"name":{"type":["string","null"],"description":"The new name for the checklist item.\nExamples:\n  \"Review updated documentation\"\n  \"Prepare agenda for weekly sync\"","default":null},"parent":{"type":["string","null"],"description":"The `checklist_item_id` of an existing item within the same checklist to nest this item under.\nExample: \"c2d3e4f5-a6b7-8901-2345-67890abcdef1\"","default":null},"resolved":{"type":["boolean","null"],"description":"Set to `true` to mark the item as resolved, or `false` to mark it as unresolved.\nExamples:\n  \"true\"\n  \"false\"","default":null}},"required":["checklist_id","checklist_item_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Edit checklist item","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_EDIT_GUEST_ON_WORKSPACE","description":"Modifies the details and permissions of an existing guest user within a specific Workspace.","inputSchema":{"type":"object","properties":{"can_create_views":{"type":"boolean","description":"Boolean flag to allow or disallow the guest to create views.\nExample: true"},"can_edit_tags":{"type":"boolean","description":"Boolean flag to allow or disallow the guest to edit tags.\nExample: true"},"can_see_time_estimated":{"type":"boolean","description":"Boolean flag to allow or disallow the guest to see time estimated for tasks.\nExample: false"},"can_see_time_spent":{"type":"boolean","description":"Boolean flag to allow or disallow the guest to see time spent on tasks.\nExample: false"},"custom_role_id":{"type":"integer","description":"Identifier of a custom role for the guest. Ensure this ID is valid within the workspace. (Note: Business Plus Plan supports one custom role; Enterprise Plan supports unlimited).\nExample: \"10\""},"guest_id":{"type":"integer","description":"The unique identifier of the guest user to be edited. Example: 98765.\nExample: \"789\""},"team_id":{"type":"integer","description":"The unique identifier of the Workspace (Team) where the guest belongs. Example: 123456.\nExample: \"123\""},"username":{"type":"string","description":"The new username to assign to the guest.\nExample: \"new_guest_username\""}},"required":["can_create_views","can_edit_tags","can_see_time_estimated","can_see_time_spent","custom_role_id","guest_id","team_id","username"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Edit guest on workspace","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_EDIT_KEY_RESULT","description":"Updates an existing key result's progress or note in ClickUp, where the key result measures progress towards a goal.","inputSchema":{"type":"object","properties":{"key_result_id":{"type":"string","description":"The unique identifier (UUID) of the key result to be edited.\nExample: \"8480-49bc-8c57-e569747efe93\""},"note":{"type":"string","description":"A note or comment to add or update for the key result.\nExamples:\n  \"Updated progress after completing the initial phase.\"\n  \"Waiting for stakeholder feedback.\""},"steps_current":{"type":"integer","description":"The current progress of steps for the key result.\nExamples:\n  5\n  10"}},"required":["key_result_id","note","steps_current"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Edit key result","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_EDIT_SPACE_TAG","description":"Updates an existing tag's name and colors in a ClickUp Space; requires current tag name for identification, and new values for tag name, foreground color, and background color, all of which are mandatory for the update.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"Unique identifier of the Space containing the tag.\nExamples:\n  \"12345678\"\n  \"98765432\""},"tag__bg__color":{"type":"string","description":"New background color for the tag, specified as a hexadecimal string (e.g., '#000000').\nExamples:\n  \"#000000\"\n  \"#FFFFE0\""},"tag__fg__color":{"type":"string","description":"New foreground color for the tag, specified as a hexadecimal string (e.g., '#FFFFFF').\nExamples:\n  \"#FF0000\"\n  \"#00AAFF\""},"tag__name":{"type":"string","description":"New name to assign to the tag.\nExamples:\n  \"High Priority\"\n  \"Approved\""},"tag_name":{"type":"string","description":"Current name of the tag to edit. This tag must exist within the specified Space.\nExamples:\n  \"Urgent\"\n  \"Review Needed\""}},"required":["space_id","tag_name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Edit space tag","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_EDIT_TIME_TRACKED","description":"Edits a legacy time-tracked interval for a task (identified by `task_id` and `interval_id`) to update its start/end times and duration; `team_id` is required if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"If true, `task_id` is treated as a custom task ID, and `team_id` must be provided."},"end":{"type":"integer","description":"New end date and time for the interval as a Unix timestamp in milliseconds.\nExamples:\n  \"1678890000000\"\n  \"1700003600000\""},"interval_id":{"type":"string","description":"Unique identifier of the time interval record to edit.\nExample: \"interval_xyz_789\""},"start":{"type":"integer","description":"New start date and time for the interval as a Unix timestamp in milliseconds.\nExamples:\n  \"1678886400000\"\n  \"1700000000000\""},"task_id":{"type":"string","description":"Unique task identifier; refers to custom task ID if `custom_task_ids` is true.\nExamples:\n  \"task_abc_123\"\n  \"custom-id-456\""},"team_id":{"type":"integer","description":"Team ID, required if `custom_task_ids` is true.\nExamples:\n  \"123\"\n  \"456\""},"time":{"type":"integer","description":"New total duration of the time interval in milliseconds; typically the difference between `end` and `start`.\nExamples:\n  \"3600000\"\n  \"7200000\""}},"required":["end","interval_id","start","task_id","time"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Edit time tracked","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_EDIT_USER_ON_WORKSPACE","description":"Updates a user's username, admin status, or custom role in a Workspace; requires the Workspace to be on an Enterprise Plan.","inputSchema":{"type":"object","properties":{"admin":{"type":"boolean","description":"Set `true` to make user an admin, `false` to revoke admin privileges.\nExamples:\n  true\n  false"},"custom_role_id":{"type":"integer","description":"ID of the custom role to assign, defining their permissions.\nExamples:\n  \"123\"\n  \"456\""},"team_id":{"type":"integer","description":"Workspace (formerly Team) ID where the user resides.\nExamples:\n  \"18200000\"\n  \"90150000\""},"user_id":{"type":"integer","description":"ID of the user whose details are to be edited.\nExamples:\n  \"55000000\"\n  \"77000000\""},"username":{"type":"string","description":"New username to assign.\nExamples:\n  \"john.doe.updated\"\n  \"jane_smith_new\""}},"required":["admin","custom_role_id","team_id","user_id","username"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Edit user on workspace","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_ACCESSIBLE_CUSTOM_FIELDS","description":"Retrieves all accessible Custom Field definitions for a specified ClickUp List using its `list_id`.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"Numeric ID of the specific ClickUp List.\nExamples:\n  \"18123456\"\n  \"19000000\""}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get accessible custom fields","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_ACCESS_TOKEN","description":"Exchanges a ClickUp OAuth 2.0 authorization code (obtained after user consent) for an access token.","inputSchema":{"type":"object","properties":{"client_id":{"type":"string","description":"Client ID for your registered ClickUp OAuth application.\nExample: \"YOUR_CLICKUP_OAUTH_APP_CLIENT_ID\""},"client_secret":{"type":"string","description":"Client Secret for your registered ClickUp OAuth application.\nExample: \"YOUR_CLICKUP_OAUTH_APP_CLIENT_SECRET\""},"code":{"type":"string","description":"Authorization code from ClickUp's authorization server, typically a query parameter to your redirect URI after user consent.\nExample: \"CODE_FROM_REDIRECT_URI\""}},"required":["client_id","client_secret","code"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get access token","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_ALL_TAGS_FROM_TIME_ENTRIES","description":"Retrieves all unique tags applied to time entries within a specified ClickUp Team (Workspace).","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"The unique numerical identifier of the ClickUp Team (Workspace) for which to retrieve time entry tags.\nExample: \"1234567\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get all tags from time entries","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_AUTHORIZED_USER","description":"Retrieves the details of the currently authenticated ClickUp user.","inputSchema":{"type":"object","properties":{},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get authorized user","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_BULK_TASKS_TIME_IN_STATUS","description":"Retrieves the time spent in each status for multiple tasks; requires the 'Total time in Status' ClickApp to be enabled in the Workspace.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Set to `true` if `task_ids` refer to custom task IDs instead of standard task IDs. If `true`, `team_id` must also be provided."},"task_ids":{"type":"string","description":"A comma-separated string of task IDs (e.g., 'taskID1,taskID2') for which to retrieve time in status data. You can include up to 100 task IDs per request.\nExamples:\n  \"3cuh,g4fs\"\n  \"task123,task456,task789\""},"team_id":{"type":"integer","description":"The ID of the team to which the custom task IDs belong. This field is required and used only when the `custom_task_ids` parameter is set to `true`.\nExamples:\n  123\n  4567"}},"required":["task_ids"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get bulk tasks time in status","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_CHAT_VIEW_COMMENTS","description":"Retrieves comments from a specified Chat view in ClickUp, supporting pagination via `start` and `start_id` to fetch comments older than the default 25 most recent.","inputSchema":{"type":"object","properties":{"start":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Unix timestamp (milliseconds) to filter comments created at or after this time. For pagination, typically used with `start_id`.\nExample: \"1578339848000\"","default":null},"start_id":{"type":["string","null"],"description":"Comment ID to act as a cursor for pagination, used with `start` to retrieve comments after this ID that also meet the `start` time condition.\nExample: \"b79a7feb-9691-45f0-877a-d906349e0865\"","default":null},"view_id":{"type":"string","description":"Unique identifier of the Chat view from which to retrieve comments.\nExamples:\n  \"105\"\n  \"custom_chat_view_id_123\""}},"required":["view_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get chat view comments","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_CUSTOM_ROLES","description":"Retrieves all Custom Roles, which allow granular permission configurations, for a specified Workspace (Team).","inputSchema":{"type":"object","properties":{"include_members":{"type":["boolean","null"],"description":"If true, includes members assigned to each custom role in the response.\nExamples:\n  true\n  false","default":null},"team_id":{"type":"integer","description":"The unique identifier of the Workspace (Team) for which to retrieve custom roles.\nExample: \"1234567\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get custom roles","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_CUSTOM_TASK_TYPES","description":"Retrieves all custom task types available within a specified Workspace (team_id).","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"Numeric ID of the Workspace (formerly Team) for which to retrieve custom task types.\nExample: \"12345678\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get custom task types","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_FILTERED_TEAM_TASKS","description":"Retrieves a paginated list of tasks (up to 100 per page) from a specified workspace based on various filter criteria, respecting user access permissions.","inputSchema":{"type":"object","properties":{"assignees":{"type":"array","items":{"type":"string"},"description":"Filter by assignee User IDs."},"custom_fields":{"type":"array","items":{"type":"string"},"description":"Filter by custom fields. Each string in the list is a JSON object defining a single filter condition. Example for one string in the list: '''{\"field_id\": \"unique_field_id\", \"operator\": \"=\", \"value\": \"desired_value\"}'''."},"custom_items":{"type":"array","items":{"type":"integer"},"description":"Filter by custom item types (e.g., 0 for tasks, 1 for Milestones, other numbers for custom types defined in Workspace)."},"custom_task_ids":{"type":"boolean","description":"Set to true to use custom task IDs in filters instead of global task IDs. Requires `team_id` for context."},"date_created_gt":{"type":"integer","description":"Filter by creation date greater than this Unix timestamp (milliseconds)."},"date_created_lt":{"type":"integer","description":"Filter by creation date less than this Unix timestamp (milliseconds)."},"date_done_gt":{"type":"integer","description":"Filter by completion date greater than this Unix timestamp (milliseconds)."},"date_done_lt":{"type":"integer","description":"Filter by completion date less than this Unix timestamp (milliseconds)."},"date_updated_gt":{"type":"integer","description":"Filter by update date greater than this Unix timestamp (milliseconds)."},"date_updated_lt":{"type":"integer","description":"Filter by update date less than this Unix timestamp (milliseconds)."},"due_date_gt":{"type":"integer","description":"Filter by due date greater than this Unix timestamp (milliseconds)."},"due_date_lt":{"type":"integer","description":"Filter by due date less than this Unix timestamp (milliseconds)."},"include_closed":{"type":"boolean","description":"If true, include closed tasks. Excluded by default."},"include_markdown_description":{"type":"boolean","description":"If true, return task descriptions in Markdown format."},"list_ids":{"type":"array","items":{"type":"string"},"description":"Filter by List IDs."},"order_by":{"type":"string","description":"Order tasks by this field. Default: `created`. Options: `id`, `created`, `updated`, `due_date`."},"page":{"type":"integer","description":"Page to fetch (starts at 0)."},"parent":{"type":"string","description":"Filter by parent task ID to retrieve its subtasks."},"project_ids":{"type":"array","items":{"type":"string"},"description":"Filter by Folder (Project) IDs."},"reverse":{"type":"boolean","description":"If true, tasks are displayed in reverse order."},"space_ids":{"type":"array","items":{"type":"string"},"description":"Filter by Space IDs."},"statuses":{"type":"array","items":{"type":"string"},"description":"Filter by task statuses (e.g., 'to do', 'in progress')."},"subtasks":{"type":"boolean","description":"If true, include subtasks. Excluded by default."},"tags":{"type":"array","items":{"type":"string"},"description":"Filter by tag names."},"team_Id":{"type":"string","description":"The Workspace ID (also called Team ID in ClickUp API). This goes in the URL path. Accepts numeric or string values."},"team_id":{"type":"integer","description":"Team ID, required if `custom_task_ids` is true, for custom task ID context."}},"required":["team_Id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get filtered team tasks","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_FOLDER","description":"Retrieves detailed information about a specific folder in ClickUp.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"The unique identifier of the folder.\nExample: \"123456789\""}},"required":["folder_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get folder","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_FOLDERLESS_LISTS","description":"Retrieves all Lists within a specified Space that are not located in any Folder.","inputSchema":{"type":"object","properties":{"archived":{"type":["boolean","null"],"description":"Filter by archived status. Set to `true` to retrieve archived Lists, `false` or omit to retrieve unarchived Lists.","default":null},"space_id":{"type":"integer","description":"The ID of the Space from which to retrieve folderless Lists.\nExample: 1234567"}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get folderless lists","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_FOLDERS","description":"Retrieves Folders within a specified ClickUp Space, ensuring `space_id` is valid, with an option to filter by archived status.","inputSchema":{"type":"object","properties":{"archived":{"type":["boolean","null"],"description":"Filter Folders by archived status. `True` for archived, `False` for unarchived. Omit to return both.\nExamples:\n  \"true\"\n  \"false\"","default":null},"space_id":{"type":"integer","description":"The unique numeric identifier of the Space from which to retrieve Folders.\nExamples:\n  \"1234567\"\n  \"9876543\""}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get folders","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_FOLDER_VIEWS","description":"Retrieves all configured views (like List, Board, Calendar) for a specified, existing Folder in ClickUp.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"ID of the Folder.\nExample: \"9003005107\""}},"required":["folder_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get folder views","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_GOAL","description":"Retrieves detailed information for an existing ClickUp Goal, specified by its unique `goal_id`.","inputSchema":{"type":"object","properties":{"goal_id":{"type":"string","description":"The unique identifier (UUID) of the Goal to retrieve.\nExamples:\n  \"900e-462d-a849-4a216b06d930\"\n  \"123a-bcde-567f-ghij-890k123l456m\""}},"required":["goal_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get goal","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_GOALS","description":"Retrieves goals for a specified ClickUp Workspace (Team); the `team_id` must be valid and accessible.","inputSchema":{"type":"object","properties":{"include_completed":{"type":["boolean","null"],"description":"If true, include completed goals in the response.\nExamples:\n  true\n  false","default":null},"team_id":{"type":"integer","description":"The unique numerical identifier of the Workspace (Team) for which to retrieve goals.\nExamples:\n  123456\n  987654"}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get goals","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_GUEST","description":"Call this to retrieve detailed information for a specific guest within a Team (Workspace), ensuring the `guest_id` is valid for the given `team_id`; this action requires the ClickUp Enterprise Plan.","inputSchema":{"type":"object","properties":{"guest_id":{"type":"integer","description":"The unique identifier for the guest whose information is to be retrieved.\nExample: 987654"},"team_id":{"type":"integer","description":"The unique identifier for the Team (Workspace) to which the guest belongs.\nExample: 123456"}},"required":["guest_id","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get guest","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_LIST","description":"Retrieves detailed information for an existing List in ClickUp, identified by its unique `list_id`.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"The unique identifier for the List to retrieve. This ID can be found by right-clicking a List in the ClickUp sidebar, selecting 'Copy link', and the ID is the last part of the URL after '/l/' or '/li/'.\nExample: \"12345678\""}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get list","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_LIST_COMMENTS","description":"Retrieves comments for a specific ClickUp List, supporting pagination using `start` (timestamp) and `start_id` (comment ID) to fetch earlier comments; omits them for the latest 25.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"The unique identifier for the list from which to retrieve comments.\nExample: \"1810\""},"start":{"type":"integer","description":"Unix timestamp (milliseconds) of a comment's creation date.\nExample: \"1609459200000\""},"start_id":{"type":"string","description":"ID of a specific comment.\nExample: \"abc123xyz789\""}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get list comments","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_LIST_MEMBERS","description":"Retrieves all members of a specific, existing ClickUp List by its ID.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"Unique identifier of the ClickUp List. Found by extracting the numerical ID from the List's URL in ClickUp.\nExample: \"123456789\""}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get list members","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_LISTS","description":"Retrieves all lists within a specified, existing ClickUp folder, optionally filtering by archived status.","inputSchema":{"type":"object","properties":{"archived":{"type":["boolean","null"],"description":"Filter lists by archived status. If `true`, returns archived lists; if `false` or omitted, returns unarchived lists.\nExamples:\n  \"true\"\n  \"false\"","default":null},"folder_id":{"type":"integer","description":"The unique identifier of the Folder from which to retrieve lists.\nExample: \"1800000000\""}},"required":["folder_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get lists","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_LIST_VIEWS","description":"Retrieves all task and page views for a specified and accessible ClickUp List.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"The ID of the List for which to retrieve views. This is the numeric ID of the list, often found at the end of the list's URL.\nExamples:\n  123\n  456"}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get list views","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_RUNNING_TIME_ENTRY","description":"Retrieves the currently active time entry for a user in a Workspace; a negative 'duration' in its data indicates it's running, and the response may be empty if no entry is active.","inputSchema":{"type":"object","properties":{"assignee":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Identifier of the user for the time entry; defaults to the authenticated user if not provided.\nExample: \"556789\"","default":null},"team_id":{"type":"integer","description":"Unique identifier for the Workspace (Team).\nExample: \"18357\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get running time entry","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_SINGULAR_TIME_ENTRY","description":"Fetches a specific time entry by its ID for a given team; a negative duration in the response indicates an active timer.","inputSchema":{"type":"object","properties":{"include__task":{"type":"boolean","description":"If true and the time entry is associated with a task, includes task details in the response."},"include_location_names":{"type":"boolean","description":"If true, includes names of the List, Folder, and Space associated with the time entry, alongside their IDs."},"team_id":{"type":"integer","description":"Unique identifier for the Team (Workspace).\nExample: 12345678"},"timer_id":{"type":"string","description":"Unique identifier of the time entry. Can be obtained from the 'Get Time Entries Within a Date Range' action.\nExample: \"24456f92-1d77-41cc-a1b3-90260889ff94\""}},"required":["team_id","timer_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get singular time entry","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_SPACE","description":"Retrieves detailed information for an existing Space in a ClickUp Workspace, identified by its unique space_id.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"Unique ID of the Space to retrieve.\nExamples:\n  \"1234567\"\n  \"9876543\""}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get space","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_SPACES","description":"Retrieves Spaces for a Team ID; member information for private Spaces is returned only if the authenticated user is a member.","inputSchema":{"type":"object","properties":{"archived":{"type":["boolean","null"],"description":"Filter by archived status (`true` for archived, `false` for active); API default if omitted.\nExamples:\n  \"true\"\n  \"false\"","default":null},"team_id":{"type":"integer","description":"Identifier for the Team (Workspace).\nExample: 1234567"}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get spaces","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_SPACE_TAGS","description":"Retrieves all tags for tasks within a specified ClickUp Space, requiring a valid `space_id`.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"The unique numerical identifier of the Space for which tags are to be retrieved.\nExamples:\n  12345678\n  87654321"}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get space tags","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_SPACE_VIEWS","description":"Retrieves all task and page views for a specified Space ID in ClickUp.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"ID of the Space to retrieve views from.\nExample: 123456"}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get space views","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASK","description":"Retrieves comprehensive details for a ClickUp task by its ID, supporting standard or custom task IDs (requires `team_id` for custom IDs).","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"Set to `true` to indicate that the `task_id` provided is a custom task ID. If `true`, `team_id` must also be provided. If omitted or `false` (default), `task_id` is treated as a standard task ID.\nExamples:\n  \"true\"\n  \"false\"","default":null},"include_markdown_description":{"type":["boolean","null"],"description":"Set to `true` to return the task description in Markdown format. If omitted or `false` (default), the description is returned in plain text. For example: `?include_markdown_description=true`.\nExamples:\n  \"true\"\n  \"false\"","default":null},"include_subtasks":{"type":["boolean","null"],"description":"Set to `true` to include subtasks in the task details response. If omitted or `false` (default), subtasks are not included.\nExamples:\n  \"true\"\n  \"false\"","default":null},"task_id":{"type":"string","description":"The unique identifier of the task to retrieve. This can be the standard ClickUp task ID or a custom task ID if `custom_task_ids` is set to `true` (in which case `team_id` is also required).\nExamples:\n  \"9hz\"\n  \"custom_id_example\"\n  \"abc123_def456\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The ID of the team. This parameter is required and used only when `custom_task_ids` is set to `true` to identify the custom task ID within that specific team. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"456789\"","default":null}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get task","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASK_COMMENTS","description":"Retrieves up to 25 comments for a specified task, supporting pagination using `start` and `start_id` to fetch older comments.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Indicates if `task_id` is a custom task ID; if true, `team_id` is required.\nExamples:\n  \"true\"\n  \"false\""},"start":{"type":"integer","description":"Unix timestamp (in milliseconds) of the oldest visible comment, used with `start_id` for paginating older comments.\nExample: \"1678886400000\""},"start_id":{"type":"string","description":"ID of the oldest visible comment, used with `start` for paginating older comments.\nExample: \"abc-123-xyz-789\""},"task_id":{"type":"string","description":"Unique identifier of the task. Can be a standard or custom task ID (if `custom_task_ids` is true).\nExamples:\n  \"task123\"\n  \"custom_abc\""},"team_id":{"type":"integer","description":"Team ID, required if `custom_task_ids` is true.\nExample: \"123456\""}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get task comments","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASK_MEMBERS","description":"Retrieves users with explicit access (directly assigned or shared) to a specific existing task, excluding users with inherited permissions.","inputSchema":{"type":"object","properties":{"task_id":{"type":"string","description":"The unique identifier of the task for which to retrieve members.\nExample: \"900900202020\""}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get task members","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASKS","description":"Retrieves tasks from a specified ClickUp list; only tasks whose home is the given list_id are returned.","inputSchema":{"type":"object","properties":{"archived":{"type":"boolean","description":"Include or exclude archived tasks."},"assignees":{"type":"array","items":{"type":"string"},"description":"Filter tasks by assignee user IDs. Accepts a single ID or a list of IDs. IDs can be numeric (e.g., 212519251) or strings (e.g., '212519251').\nExamples:\n  [\"212519251\",\"987654321\"]\n  212519251"},"custom_fields":{"type":"array","items":{"type":"string"},"description":"Filter tasks by custom field values. Provide a list of JSON strings, each defining a custom field filter. Example for a single filter: '[{\"field_id\":\"field_id_1\",\"operator\":\"=\",\"value\":\"field_value_1\"}]'. For multiple filters: '[{\"field_id\":\"field_id_1\",\"operator\":\"=\",\"value\":\"field_value_1\"}, {\"field_id\":\"field_id_2\",\"operator\":\"<\",\"value\":5}]'. See ClickUp API documentation for more on filtering with Custom Fields.\nExample: [\"{\\\"field_id\\\":\\\"abcdefghi12345678\\\",\\\"operator\\\":\\\"=\\\",\\\"value\\\":\\\"1234\\\"}\",\"{\\\"field_id\\\":\\\"jklmnop123456\\\",\\\"operator\\\":\\\"<\\\",\\\"value\\\":\\\"5\\\"}\"]"},"custom_items":{"type":"array","items":{"type":"integer"},"description":"Filter by custom task types. For example: `?custom_items[]=0&custom_items[]=1300`. Including `0` returns tasks. Including `1` returns Milestones. Including any other number returns the custom task type as defined in your Workspace."},"date_created_gt":{"type":"integer","description":"Filter tasks with a creation date greater than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_created_lt":{"type":"integer","description":"Filter tasks with a creation date less than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_done_gt":{"type":"integer","description":"Filter tasks with a completion date greater than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_done_lt":{"type":"integer","description":"Filter tasks with a completion date less than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_updated_gt":{"type":"integer","description":"Filter tasks with an update date greater than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_updated_lt":{"type":"integer","description":"Filter tasks with an update date less than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"due_date_gt":{"type":"integer","description":"Filter tasks with a due date greater than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"due_date_lt":{"type":"integer","description":"Filter tasks with a due date less than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"include_closed":{"type":"boolean","description":"Include tasks with a closed status.\nExamples:\n  true\n  false"},"include_markdown_description":{"type":"boolean","description":"Return task descriptions in Markdown format.\nExample: true"},"list_id":{"type":"integer","description":"The ID of the list to retrieve tasks from. To find the list_id, copy the link to the list from the ClickUp UI; the list_id is the number following '/li' in the URL.\nExample: 123456789"},"order_by":{"type":"string","description":"Field to order tasks by. Valid options are: 'id', 'created', 'updated', and 'due_date'.\nExamples:\n  \"id\"\n  \"created\"\n  \"updated\"\n  \"due_date\""},"page":{"type":"integer","description":"The page number of results to fetch, starting at 0. Each page can contain up to 100 tasks.\nExamples:\n  0\n  1\n  2"},"reverse":{"type":"boolean","description":"Display tasks in reverse order based on the 'order_by' field.\nExamples:\n  true\n  false"},"statuses":{"type":"array","items":{"type":"string"},"description":"Filter tasks by their status. Pass a list of status strings. Use URL encoding for statuses with spaces (e.g., 'to%20do'). To include closed tasks, use the `include_closed` parameter.\nExample: [\"to do\",\"in progress\"]"},"subtasks":{"type":"boolean","description":"Include subtasks in the results.\nExamples:\n  true\n  false"},"tags":{"type":"array","items":{"type":"string"},"description":"Filter tasks by a list of tag names. Use URL encoding for tags with spaces (e.g., 'this%20tag').\nExample: [\"tag1\",\"this tag\"]"}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get tasks","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASK_S_TIME_IN_STATUS","description":"Retrieves the duration a task has spent in each status, provided the 'Total time in Status' ClickApp is enabled for the Workspace.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"If set to `true`, the `task_id` parameter will be interpreted as a custom task ID. When using custom task IDs, the `team_id` must also be provided.\nExamples:\n  true\n  false"},"task_id":{"type":"string","description":"The unique identifier of the task. This can be the standard task ID or a custom task ID if `custom_task_ids` is true.\nExamples:\n  \"abc123xyz\"\n  \"custom-id-001\""},"team_id":{"type":"integer","description":"The ID of the team (Workspace) to which the task belongs. This is required only when `custom_task_ids` is set to `true`. For example: `custom_task_ids=true&team_id=1234567`.\nExamples:\n  1234567\n  7654321"}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get task s time in status","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASK_TEMPLATES","description":"Retrieves task templates for a specified Workspace (Team ID), supporting pagination.","inputSchema":{"type":"object","properties":{"page":{"type":"integer","description":"Page number for paginating through templates (starts from 0).\nExamples:\n  \"0\"\n  \"1\""},"team_id":{"type":"integer","description":"Unique identifier of the Workspace (Team) to retrieve task templates from.\nExample: \"123456\""}},"required":["page","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get task templates","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TEAMS","description":"Retrieves user groups (Teams) from a ClickUp Workspace, typically requiring `team_id` (Workspace ID), with an option to filter by `group_ids`.","inputSchema":{"type":"object","properties":{"group_ids":{"type":["string","null"],"description":"Comma-separated string of user group IDs to filter results; if omitted, all user groups in the Workspace are returned.\nExample: \"03g1f034-71e4-4f10-8ced-987514848f02,a9b8c7d6-e5f4-g3h2-i1j0-k9l8m7n6o5p4\"","default":null},"team_id":{"type":"integer","description":"ID of the ClickUp Workspace (Team ID) from which to retrieve user groups. Must be a valid positive integer representing an existing workspace. Use the CLICKUP_AUTHORIZATION_GET_WORK_SPACE_LIST action to retrieve available workspace IDs.\nExample: \"90161390966\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get teams","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TIME_ENTRIES_WITHIN_A_DATE_RANGE","description":"Retrieves time entries for a specified Team (Workspace ID) within a date range (defaults to the last 30 days for the authenticated user if dates are omitted); active timers are indicated by negative durations in the response.","inputSchema":{"type":"object","properties":{"assignee":{"type":"string","description":"Filter time entries by user ID(s). For multiple assignees, provide a comma-separated string of user IDs. Example: `1234,9876`. Note: Access to other users' time entries typically requires Workspace Owner/Admin privileges.\nExamples:\n  \"1234\"\n  \"1234,9876\""},"custom_task_ids":{"type":"boolean","description":"Set to `true` if the `task_id` parameter refers to a custom task ID. If `true`, the `team_id` query parameter must also be provided for context."},"end_date":{"type":"integer","description":"The end date of the date range for filtering time entries, specified as a Unix timestamp in milliseconds. If omitted, defaults to the current date.\nExample: \"1609545600000\""},"folder_id":{"type":"integer","description":"Filter time entries to include only those associated with tasks in a specific Folder ID.\nExample: \"456\""},"include_location_names":{"type":"boolean","description":"If true, includes the names of the List, Folder, and Space in the response, along with their respective IDs (`list_id`, `folder_id`, `space_id`)."},"include_task_tags":{"type":"boolean","description":"If true, includes task tags in the response for time entries associated with tasks."},"list_id":{"type":"integer","description":"Filter time entries to include only those associated with tasks in a specific List ID.\nExample: \"123\""},"space_id":{"type":"integer","description":"Filter time entries to include only those associated with tasks in a specific Space ID.\nExample: \"789\""},"start_date":{"type":"integer","description":"The start date of the date range for filtering time entries, specified as a Unix timestamp in milliseconds. If omitted, defaults to 30 days prior to the current date.\nExample: \"1609459200000\""},"task_id":{"type":"string","description":"Filter time entries to include only those associated with a specific task ID. Use with `custom_task_ids` if referring to a custom ID.\nExample: \"abc123xyz\""},"team_Id":{"type":"integer","description":"The Workspace ID (also called Team ID in ClickUp API) for which to retrieve time entries. This goes in the URL path."},"team_id":{"type":"integer","description":"The ID of the Team (Workspace) to use for context when `custom_task_ids` is `true`. This helps resolve custom task IDs. Example: `custom_task_ids=true&team_id=123`.\nExample: \"123\""}},"required":["team_Id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get time entries within a date range","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TIME_ENTRY_HISTORY","description":"Retrieves the modification history for an existing time entry within a specific ClickUp Team (Workspace).","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"Unique identifier for the Team (Workspace) containing the time entry.\nExample: \"1234567\""},"timer_id":{"type":"string","description":"Unique identifier of the time entry for which to retrieve history.\nExamples:\n  \"777_abc123xyz\"\n  \"123_tm987zyx\""}},"required":["team_id","timer_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get time entry history","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TRACKED_TIME","description":"Retrieves tracked time for a task using a legacy endpoint; prefer newer Time Tracking API endpoints for managing time entries.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Set to `true` if the `task_id` provided is a custom task ID. If `true`, the `team_id` must also be provided.\nExample: true"},"task_id":{"type":"string","description":"The ID of the task for which to retrieve tracked time. This can be the standard task ID or a custom task ID if `custom_task_ids` is set to `true`.\nExample: \"abc123efg\""},"team_id":{"type":"integer","description":"The ID of the team. This is required and used only when the `custom_task_ids` parameter is set to `true`. For example: `custom_task_ids=true&team_id=123`.\nExample: 1234567"}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get tracked time","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_USER","description":"Retrieves detailed information for a specific user within a ClickUp Workspace (Team), available only for Workspaces on the ClickUp Enterprise Plan.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"ID of the Team (Workspace) containing the user.\nExample: \"18251903\""},"user_id":{"type":"integer","description":"ID of the user whose details are to be retrieved.\nExample: \"5539995\""}},"required":["team_id","user_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get user","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_VIEW","description":"Fetches details for a specific ClickUp view, identified by its `view_id`, which must exist.","inputSchema":{"type":"object","properties":{"view_id":{"type":"string","description":"The unique identifier for the ClickUp view to retrieve.\nExamples:\n  \"view_abc123\"\n  \"view_xyz789\""}},"required":["view_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get view","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_VIEW_TASKS","description":"Retrieves all tasks visible in a specified ClickUp view, respecting its applied filters, sorting, and grouping.","inputSchema":{"type":"object","properties":{"page":{"type":"integer","description":"The page number of the results to retrieve. Used for pagination if the number of tasks exceeds the limit per page. Starts at 0.\nExamples:\n  0\n  1\n  2"},"view_id":{"type":"string","description":"The unique identifier for a task view from which to retrieve tasks. Only task views are supported: list, board, calendar, table, timeline, workload, activity, map, or gantt. Page views (such as Docs, Whiteboards, and Chat) are not supported and will return an error. To find valid task views, use the Get Space Views, Get Folder Views, or Get List Views actions and filter by view type.\nExamples:\n  \"105\"\n  \"abc-123\"\n  \"team_view_id\""}},"required":["page","view_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get view tasks","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_WEBHOOKS","description":"Fetches webhooks for a Team (Workspace), returning only those created by the authenticated user via API, for a `team_id` they can access.","inputSchema":{"type":"object","properties":{"team_id":{"type":"string","description":"Unique ID of the Team (Workspace) to retrieve webhooks for. Obtain valid workspace IDs using the 'get_authorized_teams_workspaces' action."}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get webhooks","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_WORKSPACE_EVERYTHING_LEVEL_VIEWS","description":"Retrieves all task and page views at the 'Everything Level' (a comprehensive overview of all tasks across all Spaces) for a specified ClickUp Workspace.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"Numeric ID of the Workspace (often referred to as Team ID) for which to retrieve Everything Level views.\nExamples:\n  18392\n  20450"}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get workspace everything level views","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_WORKSPACE_PLAN","description":"Retrieves the details of the current subscription plan for a specified ClickUp Workspace.","inputSchema":{"type":"object","properties":{"team_id":{"type":"string","description":"The unique identifier for the Workspace (formerly known as Team).\nExample: \"9010065123\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get workspace plan","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_WORKSPACE_SEATS","description":"Retrieves seat utilization (used, total, available for members/guests) for a ClickUp Workspace (Team) ID, which must be for an existing Workspace.","inputSchema":{"type":"object","properties":{"team_id":{"type":"string","description":"Numeric ID of the Workspace (Team).\nExample: \"1234567\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get workspace seats","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_INVITE_GUEST_TO_WORKSPACE","description":"Invites a guest by email to a ClickUp Workspace (Team) on an Enterprise Plan, setting initial permissions and optionally a custom role; further access configuration for specific items may require separate actions.","inputSchema":{"type":"object","properties":{"can_create_views":{"type":"boolean","description":"If `true`, the guest has permission to create views.\nExamples:\n  true\n  false"},"can_edit_tags":{"type":"boolean","description":"If `true`, the guest has permission to edit tags.\nExamples:\n  true\n  false"},"can_see_time_estimated":{"type":"boolean","description":"If `true`, the guest has permission to see time estimated for tasks.\nExamples:\n  true\n  false"},"can_see_time_spent":{"type":"boolean","description":"If `true`, the guest has permission to see time spent on tasks.\nExamples:\n  true\n  false"},"custom_role_id":{"type":"integer","description":"ID of a custom role to assign to the guest, for granular permission control beyond default guest permissions.\nExample: 987"},"email":{"type":"string","description":"Email address of the guest to invite to the Workspace.\nExample: \"guest@example.com\""},"team_id":{"type":"integer","description":"Unique identifier for the Workspace (Team) to which the guest will be invited.\nExample: 1234567"}},"required":["can_create_views","can_edit_tags","can_see_time_estimated","can_see_time_spent","custom_role_id","email","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Invite guest to workspace","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_INVITE_USER_TO_WORKSPACE","description":"Invites a user via email to a ClickUp Workspace (Team), optionally granting admin rights or a custom role; requires an Enterprise Plan for the Workspace.","inputSchema":{"type":"object","properties":{"admin":{"type":"boolean","description":"Grant administrative privileges to the invited user.\nExamples:\n  true\n  false"},"custom_role_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Optional custom role ID to assign; if omitted and custom roles are enabled, the default member role is used.","default":null},"email":{"type":"string","description":"Email address of the user to invite.\nExamples:\n  \"user@example.com\"\n  \"new.member@company.org\""},"team_id":{"type":"integer","description":"Unique identifier of the Workspace (Team) to which the user will be invited."}},"required":["admin","email","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Invite user to workspace","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_REMOVE_CUSTOM_FIELD_VALUE","description":"Removes an existing value from a Custom Field on a specific task; this does not delete the Custom Field definition or its predefined options.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"If true, `task_id` is a custom task ID, and `team_id` must also be provided.\nExamples:\n  \"true\"\n  \"false\""},"field_id":{"type":"string","description":"UUID of the Custom Field whose value will be removed from the task.\nExample: \"b8a8-48d8-a0c6-b4200788a683\""},"task_id":{"type":"string","description":"Identifier of the task. If `custom_task_ids` is true, this is the custom task ID; otherwise, it's the standard task ID.\nExamples:\n  \"standard_task_id_1\"\n  \"custom_task_ABC\""},"team_id":{"type":"integer","description":"Numeric ID of the team, required only if `custom_task_ids` is true to identify the task by its custom ID.\nExamples:\n  \"123\"\n  \"45678\""}},"required":["field_id","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove custom field value","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_REMOVE_GUEST_FROM_FOLDER","description":"Revokes a guest's access to a specific ClickUp Folder, optionally unsharing items explicitly shared with them within it; requires an Enterprise Plan.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"Unique identifier of the Folder from which to remove the guest.\nExample: 123456"},"guest_id":{"type":"integer","description":"Unique identifier of the guest to remove from the Folder.\nExample: 987654"},"include_shared":{"type":"boolean","description":"If `true`, items explicitly shared with the guest within this Folder are also unshared.","default":true}},"required":["folder_id","guest_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove guest from folder","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_REMOVE_GUEST_FROM_LIST","description":"Revokes a guest's access to a specific List, provided the guest currently has access to this List and the Workspace is on the ClickUp Enterprise Plan.","inputSchema":{"type":"object","properties":{"guest_id":{"type":"integer","description":"The unique identifier of the guest to be removed from the List.\nExample: \"9012345\""},"include_shared":{"type":"boolean","description":"If `false`, may alter how items shared with the guest are handled or reported during removal.\nExamples:\n  true\n  false","default":true},"list_id":{"type":"integer","description":"The unique identifier of the List from which the guest will be removed.\nExample: \"18273645\""}},"required":["guest_id","list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove guest from list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_REMOVE_GUEST_FROM_TASK","description":"Revokes a guest's access to a specific task; only available for Workspaces on the ClickUp Enterprise Plan.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Set to `true` if you are using a custom task ID for the `task_id` parameter. If `true`, `team_id` must also be provided.\nExamples:\n  \"true\"\n  \"false\""},"guest_id":{"type":"integer","description":"The numeric ID of the guest to be removed from the task.\nExamples:\n  \"12345\"\n  \"67890\""},"include_shared":{"type":"boolean","description":"Determines whether to include details of items shared with the guest. Set to `false` to exclude these details. Defaults to `true`.\nExamples:\n  \"true\"\n  \"false\""},"task_id":{"type":"string","description":"The ID of the task from which the guest will be removed. This can be the standard task ID or a custom task ID if `custom_task_ids` is set to `true`.\nExamples:\n  \"9hz\"\n  \"custom_task_id_123\""},"team_id":{"type":"integer","description":"The ID of the team. This is required only when `custom_task_ids` is set to `true` and you are using a custom task ID. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"456\""}},"required":["guest_id","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove guest from task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_REMOVE_GUEST_FROM_WORKSPACE","description":"Permanently removes a guest from a specified Workspace, revoking all their access; this destructive operation requires the Workspace to be on the ClickUp Enterprise Plan.","inputSchema":{"type":"object","properties":{"guest_id":{"type":"integer","description":"Unique numerical identifier for the guest user whose access to the specified Workspace will be revoked. This ID targets the specific guest for removal.\nExample: \"9876543\""},"team_id":{"type":"integer","description":"Unique numerical identifier for the Workspace (often referred to as 'Team' in the ClickUp API) from which the guest is to be removed. This ID specifies the scope of the removal operation.\nExample: \"1234567\""}},"required":["guest_id","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove guest from workspace","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_REMOVE_TAG_FROM_TASK","description":"Removes a tag from a specified task by disassociating it (does not delete the tag from Workspace), succeeding even if the tag is not on the task.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"Set to `true` if you are using a custom task ID (instead of the default task ID) to identify the task. If `true`, the `team_id` must also be provided.","default":null},"tag_name":{"type":"string","description":"The name of the tag to remove from the task. Tag names are case-sensitive.\nExamples:\n  \"urgent\"\n  \"frontend\"\n  \"bug-fix\""},"task_id":{"type":"string","description":"The ID of the task from which the tag will be removed. This can be the standard task ID or a custom task ID if `custom_task_ids` is set to `true`.\nExamples:\n  \"task_abc_123\"\n  \"custom_id_456\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The Workspace (Team) ID associated with the task.\nExamples:\n  123456\n  789012","default":null}},"required":["tag_name","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove tag from task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_REMOVE_TAGS_FROM_TIME_ENTRIES","description":"Removes tags from specified time entries in a team, without deleting the tags from the workspace.","inputSchema":{"type":"object","properties":{"tags":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"List of tags to remove, typically identified by name (e.g., `{'name': 'tag_name'}`).\nExamples:\n  \"[{'name': 'Urgent'}]\"\n  \"[{'name': 'Internal'}, {'name': 'Client Project'}]\""},"team_id":{"type":"integer","description":"The unique identifier for the Team (Workspace) that owns the time entries.\nExamples:\n  123456\n  789012"},"time_entry_ids":{"type":"array","items":{"type":"string"},"description":"List of time entry IDs from which to remove tags.\nExamples:\n  \"['time_entry_id_abc', 'time_entry_id_xyz']\"\n  \"['another_id_123']\""}},"required":["tags","team_id","time_entry_ids"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove tags from time entries","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_REMOVE_TASK_FROM_LIST","description":"Removes a task from an extra list (not its home list); the 'Tasks in Multiple Lists' ClickApp must be enabled.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"Unique numerical identifier of the list from which the task will be removed. This must be an extra list for the task, not its home list.\nExamples:\n  123\n  456"},"task_id":{"type":"string","description":"Unique identifier of the task to be removed from the specified list.\nExamples:\n  \"abc123xyz\"\n  \"task_001\""}},"required":["list_id","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove task from list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_REMOVE_USER_FROM_WORKSPACE","description":"Deactivates a user from a specified ClickUp Workspace, revoking their access (user can be reactivated later); requires the Workspace to be on an Enterprise Plan.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"The unique numeric identifier of the Workspace (Team) from which the user will be deactivated.\nExamples:\n  \"1830000\"\n  \"2050001\""},"user_id":{"type":"integer","description":"The unique numeric identifier of the user to be deactivated from the Workspace.\nExamples:\n  \"550\"\n  \"789\""}},"required":["team_id","user_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove user from workspace","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_SET_CUSTOM_FIELD_VALUE","description":"Sets or updates a Custom Field's value for a task; the new value (with type-dependent structure, e.g., `{\"value\": \"text\"}` or `{\"value\": 123, \"value_options\": {\"currency_type\":\"USD\"}}`) is provided in the JSON request body.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"If true, `task_id` is treated as a Custom Task ID, and `team_id` is required.","default":null},"field_id":{"type":"string","description":"UUID of the Custom Field to update (must be in standard UUID format with hyphens, e.g., '0f079e26-feef-410d-8e8d-2a21a057ee5e'). Obtainable via 'Get Accessible Custom Fields' or 'Get Task' endpoints.\nExamples:\n  \"062f7a9a-5c92-4180-bb59-82a66947fed2\"\n  \"c2b5e1f3-0a8d-4e6f-9b2c-7123456789ab\""},"task_id":{"type":"string","description":"Task ID to update. Standard ID, or Custom Task ID if `custom_task_ids` is true.\nExamples:\n  \"abc123de\"\n  \"task-xyz-789\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Team ID, required if `custom_task_ids` is true.\nExamples:\n  \"123\"\n  \"45678\"","default":null},"value":{"description":"The value to set for the Custom Field. Structure depends on field type: Text/Short Text: string (e.g., 'Hello'). Number/Currency/Emoji(Rating): number (e.g., 42). Checkbox: boolean (true/false). Dropdown: option UUID string from type_config.options (e.g., '7a4e5845-8496-4b9f-9097-843b9c737692'). Date: Unix timestamp in milliseconds (e.g., 1645502400000). Email: valid email string. Phone: string with country code (e.g., '+1 123 456 7890'). URL: valid URL string. Labels: array of label UUIDs from type_config (e.g., ['label_id_1', 'label_id_2']). Users/Tasks: object with 'add' and/or 'rem' arrays of IDs (e.g., {'add': ['id1'], 'rem': ['id2']}). Location: object with 'location' (lat/lng) and 'formatted_address' (e.g., {'location': {'lat': -28.0, 'lng': 153.4}, 'formatted_address': 'Gold Coast, Australia'}). Manual Progress: object with 'current' value (e.g., {'current': 50}).\nExamples:\n  \"Hello World\"\n  42\n  true\n  \"7a4e5845-8496-4b9f-9097-843b9c737692\"\n  1645502400000"},"value_options":{"anyOf":[{"type":"object","properties":{},"additionalProperties":true},{"type":"null"}],"description":"Optional settings for certain field types. For Date fields: {'time': true} to display time in ClickUp UI. For Currency fields: {'currency_type': 'USD'} to specify currency.\nExamples:\n  {\"time\":true}\n  {\"currency_type\":\"USD\"}","default":null}},"required":["field_id","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Set custom field value","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_SHARED_HIERARCHY","description":"Retrieves the hierarchy of tasks, Lists, and Folders shared with the authenticated user within an existing ClickUp Team (Workspace), identified by its `team_id`.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"Unique numerical ID of the ClickUp Team (Workspace) for which to fetch the shared hierarchy.\nExamples:\n  \"1234567\"\n  \"9876543\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Shared hierarchy","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_START_A_TIME_ENTRY","description":"Starts a new time entry (timer) in the specified Team (Workspace), optionally associating it with a task, adding a description, setting billable status, or applying tags (tags feature requires Business Plan or higher).","inputSchema":{"type":"object","properties":{"billable":{"type":["boolean","null"],"description":"Specifies if the time entry is billable.\nExamples:\n  true\n  false","default":null},"custom_task_ids":{"type":["boolean","null"],"description":"If set to `true`, the `tid` field will be interpreted as a custom task ID. Requires `team_id` query parameter to be set for custom task ID resolution.\nExample: true","default":null},"description":{"type":["string","null"],"description":"Description for the time entry.\nExamples:\n  \"Working on API integration\"\n  \"Client meeting follow-up\"","default":null},"tags":{"anyOf":[{"type":"array","items":{"type":"object","properties":{},"additionalProperties":{"type":"string"}}},{"type":"null"}],"description":"Array of tag objects (each with \"name\", optionally \"tag_bg\", \"tag_fg\" for colors) to apply. This feature requires Business Plan or higher. E.g., `[{\"name\": \"Urgent\", \"tag_bg\": \"#FF0000\"}]`.\nExample: [\"[{\\\"name\\\": \\\"billed\\\", \\\"tag_bg\\\": \\\"#000000\\\"}]\",\"[{\\\"name\\\": \\\"dev work\\\"}]\"]","default":null},"team_Id":{"type":"integer","description":"The Workspace ID (also called Team ID in ClickUp API) for this time entry. This goes in the URL path.\nExample: 123456"},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The ID of the team for resolving custom task IDs. Required only if `custom_task_ids` is set to `true`. For example: `custom_task_ids=true&team_id=123`.\nExample: 123","default":null},"tid":{"type":["string","null"],"description":"The ID of the task to associate with this time entry. If `custom_task_ids` is true, this should be the custom task ID.\nExamples:\n  \"task_abc_123\"\n  \"custom_id_456\"","default":null}},"required":["team_Id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Start a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_STOP_A_TIME_ENTRY","description":"Stops the authenticated user's currently active time entry in the specified Team (Workspace), which requires an existing time entry to be running.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"The unique numeric identifier of the Team (Workspace) where the time entry is being tracked.\nExamples:\n  1234567\n  8765432"}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Stop a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_TRACK_TIME","description":"Records a time entry for a task using ClickUp's legacy time tracking system; newer endpoints are generally recommended.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"If `true`, the `task_id` is treated as a custom task ID. Requires `team_id` to be provided.\nExamples:\n  \"true\"\n  \"false\""},"end":{"type":"integer","description":"The end time of the time entry, as a Unix timestamp in milliseconds.\nExamples:\n  \"1609462800000\"\n  \"1612141200000\""},"start":{"type":"integer","description":"The start time of the time entry, as a Unix timestamp in milliseconds.\nExamples:\n  \"1609459200000\"\n  \"1612137600000\""},"task_id":{"type":"string","description":"The unique identifier of the task to track time for.\nExamples:\n  \"abc123de\"\n  \"123\""},"team_id":{"type":"integer","description":"The ID of the team. Required and used only if `custom_task_ids` is set to `true` to identify the task by its custom ID. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"4567\""},"time":{"type":"integer","description":"The duration of the time entry, in milliseconds. If `start` and `end` are both provided, this `time` field is ignored. If `time` is passed with `start` but no `end`, then `end` will be calculated. If `time` is passed with `end` but no `start`, then `start` will be calculated.\nExamples:\n  \"3600000\"\n  \"7200000\""}},"required":["end","start","task_id","time"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Track time","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_A_TIME_ENTRY","description":"Updates an existing ClickUp time entry; provide `start` and `end` times together, and include `team_id` as a query param (request field `team_id_1`) if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"billable":{"type":"boolean","description":"Indicates whether the time entry is billable.\nExamples:\n  \"true\"\n  \"false\""},"custom_task_ids":{"type":"boolean","description":"If `true`, `tid` is interpreted as a custom task ID, and the `team_id` query parameter (request field `team_id_1`) must also be provided.\nExamples:\n  \"true\"\n  \"false\""},"description":{"type":"string","description":"A new description for the time entry.\nExample: \"Completed initial draft of the report\""},"duration":{"type":"integer","description":"New duration of the time entry in milliseconds; can be an alternative to `start` and `end` times.\nExample: \"3600000\""},"end":{"type":"integer","description":"New end time (Unix timestamp in milliseconds). If provided, `start` must also be provided.\nExample: \"1678890000000\""},"start":{"type":"integer","description":"New start time (Unix timestamp in milliseconds). If provided, `end` must also be provided.\nExample: \"1678886400000\""},"tag_action":{"type":"string","description":"Specifies how to handle `tags` (e.g., 'add', 'remove').\nExamples:\n  \"add\"\n  \"remove\""},"tags":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"List of tag objects (e.g., `{'name': 'your-tag'}`) for the time entry. Time tracking labels are for Business Plan and above users.\nExample: [{\"name\":\"Design\"},{\"name\":\"Development\"}]"},"team_id":{"type":"integer","description":"The Team (Workspace) ID, as a query parameter; required if `custom_task_ids` is `true`."},"tid":{"type":"string","description":"The ID of the task for this time entry; if `custom_task_ids` is `true`, this should be the custom task ID.\nExamples:\n  \"av1-123\"\n  \"custom_task_id_example\""},"timer_id":{"type":"integer","description":"The unique identifier of the time entry to update. Path parameter."}},"required":["tags","team_id","timer_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_COMMENT","description":"Updates an existing task comment's text, assignee (who must be a valid workspace member), or resolution status, requiring a valid existing comment_id.","inputSchema":{"type":"object","properties":{"assignee":{"type":"integer","description":"User ID of the assignee for the comment.\nExamples:\n  183\n  281"},"comment_id":{"type":"integer","description":"The unique identifier of the comment to be updated.\nExample: 123456789"},"comment_text":{"type":"string","description":"The new text content for the comment.\nExamples:\n  \"Please review this updated design mockup.\"\n  \"Let's discuss this in our next meeting.\""},"resolved":{"type":"boolean","description":"Set to `true` to mark the comment as resolved, or `false` to mark it as unresolved.\nExamples:\n  true\n  false"}},"required":["assignee","comment_id","comment_text","resolved"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update comment","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_UPDATE_FOLDER","description":"Updates the name of an existing folder in ClickUp.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"Unique identifier of the folder to update."},"name":{"type":"string","description":"New name for the folder.\nExamples:\n  \"Updated Project Documents\"\n  \"Q4 Marketing Initiatives\""}},"required":["folder_id","name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update folder","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_UPDATE_GOAL","description":"Updates attributes of an existing ClickUp goal, identified by its `goal_id`.","inputSchema":{"type":"object","properties":{"add_owners":{"type":"array","items":{"type":"integer"},"description":"User IDs to add as owners.\nExample: [403,512]"},"color":{"type":"string","description":"New color (hex code).\nExample: \"#FF0000\""},"description":{"type":"string","description":"New description for the goal.\nExample: \"Finalize the Q3 marketing strategy and present to stakeholders.\""},"due_date":{"type":"integer","description":"New due date (Unix timestamp in milliseconds).\nExample: 1678886400000"},"goal_id":{"type":"string","description":"Unique identifier (UUID) of the goal to update.\nExample: \"900e-462d-a849-4a216b06d930\""},"name":{"type":"string","description":"New name for the goal.\nExample: \"Q3 Marketing Strategy Finalization\""},"rem_owners":{"type":"array","items":{"type":"integer"},"description":"User IDs to remove as owners.\nExample: [183,281]"}},"required":["add_owners","color","description","due_date","goal_id","name","rem_owners"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update goal","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_LIST","description":"Updates attributes of an existing ClickUp list, such as its name, content, due date, priority, assignee, or color status, identified by its `list_id`.","inputSchema":{"type":"object","properties":{"assignee":{"type":"string","description":"User ID to be set as the assignee for the list, replacing any existing assignee.\nExamples:\n  \"183\"\n  \"456789\""},"content":{"type":"string","description":"New description or informational content for the list.\nExamples:\n  \"All tasks related to Project Alpha release.\"\n  \"Detailed plan for Q3 marketing initiatives.\""},"due_date":{"type":"integer","description":"New due date for the list, as a Unix timestamp in milliseconds (e.g., `1672531199000` for Dec 31, 2022, 11:59:59 PM UTC).\nExamples:\n  \"1672531199000\"\n  \"1704067199000\""},"due_date_time":{"type":"boolean","description":"Indicates if `due_date` includes a specific time; if `false`, it's an all-day event.\nExamples:\n  true\n  false"},"list_id":{"type":"string","description":"ID of the list to be updated."},"name":{"type":"string","description":"New name for the list.\nExamples:\n  \"Project Alpha Tasks\"\n  \"Q3 Marketing Plan\""},"priority":{"type":"integer","description":"Priority level: `1` (Urgent), `2` (High), `3` (Normal), `4` (Low), or `0` to unset.\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\"\n  \"0\""},"status":{"type":"string","description":"Color for the list (e.g., 'red' or '#FF0000'), visually representing its status (not task status).\nExamples:\n  \"blue\"\n  \"red\"\n  \"#2CA01C\"\n  \"darkorange\""},"unset_status":{"type":"boolean","description":"Set to `true` to remove the list's color, overriding `status`; if `false`, `status` updates or maintains current color.\nExamples:\n  true\n  false"}},"required":["assignee","content","due_date","due_date_time","list_id","name","priority","status","unset_status"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_SPACE","description":"Updates an existing ClickUp Space, allowing modification of its name, color, privacy, and feature settings (ClickApps).","inputSchema":{"type":"object","properties":{"admin_can_manage":{"type":["boolean","null"],"description":"Whether admins can manage this private Space. This is an Enterprise Plan feature. Must be omitted for non-Enterprise workspaces.\nExample: true","default":null},"color":{"type":"string","description":"The new color for the Space, in hexadecimal format.\nExample: \"#a2d2ff\""},"features__checklists__enabled":{"type":["boolean","null"],"description":"Enable or disable the Checklists ClickApp.\nExample: true","default":null},"features__custom_fields__enabled":{"type":["boolean","null"],"description":"Enable or disable the Custom Fields ClickApp.\nExample: true","default":null},"features__dependency_warning__enabled":{"type":["boolean","null"],"description":"Enable or disable Dependency Warning for the Task Dependencies ClickApp.\nExample: true","default":null},"features__due_dates__enabled":{"type":["boolean","null"],"description":"Enable or disable the Due Dates ClickApp.\nExample: true","default":null},"features__due_dates__remap_closed_due_date":{"type":["boolean","null"],"description":"Enable or disable remapping of closed due dates for the Due Dates ClickApp.\nExample: true","default":null},"features__due_dates__remap_due_dates":{"type":["boolean","null"],"description":"Enable or disable remapping of due dates for the Due Dates ClickApp.\nExample: true","default":null},"features__due_dates__start_date":{"type":["boolean","null"],"description":"Enable or disable Start Dates for the Due Dates ClickApp.\nExample: true","default":null},"features__portfolios__enabled":{"type":["boolean","null"],"description":"Enable or disable the Portfolios ClickApp.\nExample: true","default":null},"features__remap_dependencies__enabled":{"type":["boolean","null"],"description":"Enable or disable Remap Dependencies for the Task Dependencies ClickApp.\nExample: true","default":null},"features__tags__enabled":{"type":["boolean","null"],"description":"Enable or disable the Tags ClickApp. When any feature parameter is provided, all feature keys must be included (due_dates, time_estimates, time_tracking, remap_dependencies, custom_fields, dependency_warning, tags, checklists, portfolios).\nExample: true","default":null},"features__time_estimates__enabled":{"type":["boolean","null"],"description":"Enable or disable the Time Estimates ClickApp.\nExample: true","default":null},"features__time_tracking__enabled":{"type":["boolean","null"],"description":"Enable or disable the Time Tracking ClickApp.\nExample: true","default":null},"multiple_assignees":{"type":"boolean","description":"Whether tasks in this Space can have multiple assignees.\nExample: true"},"name":{"type":"string","description":"The new name for the Space.\nExample: \"Updated Space Name\""},"private":{"type":"boolean","description":"Whether the Space should be private.\nExample: true"},"space_id":{"type":"integer","description":"The ID of the Space to update.\nExample: 123456"}},"required":["color","multiple_assignees","name","private","space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update space","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_TASK","description":"Updates attributes of an existing task; `team_id` is required if `custom_task_ids` is true, use a single space (\" \") for `description` to clear it, and provide at least one modifiable field.","inputSchema":{"type":"object","properties":{"archived":{"type":"boolean","description":"True to archive, false to unarchive.\nExamples:\n  \"true\"\n  \"false\""},"assignees__add":{"type":"array","items":{"type":"integer"},"description":"List of user IDs to add as assignees.\nExamples:\n  \"[183]\"\n  \"[123, 456]\""},"assignees__rem":{"type":"array","items":{"type":"integer"},"description":"List of user IDs to remove as assignees.\nExamples:\n  \"[789]\"\n  \"[101, 202]\""},"custom_item_id":{"type":"integer","description":"Custom task type ID. Use `1` for Milestone, its ID for custom type. Omit/`None` to make regular task (API's 'null' equivalent).\nExamples:\n  \"1\"\n  \"2\""},"custom_task_ids":{"type":"boolean","description":"If true, `task_id` is a custom ID and `team_id` is required.\nExamples:\n  \"true\"\n  \"false\""},"description":{"type":"string","description":"New task description; use a single space (\" \") to clear.\nExamples:\n  \"Updated task details.\"\n  \" \""},"due_date":{"type":"integer","description":"New due date (Unix timestamp in milliseconds).\nExamples:\n  \"1678886400000\"\n  \"1700000000000\""},"due_date_time":{"type":"boolean","description":"True if `due_date` includes time, false if all-day.\nExamples:\n  \"true\"\n  \"false\""},"name":{"type":"string","description":"New task name.\nExamples:\n  \"Finalize Q3 Report\"\n  \"Urgent: Fix login bug\""},"parent":{"type":"string","description":"ID of new parent task to make this a subtask; cannot convert subtask to regular task this way.\nExamples:\n  \"task_id_parent_abc\"\n  \"task_id_parent_xyz\""},"priority":{"type":"integer","description":"Priority: 1 (Urgent), 2 (High), 3 (Normal), 4 (Low). Omit or `None` to remove.\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\""},"start_date":{"type":"integer","description":"New start date (Unix timestamp in milliseconds).\nExamples:\n  \"1678880000000\"\n  \"1690000000000\""},"start_date_time":{"type":"boolean","description":"True if `start_date` includes time, false if all-day.\nExamples:\n  \"true\"\n  \"false\""},"status":{"type":"string","description":"New task status (case-sensitive, must be valid in Workspace).\nExamples:\n  \"in progress\"\n  \"complete\"\n  \"To Do\""},"task_id":{"type":"string","description":"Unique task identifier; use custom task ID if `custom_task_ids` is true.\nExamples:\n  \"abc123xyz\"\n  \"custom-id-007\""},"team_id":{"type":"integer","description":"Team ID, required if `custom_task_ids` is true.\nExample: \"123456\""},"time_estimate":{"type":"integer","description":"New time estimate in milliseconds.\nExamples:\n  \"3600000\"\n  \"7200000\""}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_TEAM","description":"Updates an existing ClickUp User Group (Team) using its `group_id`; note that adding a view-only guest as a paid member may incur charges.","inputSchema":{"type":"object","properties":{"group_id":{"type":"string","description":"The ID of the User Group (Team) to update.\nExample: \"7C73-4002-A6A9-310014852858\""},"handle":{"type":"string","description":"The new handle for the User Group (Team), used for @mentions (e.g., '@developers').\nExample: \"marketing-team-handle\""},"members__add":{"type":"array","items":{"type":"integer"},"description":"A list of user IDs to add to the User Group (Team).\nExample: [183,4051]"},"members__rem":{"type":"array","items":{"type":"integer"},"description":"A list of user IDs to remove from the User Group (Team).\nExample: [123,987]"},"name":{"type":"string","description":"The new name for the User Group (Team).\nExample: \"New Marketing Team\""}},"required":["group_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update team","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_VIEW","description":"Updates an existing ClickUp view's settings such as name, type, grouping, or filters; ensure `parent_id` and `parent_type` define a valid hierarchy, and that specified field names (e.g. for sorting, columns) are valid within the ClickUp workspace.","inputSchema":{"type":"object","properties":{"columns__fields":{"type":"array","items":{"type":"string"},"description":"Fields to display as columns in the view. Custom Fields require the `_cf` prefix and their ID (e.g., `_cf_custom_field_id`).\nExample: [\"assignee\",\"dueDate\",\"_cf_xyz123\"]"},"divide__collapsed":{"type":"boolean","description":"Indicates if divided sections should be collapsed. Currently, this field may not be actively used or may be deprecated."},"divide__dir":{"type":"null","description":"The direction for dividing the view. Currently, this field may not be actively used or may be deprecated."},"divide__field":{"type":"null","description":"The field to divide the view by (e.g., to create swimlanes in a board view). Currently, this field may not be actively used or may be deprecated."},"filters__fields":{"type":"array","items":{"type":"string"},"description":"Fields to apply filters on; refer to ClickUp API documentation for available fields.\nExample: [\"priority\",\"status\"]"},"filters__op":{"type":"string","description":"The operator for combining filters. Available values are `AND` and `OR`.\nExamples:\n  \"AND\"\n  \"OR\""},"filters__search":{"type":"string","description":"A search string to filter tasks by name or content.\nExamples:\n  \"Urgent Task\"\n  \"bug report\""},"filters__show__closed":{"type":"boolean","description":"If true, closed tasks will be included in the view."},"grouping__collapsed":{"type":"array","items":{"type":"string"},"description":"A list of group identifiers (e.g., status names or assignee IDs) that should be collapsed by default in the view.\nExamples:\n  [\"To Do\",\"In Progress\"]\n  [\"user_id_123\"]"},"grouping__dir":{"type":"integer","description":"The sort order for grouping. Use `1` for ascending (e.g., urgent priority at the top) or `-1` for descending (e.g., no priority at the top).\nExamples:\n  1\n  -1"},"grouping__field":{"type":"string","description":"The field to group tasks by. Options include: `none`, `status`, `priority`, `assignee`, `tag`, or `dueDate`.\nExamples:\n  \"status\"\n  \"priority\"\n  \"assignee\""},"grouping__ignore":{"type":"boolean","description":"If true, tasks with no value for the `grouping_field` will not be grouped."},"name":{"type":"string","description":"The new name for the view.\nExamples:\n  \"My Updated List View\"\n  \"Project Kanban Board\""},"parent__id":{"type":"string","description":"The ID of the Workspace, Space, Folder, or List where the view is located. \nExamples:\n  \"space_id_123\"\n  \"folder_id_456\""},"parent__type":{"type":"integer","description":"The level of the Hierarchy where the view is created. Options include: Workspace (Everything Level): `7`, Space: `4`, Folder: `5`, List: `6`.\nExamples:\n  4\n  5\n  6\n  7"},"settings__collapse__empty__columns":{"type":"string","description":"If true, columns with no tasks will be collapsed (e.g., in Board view). This might accept boolean as a string like 'true' or 'false'.\nExamples:\n  \"true\"\n  \"false\""},"settings__me__checklists":{"type":"boolean","description":"If true, in 'Me Mode', only checklists assigned to the current user will be shown."},"settings__me__comments":{"type":"boolean","description":"If true, in 'Me Mode', only comments where the current user is mentioned or involved will be shown."},"settings__me__subtasks":{"type":"boolean","description":"If true, in 'Me Mode', only subtasks assigned to the current user will be shown."},"settings__show__assignees":{"type":"boolean","description":"If true, assignees will be displayed on tasks."},"settings__show__closed__subtasks":{"type":"boolean","description":"If true, closed subtasks will be included in the view."},"settings__show__images":{"type":"boolean","description":"If true, images attached to tasks will be displayed in the view (e.g. cover images in card view)."},"settings__show__subtask__parent__names":{"type":"boolean","description":"If true, parent task names will be displayed for subtasks."},"settings__show__subtasks":{"type":"integer","description":"Controls how subtasks are displayed. Acceptable values are `1` (show subtasks as separate tasks), `2` (show subtasks expanded under parent task), or `3` (show subtasks collapsed under parent task).\nExamples:\n  1\n  2\n  3"},"settings__show__task__locations":{"type":"boolean","description":"If true, task locations (List, Folder, Space) will be displayed."},"sorting__fields":{"type":"array","items":{"type":"string"},"description":"Fields to sort tasks by; refer to ClickUp API documentation for available filter fields.\nExample: [\"dueDate\",\"priority\"]"},"team__sidebar__assigned__comments":{"type":"boolean","description":"If true, assigned comments will be shown in the team sidebar."},"team__sidebar__assignees":{"type":"array","items":{"type":"string"},"description":"A list of assignee user IDs to feature in the team sidebar.\nExample: [\"user_id_1\",\"user_id_2\"]"},"team__sidebar__unassigned__tasks":{"type":"boolean","description":"If true, unassigned tasks will be shown in the team sidebar."},"type":{"type":"string","description":"The type of the view.\nExamples:\n  \"list\"\n  \"board\"\n  \"calendar\"\n  \"gantt\"\n  \"table\"\n  \"mind_map\"\n  \"workload\"\n  \"activity\"\n  \"map\"\n  \"doc\"\n  \"chat\"\n  \"form\"\n  \"embed\""},"view_id":{"type":"string","description":"The unique identifier of the view to be updated."}},"required":["name","type","view_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update view","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_WEBHOOK","description":"Updates the endpoint URL, monitored events, and status of an existing webhook, identified by its `webhook_id`.","inputSchema":{"type":"object","properties":{"endpoint":{"type":"string","description":"The new URL where the webhook payloads will be sent.\nExample: \"https://example.com/webhook-receiver\""},"events":{"type":"array","items":{"type":"string"},"description":"List of event types to monitor. Use [\"*\"] to subscribe to all events. Common events include: taskCreated, taskUpdated, taskDeleted, taskStatusUpdated, taskAssigneeUpdated, taskDueDateUpdated, taskTagUpdated, taskMoved, taskCommentPosted, taskCommentUpdated, listCreated, listUpdated, listDeleted, folderCreated, folderUpdated, folderDeleted, spaceCreated, spaceUpdated, spaceDeleted, goalCreated, goalUpdated, goalDeleted, keyResultCreated, keyResultUpdated, keyResultDeleted.\nExamples:\n  [\"taskCreated\",\"taskStatusUpdated\"]\n  [\"*\"]"},"status":{"type":"string","description":"The desired status of the webhook after the update.\nExamples:\n  \"active\"\n  \"inactive\""},"webhook_id":{"type":"string","description":"The unique identifier of the webhook to be updated. Example: 'e506-4a29-9d42-26e504e3435e'.\nExample: \"e506-4a29-9d42-26e504e3435e\""}},"required":["endpoint","events","status","webhook_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update webhook","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_ADD_LABELS_TO_AN_ISSUE","description":"Adds labels (provided in the request body) to a repository issue; labels that do not already exist are created.","inputSchema":{"type":"object","properties":{"issue_number":{"type":"integer","description":"Number that uniquely identifies the issue within the repository.\nExamples:\n  \"42\"\n  \"101\""},"labels":{"type":"array","items":{"type":"string"},"description":"Array of label names to add to the issue. Labels that don't exist will be created automatically.\nExamples:\n  [\"bug\",\"enhancement\"]\n  [\"documentation\",\"help wanted\"]"},"owner":{"type":"string","description":"Username or organization name owning the repository (case-insensitive).\nExamples:\n  \"octocat\"\n  \"my-organization\""},"repo":{"type":"string","description":"Repository name, without the `.git` extension (case-insensitive).\nExamples:\n  \"Spoon-Knife\"\n  \"my-awesome-project\""}},"required":["issue_number","labels","owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add labels to an issue","scopes":["repo","public_repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":true}},{"name":"GITHUB_CREATE_A_COMMIT","description":"Creates a new commit in a GitHub repository; the `tree` SHA and any `parents` SHAs must already exist in the repository.","inputSchema":{"type":"object","properties":{"author__date":{"type":"string","format":"date-time","description":"Timestamp (ISO 8601: `YYYY-MM-DDTHH:MM:SSZ`) when the commit was authored.\nExample: \"2024-01-15T10:30:00Z\""},"author__email":{"type":"string","description":"Email of the commit's author. Defaults to authenticated user if not provided.\nExample: \"mona@example.com\""},"author__name":{"type":"string","description":"Name of the commit's author. Defaults to authenticated user if not provided.\nExample: \"Mona Lisa Octocat\""},"committer__date":{"type":"string","format":"date-time","description":"Timestamp (ISO 8601: `YYYY-MM-DDTHH:MM:SSZ`) when the commit was committed. Defaults to `author_date` or current time.\nExample: \"2024-01-15T10:35:00Z\""},"committer__email":{"type":"string","description":"Email of the committer. Defaults to author's email or authenticated user if not provided.\nExample: \"octocat@example.com\""},"committer__name":{"type":"string","description":"Name of the committer. Defaults to author's name or authenticated user if not provided.\nExample: \"The Octocat\""},"message":{"type":"string","description":"The commit message.\nExample: \"feat: implement user authentication endpoint\""},"owner":{"type":"string","description":"Account owner of the repository (case-insensitive).\nExample: \"octocat\""},"parents":{"type":"array","items":{"type":"string"},"description":"SHAs of parent commits; all must exist in the repository. Omit or provide an empty list for a root commit.\nExamples:\n  \"[\\\"1a2b3c4d5e6f7g8h9i0jabcdef1234567890\\\"]\"\n  \"[\\\"parent_sha_main\\\", \\\"parent_sha_feature_branch\\\"]\""},"repo":{"type":"string","description":"Name of the repository, without the `.git` extension (case-insensitive).\nExample: \"Spoon-Knife\""},"signature":{"type":"string","description":"ASCII-armored detached PGP signature over the commit data. GitHub adds this to the `gpgsig` header if provided.\nExample: \"-----BEGIN PGP SIGNATURE-----\\\\n...\\\\n-----END PGP SIGNATURE-----\""},"tree":{"type":"string","description":"SHA of the tree object for this commit; must exist in the repository.\nExample: \"9c1a209e10072fe99393945673ace821a4827669\""}},"required":["message","owner","repo","tree"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create a commit","scopes":["repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_CREATE_A_COMMIT_STATUS","description":"Sets a commit's status (e.g., error, failure, pending, success from CI/CD) for a given SHA; max 1000 statuses per SHA/context.","inputSchema":{"type":"object","properties":{"context":{"type":"string","description":"Label to differentiate this status from other systems (e.g., 'ci/jenkins'); case-insensitive.\nExamples:\n  \"ci/jenkins\"\n  \"linter/eslint\"\n  \"default\"","default":"default"},"description":{"type":"string","description":"Human-readable description of the status, displayed in GitHub UI.\nExamples:\n  \"Build successful\"\n  \"Tests passed with 0 failures\"\n  \"Deployment to staging failed\""},"owner":{"type":"string","description":"Username or organization name of the repository owner (case-insensitive).\nExamples:\n  \"octocat\"\n  \"github\""},"repo":{"type":"string","description":"Repository name, without the `.git` extension (case-insensitive).\nExamples:\n  \"Hello-World\"\n  \"Spoon-Knife\""},"sha":{"type":"string","description":"SHA hash of the commit.\nExamples:\n  \"c5b97d5ae6c19d5c5df71a34c7fbeeda2479ccbc\"\n  \"6dcb09b5b57875f334f61aebed695e2e4193db5e\""},"state":{"type":"string","enum":["error","failure","pending","success"],"description":"State of the commit status, indicating check outcome or phase.\nExamples:\n  \"error\"\n  \"failure\"\n  \"pending\"\n  \"success\""},"target_url":{"type":"string","description":"URL linking to the source of the status (e.g., CI build log), displayed in GitHub UI.\nExamples:\n  \"http://ci.example.com/user/repo/build/sha\"\n  \"https://example.com/deployment/status/123\""}},"required":["owner","repo","sha","state"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create a commit status","scopes":["repo:status"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_CREATE_AN_ISSUE","description":"Creates a new issue in a GitHub repository, requiring the repository to exist and have issues enabled; specific fields like assignees, milestone, or labels may require push access.","inputSchema":{"type":"object","properties":{"assignee":{"type":"string","description":"Login for the user to whom this issue should be assigned. NOTE: Only users with push access can set the assignee; it is silently dropped otherwise. **This field is deprecated in favor of `assignees`.**\nExamples:\n  \"octocat\"\n  \"monalisa\""},"assignees":{"type":"array","items":{"type":"string"},"description":"GitHub login names for users to assign to this issue. NOTE: Only users with push access can set assignees; they are silently dropped otherwise.\nExamples:\n  [\"octocat\"]\n  [\"monalisa\",\"hubot\"]"},"body":{"type":"string","description":"The detailed textual contents of the new issue.\nExamples:\n  \"Detailed description of the bug with steps to reproduce.\"\n  \"I think adding a dark mode would improve user experience...\""},"labels":{"type":"array","items":{"type":"string"},"description":"Array of label names to associate with this issue (generally case-insensitive). NOTE: Only users with push access can set labels; they are silently dropped otherwise. Pass an empty list to clear all labels.\nExamples:\n  [\"bug\",\"critical\"]\n  [\"enhancement\",\"ui\"]\n  [\"documentation\"]"},"milestone":{"type":"string","description":"The ID of the milestone to associate this issue with (e.g., \"5\"). NOTE: Only users with push access can set the milestone; it is silently dropped otherwise.\nExamples:\n  \"1\"\n  \"5\""},"owner":{"type":"string","description":"The GitHub account owner of the repository (case-insensitive). The repository must exist and be accessible to the authenticated user.\nExamples:\n  \"octocat\"\n  \"torvalds\""},"repo":{"type":"string","description":"The name of the repository, without the `.git` extension (case-insensitive). The repository must exist, be accessible, and have issues enabled.\nExamples:\n  \"Spoon-Knife\"\n  \"linux\""},"title":{"type":"string","description":"The title for the new issue.\nExamples:\n  \"Found a critical bug\"\n  \"Feature request: Add dark mode\""}},"required":["owner","repo","title"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create an issue","scopes":["repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_CREATE_AN_ISSUE_COMMENT","description":"Creates a new comment on an existing GitHub issue or pull request within the specified repository.","inputSchema":{"type":"object","properties":{"body":{"type":"string","description":"Comment content in GitHub Flavored Markdown.\nExamples:\n  \"This is a **bold** comment!\"\n  \"Thanks for the update :+1:\"\n  \"Fixes #123\""},"issue_number":{"type":"integer","description":"Number identifying the issue or pull request for the comment.\nExamples:\n  42\n  101"},"owner":{"type":"string","description":"Account owner of the repository (username or organization); not case-sensitive.\nExamples:\n  \"octocat\"\n  \"my-organization\""},"repo":{"type":"string","description":"Name of the repository (without `.git` extension); not case-sensitive.\nExamples:\n  \"Spoon-Knife\"\n  \"my-awesome-project\""}},"required":["body","issue_number","owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create an issue comment","scopes":["repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_CREATE_A_PULL_REQUEST","description":"Creates a pull request in a GitHub repository, requiring existing `base` and `head` branches; `title` or `issue` must be provided.","inputSchema":{"type":"object","properties":{"base":{"type":"string","description":"The name of the branch you want the changes pulled into. This must be an existing branch on the current (target) repository. You cannot submit a pull request to one repository that requests a merge to a base branch of another repository. \nExamples:\n  \"main\"\n  \"develop\""},"body":{"type":"string","description":"The detailed description or contents of the pull request.\nExamples:\n  \"This PR introduces a new feature that does X, Y, and Z.\"\n  \"Fixes #42 by addressing the off-by-one error.\""},"draft":{"type":"boolean","description":"Indicates whether the pull request should be created as a draft. Draft pull requests cannot be merged until marked as ready for review.\nExamples:\n  true\n  false"},"head":{"type":"string","description":"The name of the branch where your changes are implemented. IMPORTANT: This branch must already exist in the repository (or fork) before calling this action. You must first create the branch and push commits to it (using git or the 'Create a reference' action), then create the PR. For cross-repository pull requests, namespace `head` with the source owner and branch, like `username:branch`.\nExamples:\n  \"feature-branch\"\n  \"octocat:my-feature-branch\""},"head_repo":{"type":"string","description":"The name of the repository (e.g., 'octocat/Hello-World') where the changes in the pull request were made. This field is required for cross-repository pull requests if both the source and target repositories are owned by the same organization but are different repositories.\nExample: \"octocat/my-forked-repo\""},"issue":{"type":"integer","description":"The number of an existing issue in the repository to convert into a pull request. If provided, the issue's title and body may be used for the pull request. Required if `title` is not specified.\nExamples:\n  \"123\"\n  \"456\""},"maintainer_can_modify":{"type":"boolean","description":"Indicates whether maintainers of the upstream repository can modify the pull request. This is primarily relevant for pull requests originating from forks.\nExamples:\n  true\n  false"},"owner":{"type":"string","description":"The account owner of the repository. This name is not case-sensitive.\nExample: \"octocat\""},"repo":{"type":"string","description":"The name of the repository, without the `.git` extension. This name is not case-sensitive.\nExample: \"Spoon-Knife\""},"title":{"type":"string","description":"The title of the new pull request. Required unless `issue` is specified.\nExamples:\n  \"Amazing new feature\"\n  \"Fix for critical bug #123\""}},"required":["base","head","owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create a pull request","scopes":["repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_CREATE_A_REPOSITORY_FOR_THE_AUTHENTICATED_USER","description":"Creates a new repository for the authenticated user, optionally within an organization if `team_id` is specified.","inputSchema":{"type":"object","properties":{"allow_auto_merge":{"type":"boolean","description":"Whether to allow auto-merge on pull requests.","default":false},"allow_merge_commit":{"type":"boolean","description":"Whether to allow merging pull requests with a merge commit.","default":true},"allow_rebase_merge":{"type":"boolean","description":"Whether to allow rebase-merging pull requests.","default":true},"allow_squash_merge":{"type":"boolean","description":"Whether to allow squash-merging pull requests.","default":true},"auto_init":{"type":"boolean","description":"Whether to initialize the repository with a README.","default":false},"delete_branch_on_merge":{"type":"boolean","description":"Whether to automatically delete head branches when pull requests are merged.","default":false},"description":{"type":"string","description":"A short description of the repository.\nExamples:\n  \"This is a project about X.\"\n  \"My personal blog.\""},"gitignore_template":{"type":"string","description":"Desired .gitignore template (e.g., 'Python', 'Node').\nExamples:\n  \"Python\"\n  \"Node\"\n  \"Ruby\""},"has_discussions":{"type":"boolean","description":"Whether discussions are enabled.","default":false},"has_downloads":{"type":"boolean","description":"Whether downloads are enabled (deprecated by GitHub and may not be configurable).","default":true},"has_issues":{"type":"boolean","description":"Whether issues are enabled.","default":true},"has_projects":{"type":"boolean","description":"Whether projects are enabled.","default":true},"has_wiki":{"type":"boolean","description":"Whether the wiki is enabled.","default":true},"homepage":{"type":"string","description":"A URL with more information about the repository.\nExample: \"https://example.com/my-new-repo\""},"is_template":{"type":"boolean","description":"Whether this repository is a template repository.","default":false},"license_template":{"type":"string","description":"License template keyword (e.g., 'mit', 'apache-2.0').\nExamples:\n  \"mit\"\n  \"apache-2.0\"\n  \"gpl-3.0\""},"merge_commit_message":{"type":"string","enum":["PR_BODY","PR_TITLE","BLANK"],"description":"The default message for a merge commit. `PR_BODY` uses the pull request's body. `PR_TITLE` uses the pull request's title. `BLANK` results in a blank commit message.\nExamples:\n  \"PR_BODY\"\n  \"PR_TITLE\"\n  \"BLANK\""},"merge_commit_title":{"type":"string","enum":["PR_TITLE","MERGE_MESSAGE"],"description":"The default title for a merge commit. `PR_TITLE` uses the pull request's title. `MERGE_MESSAGE` uses a classic title like 'Merge pull request #123 from branch-name'.\nExamples:\n  \"PR_TITLE\"\n  \"MERGE_MESSAGE\""},"name":{"type":"string","description":"The name of the repository. Must be unique within your account. Will be used in the repository URL (github.com/username/repo-name). Can only contain alphanumeric characters, hyphens, underscores, and periods.\nExamples:\n  \"my-new-repo\"\n  \"hello-world\""},"private":{"type":"boolean","description":"Whether the repository is private (true) or public (false).","default":false},"squash_merge_commit_message":{"type":"string","enum":["PR_BODY","COMMIT_MESSAGES","BLANK"],"description":"The default message for a squash merge commit. `PR_BODY` uses the pull request's body. `COMMIT_MESSAGES` uses the branch's commit messages. `BLANK` results in a blank commit message.\nExamples:\n  \"PR_BODY\"\n  \"COMMIT_MESSAGES\"\n  \"BLANK\""},"squash_merge_commit_title":{"type":"string","enum":["PR_TITLE","COMMIT_OR_PR_TITLE"],"description":"The default title for a squash merge commit. `PR_TITLE` uses the pull request's title. `COMMIT_OR_PR_TITLE` uses the commit's title (if only one commit) or the pull request's title (if multiple commits).\nExamples:\n  \"PR_TITLE\"\n  \"COMMIT_OR_PR_TITLE\""},"team_id":{"type":"integer","description":"The ID of the team to be granted access. Only valid if creating in an organization.\nExample: 12345"}},"required":["name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create a repository for the authenticated user","scopes":["repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_CREATE_OR_UPDATE_FILE_CONTENTS","description":"Creates a new file or updates an existing file in a GitHub repository; SHA can be provided to validate file updates, automatically fetched if not provided.","inputSchema":{"type":"object","properties":{"author__date":{"type":["string","null"],"description":"Author's timestamp (ISO 8601 format). Defaults to committer's date if author details are provided but date is not.\nExample: \"2023-10-26T11:30:00Z\"","default":null},"author__email":{"type":["string","null"],"description":"Author's email. If specified, `author_name` is also required. Defaults to committer details; if all committer/author details omitted, GitHub uses authenticated user.\nExample: \"jane.smith@example.com\"","default":null},"author__name":{"type":["string","null"],"description":"Author's name. If specified, `author_email` is also required. Defaults to committer details; if all committer/author details omitted, GitHub uses authenticated user.\nExample: \"Jane Smith\"","default":null},"branch":{"type":["string","null"],"description":"The branch name. Defaults to the repository's default branch if omitted. The branch must already exist; use GITHUB_CREATE_A_REFERENCE to create a new branch first.\nExamples:\n  \"main\"\n  \"develop\"","default":null},"committer__date":{"type":["string","null"],"description":"Committer's commit timestamp (ISO 8601 format). Defaults to current time if committer details are provided but date is not.\nExample: \"2023-10-26T12:00:00Z\"","default":null},"committer__email":{"type":["string","null"],"description":"Committer's email. If specified, `committer_name` is also required. GitHub uses authenticated user if all committer/author details omitted.\nExample: \"john.doe@example.com\"","default":null},"committer__name":{"type":["string","null"],"description":"Committer's name. If specified, `committer_email` is also required. GitHub uses authenticated user if all committer/author details omitted.\nExample: \"John Doe\"","default":null},"content":{"type":"string","description":"The new file content. Can be provided as plain text (will be automatically encoded to Base64) or as Base64-encoded text. GitHub API requires Base64 encoding, which this action handles automatically.\nExamples:\n  \"Hello World\"\n  \"SGVsbG8gV29ybGQ=\""},"message":{"type":"string","description":"The commit message for this file creation or update.\nExamples:\n  \"feat: add new documentation\"\n  \"docs: update README\""},"owner":{"type":"string","description":"The account owner of the repository (not case sensitive).\nExample: \"octocat\""},"path":{"type":"string","description":"The full path to the file in the repository, including the filename and extension.\nExamples:\n  \"README.md\"\n  \"src/main.js\""},"repo":{"type":"string","description":"The name of the repository (not case sensitive, without the `.git` extension).\nExample: \"Spoon-Knife\""},"sha":{"type":["string","null"],"description":"The blob SHA of the file being replaced. Automatically fetched if not provided. If a 409 conflict occurs (SHA mismatch due to concurrent modifications), the action will automatically retry up to 3 times with a refreshed SHA.\nExample: \"aa218f56b14c9653891f9e74264a383fa43fefbd\"","default":null}},"required":["content","message","owner","path","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create or update file contents","scopes":["repo","public_repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_DOWNLOAD_WORKFLOW_RUN_LOGS","description":"Downloads logs for a specific GitHub Actions workflow run, typically archived as a ZIP file, if logs are available (e.g., not expired and the workflow has produced output).","inputSchema":{"type":"object","properties":{"owner":{"type":"string","description":"The account owner of the repository (e.g., 'octocat'). This name is not case-sensitive.\nExamples:\n  \"octocat\"\n  \"github\""},"repo":{"type":"string","description":"The name of the repository (e.g., 'Spoon-Knife') without the `.git` extension. This name is not case-sensitive.\nExamples:\n  \"Hello-World\"\n  \"octocat.github.io\""},"run_id":{"type":"integer","description":"The unique identifier of the workflow run (e.g., 12345).\nExamples:\n  \"1616202549\"\n  \"3043364204\""}},"required":["owner","repo","run_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Download workflow run logs","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_GET_A_BRANCH","description":"Retrieves detailed information for a specified branch within a GitHub repository.","inputSchema":{"type":"object","properties":{"branch":{"type":"string","description":"The name of the branch. Cannot contain wildcard characters. To use wildcard characters in branch names, use [the GraphQL API](https://docs.github.com/graphql). \nExample: \"main\""},"owner":{"type":"string","description":"The account owner of the repository. The name is not case sensitive.\nExample: \"octocat\""},"repo":{"type":"string","description":"The name of the repository without the `.git` extension. The name is not case sensitive. \nExample: \"Hello-World\""}},"required":["branch","owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get a branch","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_GET_A_COMMIT","description":"Retrieves a specific commit from a repository by its owner, name, and a valid commit reference (SHA, branch, or tag), supporting pagination for large diffs.","inputSchema":{"type":"object","properties":{"owner":{"type":"string","description":"The username or organization name that owns the repository. This field is not case-sensitive.\nExamples:\n  \"octocat\"\n  \"github\""},"page":{"type":"integer","description":"Page number for paginating the commit's diff if it's too large. For more information, see \"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\"","default":1},"per_page":{"type":"integer","description":"Number of results per page when paginating the commit's diff (max 100). For more information, see \"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\"","default":30},"ref":{"type":"string","description":"The commit reference. Can be a commit SHA (e.g., '`sha`'), a branch name (e.g., 'heads/`BRANCH_NAME`' or simply '`BRANCH_NAME`'), or a tag name (e.g., 'tags/`TAG_NAME`'). For more information, see \"[Git References](https://git-scm.com/book/en/v2/Git-Internals-Git-References)\" in the Git documentation.\nExamples:\n  \"main\"\n  \"heads/develop\"\n  \"tags/v1.0.0\"\n  \"007a47250555ae82606ac2cb00f8f731976059a5\""},"repo":{"type":"string","description":"The name of the repository, without the `.git` extension. This field is not case-sensitive.\nExamples:\n  \"Spoon-Knife\"\n  \"linguist\""}},"required":["owner","ref","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get a commit","scopes":["repo","public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_GET_AN_ISSUE","description":"Action docstring","inputSchema":{"type":"object","properties":{"issue_number":{"type":"integer","description":"The identifying number of the issue.\nExample: 1347"},"owner":{"type":"string","description":"Username of the account owning the repository. Not case-sensitive.\nExample: \"octocat\""},"repo":{"type":"string","description":"Name of the repository (without `.git` extension). Not case-sensitive.\nExample: \"Hello-World\""}},"required":["issue_number","owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get an issue","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_GET_A_PULL_REQUEST","description":"Retrieves a specific pull request from a GitHub repository using its owner, repository name, and pull request number.","inputSchema":{"type":"object","properties":{"owner":{"type":"string","description":"The username of the account that owns the repository. This value is not case sensitive.\nExample: \"octocat\""},"pull_number":{"type":"integer","description":"The number that identifies the specific pull request.\nExample: 1347"},"repo":{"type":"string","description":"The name of the repository, without the .git extension. This value is not case sensitive.\nExample: \"Hello-World\""}},"required":["owner","pull_number","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get a pull request","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_GET_A_REPOSITORY","description":"Retrieves detailed information about an existing and accessible GitHub repository.","inputSchema":{"type":"object","properties":{"owner":{"type":"string","description":"The username of the account that owns the repository. This field is case-insensitive.\nExamples:\n  \"octocat\"\n  \"kubernetes\""},"repo":{"type":"string","description":"The name of the repository, without the `.git` extension. This field is case-insensitive.\nExamples:\n  \"Hello-World\"\n  \"kubernetes\""}},"required":["owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get a repository","scopes":["repo","public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_GET_A_WORKFLOW_RUN","description":"Gets a specific workflow run by its ID from a GitHub repository.","inputSchema":{"type":"object","properties":{"exclude_pull_requests":{"type":"boolean","description":"If true, excludes pull request data; the `pull_requests` array in the response will be empty.\nExamples:\n  \"true\"\n  \"false\"","default":false},"owner":{"type":"string","description":"The username or organization name that owns the repository (not case-sensitive).\nExamples:\n  \"octocat\"\n  \"my-organization\""},"repo":{"type":"string","description":"Name of the repository (case-insensitive, without .git extension).\nExamples:\n  \"Spoon-Knife\"\n  \"my-awesome-project\""},"run_id":{"type":"integer","description":"Unique ID of the workflow run.\nExamples:\n  \"123456789\"\n  \"987654321\""}},"required":["owner","repo","run_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get a workflow run","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_GET_RAW_REPOSITORY_CONTENT","description":"Tool to fetch raw file content from a GitHub repository. Use when you need the raw bytes of a file in the repo.","inputSchema":{"type":"object","properties":{"owner":{"type":"string","description":"The GitHub username or organization name that owns the repository. This is the account name shown in the repository URL (e.g., for github.com/torvalds/linux, the owner is 'torvalds'). Case-insensitive.\nExamples:\n  \"octocat\"\n  \"torvalds\"\n  \"facebook\""},"path":{"type":"string","description":"The file path within the repository, relative to the repository root. Use forward slashes for directory separators (e.g., 'src/utils/helper.js'). Do not include leading slash.\nExamples:\n  \"README.md\"\n  \"docs/index.html\"\n  \"src/main.py\""},"ref":{"type":["string","null"],"description":"The branch name, tag name, or commit SHA to fetch the file from. Defaults to the repository's default branch (usually 'main' or 'master').\nExamples:\n  \"main\"\n  \"master\"\n  \"v1.0.0\"\n  \"develop\"","default":null},"repo":{"type":"string","description":"The repository name (not the full URL). This is the repository name shown in the repository URL (e.g., for github.com/torvalds/linux, the repo is 'linux'). Do not include '.git' suffix. Case-insensitive.\nExamples:\n  \"Hello-World\"\n  \"linux\"\n  \"react\""}},"required":["owner","path","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Raw Repository Content","scopes":[],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_GET_REPOSITORY_CONTENT","description":"Retrieves a file's Base64 encoded content or lists a directory's contents from a GitHub repository.","inputSchema":{"type":"object","properties":{"owner":{"type":"string","description":"Required. The account owner of the repository. This name is not case sensitive.\nExample: \"octocat\""},"path":{"type":"string","description":"Required. The path to the content in the repository. This can be a file or a directory path. Use an empty string to retrieve the contents of the repository's root directory. IMPORTANT: Paths are case-sensitive and must match the exact casing in the repository (e.g., 'Docker' is different from 'docker'). If you receive a 404 'Not Found' error, verify the exact path by first listing the parent directory contents.\nExamples:\n  \"README.md\"\n  \"src/main.js\"\n  \"docs\"\n  \"\""},"ref":{"type":["string","null"],"description":"The name of the commit, branch, or tag. If not provided, the repository's default branch will be used.\nExamples:\n  \"main\"\n  \"v1.2.0\"\n  \"c8bca7c6a66f490c70b29cf3ac3d64070049ea73\"","default":null},"repo":{"type":"string","description":"Required. The name of the repository, without the `.git` extension. This name is not case sensitive.\nExample: \"Spoon-Knife\""}},"required":["owner","path","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get repository content","scopes":["repo","public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_GET_THE_AUTHENTICATED_USER","description":"Gets the profile information for the currently authenticated GitHub user, including potentially private details based on user settings.","inputSchema":{"type":"object","properties":{},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get the authenticated user","scopes":["user"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_LIST_ACCESSIBLE_REPOSITORIES","description":"Lists repositories accessible to the authenticated user through a specific GitHub App installation (identified by `installation_id`).","inputSchema":{"type":"object","properties":{"installation_id":{"type":"integer","description":"Unique identifier of the GitHub App installation.\nExamples:\n  \"1234567\"\n  \"8765432\""},"page":{"type":"integer","description":"Page number of results to fetch.\nExamples:\n  \"1\"\n  \"2\"\n  \"5\"","default":1},"per_page":{"type":"integer","description":"Number of results per page (max 100).\nExamples:\n  \"30\"\n  \"50\"\n  \"100\"","default":30}},"required":["installation_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List repositories accessible to the user access token","scopes":["repo","public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_LIST_BRANCHES","description":"Lists branches for an existing GitHub repository, with an option to filter by protection status.","inputSchema":{"type":"object","properties":{"owner":{"type":"string","description":"Account owner's username (case-insensitive).\nExamples:\n  \"octocat\"\n  \"torvalds\""},"page":{"type":"integer","description":"Page number for paginated results.","default":1},"per_page":{"type":"integer","description":"Number of results per page (max 100).","default":30},"protected":{"type":"boolean","description":"Filter by protection status: `true` for protected, `false` for unprotected; omit for all branches."},"repo":{"type":"string","description":"Repository name, excluding `.git` extension (case-insensitive).\nExamples:\n  \"Spoon-Knife\"\n  \"linux\""}},"required":["owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List branches","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_LIST_COMMITS","description":"Lists commits for a GitHub repository. Requires 'owner' (username/org) and 'repo' (repository name) parameters. Optionally filter by SHA/branch, path, author, committer, or date range.","inputSchema":{"type":"object","properties":{"author":{"type":["string","null"],"description":"Filter commits by the commit author's GitHub login or email address.\nExamples:\n  \"octocat\"\n  \"mona@github.com\"","default":null},"committer":{"type":["string","null"],"description":"Filter commits by the commit committer's GitHub login or email address. The committer is the user who applied the patch and may differ from the original author.\nExamples:\n  \"web-flow\"\n  \"octocat@github.com\"","default":null},"owner":{"type":"string","description":"The account owner of the repository (username or organization name only, not the full 'owner/repo' path). The name is not case sensitive.\nExamples:\n  \"octocat\"\n  \"my-organization\""},"page":{"type":"integer","description":"Page number of the results to fetch when using pagination.\nExamples:\n  \"1\"\n  \"2\"","default":1},"path":{"type":["string","null"],"description":"Only commits modifying this specific file path will be returned.\nExamples:\n  \"README.md\"\n  \"src/utils/helpers.py\"","default":null},"per_page":{"type":"integer","description":"Number of results to return per page (max 100).\nExamples:\n  \"30\"\n  \"100\"","default":1},"repo":{"type":"string","description":"The name of the repository without the `.git` extension (repository name only, not the full 'owner/repo' path). The name is not case sensitive.\nExamples:\n  \"Spoon-Knife\"\n  \"my-project\""},"sha":{"type":["string","null"],"description":"SHA hash or branch name to start listing commits from. If not provided, the GitHub API uses the repository's default branch (usually `main` or `master`).\nExamples:\n  \"main\"\n  \"develop\"\n  \"a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0\"","default":null},"since":{"type":["string","null"],"description":"Only commits created on or after this timestamp will be returned. This is a timestamp in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.\nExample: \"2023-01-01T00:00:00Z\"","default":null},"until":{"type":["string","null"],"description":"Only commits created before this timestamp will be returned. This is a timestamp in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.\nExample: \"2023-12-31T23:59:59Z\"","default":null}},"required":["owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List commits","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_LIST_ISSUE_COMMENTS","description":"Lists comments for a specified issue in a GitHub repository.","inputSchema":{"type":"object","properties":{"issue_number":{"type":"integer","description":"Number that identifies the issue.\nExamples:\n  \"42\"\n  \"101\""},"owner":{"type":"string","description":"Username of the account owning the repository (not case-sensitive).\nExamples:\n  \"octocat\"\n  \"github\""},"page":{"type":"integer","description":"Page number of the results to retrieve.\nExamples:\n  \"1\"\n  \"2\"\n  \"5\"","default":1},"per_page":{"type":"integer","description":"Number of comments to return per page (max 100).\nExamples:\n  \"30\"\n  \"50\"\n  \"100\"","default":30},"repo":{"type":"string","description":"Name of the repository, without the `.git` extension (not case-sensitive).\nExamples:\n  \"Spoon-Knife\"\n  \"docs\""},"since":{"type":"string","description":"Filters comments to include only those updated at or after this ISO 8601 timestamp (e.g., `YYYY-MM-DDTHH:MM:SSZ`).\nExample: \"2023-01-01T00:00:00Z\""}},"required":["issue_number","owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List issue comments","scopes":["repo","public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_LIST_LABELS_FOR_AN_ISSUE","description":"Lists all labels for a specified issue in a GitHub repository.","inputSchema":{"type":"object","properties":{"issue_number":{"type":"integer","description":"The unique number identifying the issue within the repository.\nExamples:\n  \"1347\"\n  \"42\""},"owner":{"type":"string","description":"The account owner of the repository (username or organization name). This is not case-sensitive.\nExamples:\n  \"octocat\"\n  \"kubernetes\""},"page":{"type":"integer","description":"The page number of the results to fetch. Defaults to 1. For more information, see \"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\"\nExamples:\n  \"1\"\n  \"5\"","default":1},"per_page":{"type":"integer","description":"The number of results to return per page. Maximum value is 100. Defaults to 30. For more information, see \"[Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\"\nExamples:\n  \"30\"\n  \"100\"","default":30},"repo":{"type":"string","description":"The name of the repository, without the `.git` extension. This is not case-sensitive.\nExamples:\n  \"Hello-World\"\n  \"minikube\""}},"required":["issue_number","owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List labels for an issue","scopes":["read:issues"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_LIST_NOTIFICATIONS_FOR_THE_AUTHENTICATED_USER","description":"Lists notifications for the authenticated user, sorted by most recent update, with filtering and pagination options.","inputSchema":{"type":"object","properties":{"all":{"type":"boolean","description":"If `true`, shows all notifications including those marked as read.","default":false},"before":{"type":"string","description":"Only show notifications updated before this ISO 8601 timestamp (e.g., `YYYY-MM-DDTHH:MM:SSZ`).\nExample: \"2023-12-31T23:59:59Z\""},"page":{"type":"integer","description":"Page number of results to fetch.\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"","default":1},"participating":{"type":"boolean","description":"If `true`, shows only notifications in which the authenticated user is directly participating or has been mentioned.","default":false},"per_page":{"type":"integer","description":"Number of results per page (max 50).\nExamples:\n  \"30\"\n  \"50\"","default":50},"since":{"type":"string","description":"Only show notifications updated after this ISO 8601 timestamp (e.g., `YYYY-MM-DDTHH:MM:SSZ`).\nExample: \"2023-01-01T00:00:00Z\""}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List notifications for the authenticated user","scopes":["notifications","repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_LIST_PULL_REQUESTS","description":"Lists pull requests for a GitHub repository. REQUIRES 'owner' AND 'repo' parameters - both are MANDATORY and must be provided in every call. Does NOT support filtering by assignee or date range - use GITHUB_FIND_PULL_REQUESTS instead for searching PRs by assignee, author, or across multiple repositories.","inputSchema":{"type":"object","properties":{"base":{"type":"string","description":"Filter by base branch name.\nExamples:\n  \"main\"\n  \"develop\"\n  \"gh-pages\""},"direction":{"type":"string","description":"Sort direction. Valid values: 'asc', 'desc'. Defaults to 'desc' if sort is 'created' or unspecified, else 'asc'.\nExamples:\n  \"asc\"\n  \"desc\""},"head":{"type":"string","description":"Filter by head user/org and branch name, e.g., `user:ref-name`.\nExamples:\n  \"octocat:test-branch\"\n  \"github:new-script-format\""},"owner":{"type":"string","description":"[REQUIRED - MUST BE PROVIDED] The GitHub username or organization name that owns the repository. This parameter is mandatory and cannot be omitted. Example: 'octocat' or 'microsoft'. To search PRs across all repos without specifying owner, use GITHUB_FIND_PULL_REQUESTS instead.\nExamples:\n  \"octocat\"\n  \"my-organization\"\n  \"microsoft\""},"page":{"type":"integer","description":"Page number for results.\nExamples:\n  \"1\"\n  \"2\"\n  \"5\"","default":1},"per_page":{"type":"integer","description":"Number of results per page (maximum 100).\nExamples:\n  \"30\"\n  \"50\"\n  \"100\"","default":30},"repo":{"type":"string","description":"[REQUIRED - MUST BE PROVIDED] The name of the repository (without the `.git` extension). This parameter is mandatory and cannot be omitted. Example: 'Spoon-Knife' or 'vscode'. To search PRs across multiple repos, use GITHUB_FIND_PULL_REQUESTS instead.\nExamples:\n  \"Spoon-Knife\"\n  \"my-project\"\n  \"vscode\""},"sort":{"type":"string","description":"Sorts results. Valid values: 'created', 'updated', 'popularity', 'long-running'. 'popularity' is by comment count; 'long-running' by age and recent activity.\nExamples:\n  \"created\"\n  \"updated\"\n  \"popularity\"\n  \"long-running\"","default":"created"},"state":{"type":"string","description":"Filter by pull request state. Valid values: 'open', 'closed', 'all'.\nExamples:\n  \"open\"\n  \"closed\"\n  \"all\"","default":"open"}},"required":["owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List pull requests","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_LIST_REPOSITORIES_FOR_THE_AUTHENTICATED_USER","description":"Lists repositories for the authenticated user; using 'type' with 'visibility' or 'affiliation' API parameters (not in this model) can cause a 422 error.","inputSchema":{"type":"object","properties":{"before":{"type":"string","description":"Filters for repositories updated before this specified time. Provide as an ISO 8601 formatted timestamp.\nExamples:\n  \"2024-01-01T00:00:00Z\"\n  \"2024-03-20T18:45:00+00:00\""},"direction":{"type":"string","enum":["asc","desc"],"description":"The direction of the sort. Defaults to `asc` when `sort` is 'full_name', and `desc` otherwise.\nExamples:\n  \"asc\"\n  \"desc\""},"page":{"type":"integer","description":"Page number of results to fetch.\nExamples:\n  \"1\"\n  \"2\"\n  \"10\"","default":1},"per_page":{"type":"integer","description":"The number of results to return per page (maximum 100).\nExamples:\n  \"30\"\n  \"50\"\n  \"100\"","default":30},"raw_response":{"type":"boolean","description":"Return full API response if true, optimized response for AI agents if false.\nExamples:\n  true\n  false","default":false},"since":{"type":"string","description":"Filters for repositories updated at or after this specified time. Provide as an ISO 8601 formatted timestamp.\nExamples:\n  \"2023-01-01T00:00:00Z\"\n  \"2023-05-15T10:30:00-07:00\""},"sort":{"type":"string","enum":["created","updated","pushed","full_name"],"description":"The repository property by which to sort the results.\nExamples:\n  \"created\"\n  \"full_name\"\n  \"updated\"","default":"full_name"},"type":{"type":"string","enum":["all","owner","public","private","member"],"description":"Filters the results to repositories of the specified type.\nExamples:\n  \"all\"\n  \"owner\"\n  \"member\"","default":"all"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List repositories for the authenticated user","scopes":["repo","public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_LIST_REPOSITORY_ISSUES","description":"Lists issues (including pull requests) from a GitHub repository. Requires BOTH 'owner' AND 'repo' parameters (e.g., owner='octocat', repo='Hello-World' for github.com/octocat/Hello-World).","inputSchema":{"type":"object","properties":{"assignee":{"type":"string","description":"Filter issues by assignee's username. Use 'none' for issues with no assignee, or '*' for issues assigned to any user.\nExamples:\n  \"codertocat\"\n  \"none\"\n  \"*\""},"creator":{"type":"string","description":"Filter issues by the username of the user who created the issue.\nExample: \"octocat\""},"direction":{"type":"string","enum":["asc","desc"],"description":"The direction of the sort.\nExamples:\n  \"asc\"\n  \"desc\"","default":"desc"},"labels":{"type":"string","description":"A comma-separated list of label names to filter issues by. Example: 'bug,ui,@high'.\nExamples:\n  \"bug,ui,@high\"\n  \"enhancement\"\n  \"help wanted,good first issue\""},"mentioned":{"type":"string","description":"Filter issues by a user mentioned in the issue's description or comments. Provide the username.\nExamples:\n  \"octodocs\"\n  \"hubot\""},"milestone":{"type":"string","description":"Filter issues by milestone. Provide the milestone `number` as a string, '*' for issues with any milestone, or 'none' for issues without a milestone.\nExamples:\n  \"1\"\n  \"*\"\n  \"none\""},"owner":{"type":"string","description":"REQUIRED. The GitHub account owner (user or organization) of the repository. For 'octocat/Hello-World', owner is 'octocat'. Not case-sensitive. Must be provided together with 'repo'.\nExamples:\n  \"octocat\"\n  \"microsoft\"\n  \"facebook\""},"page":{"type":"integer","description":"Page number for the set of results. Refer to GitHub's REST API documentation for pagination details.\nExamples:\n  \"1\"\n  \"5\"","default":1},"per_page":{"type":"integer","description":"Number of results per page (max 100). Refer to GitHub's REST API documentation for pagination details.\nExamples:\n  \"30\"\n  \"100\"","default":1},"repo":{"type":"string","description":"REQUIRED. The name of the repository (without .git extension). For 'octocat/Hello-World', repo is 'Hello-World'. Not case-sensitive. Must be provided together with 'owner'.\nExamples:\n  \"Hello-World\"\n  \"vscode\"\n  \"react\""},"since":{"type":"string","description":"Filters issues to include only those updated at or after the specified time. This should be a timestamp in ISO 8601 format (e.g., `YYYY-MM-DDTHH:MM:SSZ`).\nExamples:\n  \"2023-01-15T10:00:00Z\"\n  \"2024-03-10T00:00:00+05:30\""},"sort":{"type":"string","enum":["created","updated","comments"],"description":"The field to sort the results by.\nExamples:\n  \"created\"\n  \"updated\"\n  \"comments\"","default":"created"},"state":{"type":"string","enum":["open","closed","all"],"description":"Filters issues based on their state.\nExamples:\n  \"open\"\n  \"closed\"\n  \"all\"","default":"open"}},"required":["owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List repository issues","scopes":["repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_LIST_REVIEW_COMMENTS_ON_A_PULL_REQUEST","description":"Lists all review comments on a specific pull request within a GitHub repository.","inputSchema":{"type":"object","properties":{"direction":{"anyOf":[{"type":"string","enum":["asc","desc"],"description":"DirectionEnm"},{"type":"null"}],"description":"Sort direction (`asc` or `desc`); ignored if `sort` is not provided.\nExample: \"desc\"","default":null},"owner":{"type":"string","description":"Username of the account owning the repository. Not case sensitive.\nExample: \"octocat\""},"page":{"type":"integer","description":"Page number of results to retrieve.\nExample: 2","default":1},"per_page":{"type":"integer","description":"Number of comments per page (max 100).\nExample: 50","default":30},"pull_number":{"type":"integer","description":"Unique number identifying the pull request.\nExample: 1347"},"repo":{"type":"string","description":"Name of the repository, without the `.git` extension. Not case sensitive.\nExample: \"Hello-World\""},"since":{"type":["string","null"],"description":"Only include comments updated at or after this ISO 8601 timestamp (`YYYY-MM-DDTHH:MM:SSZ`).\nExample: \"2023-01-15T10:00:00Z\"","default":null},"sort":{"type":"string","enum":["created","updated"],"description":"Sort review comments by `created` or `updated`.\nExample: \"created\"","default":"created"}},"required":["owner","pull_number","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List review comments on a pull request","scopes":["pulls:read"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_LIST_WORKFLOW_RUNS_FOR_A_REPOSITORY","description":"Lists workflow runs for a repository, allowing filtering by actor, branch, event, status, creation date, check suite ID, or head SHA; the repository must exist and be accessible.","inputSchema":{"type":"object","properties":{"actor":{"type":"string","description":"Filter by the actor's login (e.g., the user who triggered the `push`).\nExample: \"octocat\""},"branch":{"type":"string","description":"Filter by branch name (e.g., `main` or the branch that triggered the `push`).\nExamples:\n  \"main\"\n  \"develop\""},"check_suite_id":{"type":"integer","description":"Filter by a specific `check_suite_id`.\nExample: \"123456789\""},"created":{"type":"string","description":"Filter by creation date or date-time range (ISO8601 format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SSZ). Supports operators like `>`, `<`, `>=`, `<=`, and `..` for ranges.\nExamples:\n  \"2023-01-15\"\n  \">=2023-01-01T10:00:00Z\"\n  \"2023-01-01..2023-01-31\""},"event":{"type":"string","description":"Filter by the event that triggered the workflow (e.g., `push`, `pull_request`).\nExamples:\n  \"push\"\n  \"pull_request\"\n  \"issue\""},"exclude_pull_requests":{"type":"boolean","description":"Exclude workflow runs triggered by pull request events if `true`.\nExamples:\n  \"true\"\n  \"false\"","default":false},"head_sha":{"type":"string","description":"Filter to include only runs associated with the specified `head_sha` (commit SHA at the head of the branch).\nExample: \"abcdef1234567890deadbeefabcdef1234567890\""},"owner":{"type":"string","description":"The account owner of the repository (not case-sensitive).\nExample: \"octocat\""},"page":{"type":"integer","description":"Page number of the results to fetch.\nExamples:\n  \"1\"\n  \"2\"","default":1},"per_page":{"type":"integer","description":"Number of results per page (maximum 100).\nExamples:\n  \"30\"\n  \"50\"\n  \"100\"","default":30},"repo":{"type":"string","description":"The name of the repository, without the `.git` extension (not case-sensitive).\nExample: \"Spoon-Knife\""},"status":{"type":"string","enum":["completed","action_required","cancelled","failure","neutral","skipped","stale","success","timed_out","in_progress","queued","requested","waiting","pending"],"description":"Filter by `status` or `conclusion` (e.g., `success`, `in_progress`). Note: Only GitHub Actions can set `waiting`, `pending`, or `requested`.\nExamples:\n  \"completed\"\n  \"in_progress\"\n  \"queued\""}},"required":["owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List workflow runs for a repository","scopes":["repo","workflow"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_MERGE_A_PULL_REQUEST","description":"Merges an open and mergeable pull request in a repository, optionally specifying merge commit details, a merge method, and a required head SHA for safety.","inputSchema":{"type":"object","properties":{"commit_message":{"type":"string","description":"Additional details for the merge commit message.\nExample: \"This change updates the project description to be more accurate.\""},"commit_title":{"type":"string","description":"Title for the merge commit message.\nExample: \"Fixing a typo in the README file\""},"merge_method":{"type":"string","enum":["merge","squash","rebase"],"description":"Merge strategy: 'merge', 'squash', or 'rebase'. Defaults to repository's setting if unspecified.\nExample: \"squash\""},"owner":{"type":"string","description":"Repository owner's username. Not case-sensitive.\nExample: \"octocat\""},"pull_number":{"type":"integer","description":"The unique number identifying the pull request.\nExample: 1347"},"repo":{"type":"string","description":"Repository name, without the `.git` extension. Not case-sensitive.\nExample: \"Hello-World\""},"sha":{"type":"string","description":"SHA of the pull request's head commit. Must match for merge to succeed, ensuring PR hasn't changed since review.\nExample: \"c5b97d5ae6c19d5c5df71a34c7fbeeda2479ccbc\""}},"required":["owner","pull_number","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Merge a pull request","scopes":["repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_SEARCH_CODE","description":"Searches code file contents and paths on the default branch of GitHub repositories using a query string; searches only files under 384KB, returns max 1000 results by best match, and is optimized for precision.","inputSchema":{"type":"object","properties":{"order":{"type":"string","enum":["desc","asc"],"description":"DEPRECATED. Order ('asc' or 'desc') for results; effective only if `sort` is specified. Docs: [ranking search results](https://docs.github.com/rest/search/search#ranking-search-results).\nExamples:\n  \"desc\"\n  \"asc\"","default":"desc"},"page":{"type":"integer","description":"Page number for results. For pagination details, see GitHub docs: [Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\nExamples:\n  \"1\"\n  \"2\"\n  \"10\"","default":1},"per_page":{"type":"integer","description":"Results per page (max 100). For pagination details, see GitHub docs: [Using pagination in the REST API](https://docs.github.com/rest/using-the-rest-api/using-pagination-in-the-rest-api).\nExamples:\n  \"30\"\n  \"50\"\n  \"100\"","default":30},"q":{"type":"string","description":"Code search query, including keywords and qualifiers (e.g., `language:python`, `user:octocat`, `repo:owner/repo`). For full syntax and qualifiers, see GitHub docs: [Constructing a search query](https://docs.github.com/rest/search/search#constructing-a-search-query) and [code search qualifiers](https://docs.github.com/search-github/searching-on-github/searching-code).\nExamples:\n  \"HelloWorld in:file language:python\"\n  \"user:octocat repo:hello-world extension:js\"\n  \"form path:/app/models language:ruby\""},"sort":{"anyOf":[{"type":"string","enum":["indexed","updated"],"description":"SortEnm"},{"type":"null"}],"description":"DEPRECATED. Valid: 'indexed' (sorts by last indexed time) or 'updated' (sorts by last updated time). If unspecified, results sorted by best match. Docs: [ranking search results](https://docs.github.com/rest/search/search#ranking-search-results).\nExamples:\n  \"indexed\"\n  \"updated\"","default":null}},"required":["q"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Search code","scopes":["public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_SEARCH_ISSUES_AND_PULL_REQUESTS","description":"Searches GitHub for issues and pull requests. Use qualifiers to scope searches: `repo:owner/name` for specific repos, `org:orgname` for organizations, `user:username` for personal repos, `assignee:@me` for your assignments. Combine with `is:issue`, `is:pr`, `state:open`, `label:\"name\"` filters.","inputSchema":{"type":"object","properties":{"order":{"type":"string","enum":["desc","asc"],"description":"Order for sorted results (ascending/descending). Effective only if `sort` is also provided.\nExamples:\n  \"desc\"\n  \"asc\"","default":"desc"},"page":{"type":"integer","description":"Page number for results (starts at 1). Refer to GitHub's REST API documentation on pagination for details.\nExamples:\n  \"1\"\n  \"2\"\n  \"5\"","default":1},"per_page":{"type":"integer","description":"Number of results per page (maximum 100). Refer to GitHub's REST API documentation on pagination for details.\nExamples:\n  \"30\"\n  \"50\"\n  \"100\"","default":30},"q":{"type":"string","description":"Search query using GitHub's search syntax. IMPORTANT: Queries must include at least one search keyword (e.g., 'bug', 'fix', 'error') in addition to any qualifiers. Qualifiers alone (repo:, is:, label:, state:, author:, etc.) are treated as filters, not search terms. Queries with only qualifiers and logical operators (AND/OR/NOT) will fail. Examples of valid queries: 'bug repo:owner/name is:issue' or 'fix is:pr state:open'. Invalid query: 'label:bug OR label:blocked repo:owner/name is:issue' (no search keyword).\nExamples:\n  \"bug repo:octocat/Spoon-Knife is:issue is:open label:\\\"help wanted\\\"\"\n  \"fix mentions:octocat is:pr state:merged\"\n  \"error is:issue state:open\""},"raw_response":{"type":"boolean","description":"Return full API response if true, optimized response for AI agents if false.\nExamples:\n  true\n  false","default":false},"sort":{"type":"string","enum":["comments","reactions","reactions-+1","reactions--1","reactions-smile","reactions-thinking_face","reactions-heart","reactions-tada","interactions","created","updated"],"description":"Field for sorting results. GitHub defaults to 'best match' if unspecified.\nExamples:\n  \"comments\"\n  \"created\"\n  \"updated\""}},"required":["q"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Search issues and pull requests","scopes":["repo","public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GITHUB_SEARCH_REPOSITORIES","description":"Searches GitHub repositories using a flexible query (keywords, qualifiers) with sorting, ordering, and pagination. IMPORTANT: The 'q' parameter (search query) is REQUIRED and must always be provided.","inputSchema":{"type":"object","properties":{"order":{"type":"string","enum":["desc","asc"],"description":"Determines the order of search results: `desc` for descending or `asc` for ascending. This parameter is only effective when `sort` is also specified. Defaults to `desc`.\nExamples:\n  \"desc\"\n  \"asc\"","default":"desc"},"page":{"type":"integer","description":"The page number for pagination of search results. Defaults to 1. Used in conjunction with `per_page` to fetch subsequent sets of results. See GitHub API documentation for more on pagination.\nExamples:\n  \"1\"\n  \"2\"\n  \"10\"","default":1},"per_page":{"type":"integer","description":"The number of repository results to return per page. The maximum value is 100. Defaults to 30. See GitHub API documentation for more on pagination.\nExamples:\n  \"30\"\n  \"50\"\n  \"100\"","default":30},"q":{"type":"string","description":"REQUIRED. The search query string for finding GitHub repositories. This parameter must always be provided. Combine keywords with qualifiers to filter results. Valid qualifiers include: `language:LANG` (e.g., `language:python`), `stars:N` or `stars:>N` (e.g., `stars:>1000`), `forks:N`, `size:N` (in KB), `topic:TOPIC`, `license:LICENSE`, `created:DATE`, `pushed:DATE`, `is:public` or `is:private`, `archived:true/false`, `in:name/description/readme`, `user:USERNAME` (must be an existing GitHub username, e.g., `user:octocat`), `org:ORGNAME` (for organization repositories). Note: The `user:` and `org:` qualifiers require actual valid GitHub usernames or organization names - placeholders like 'current_user' are not supported and will cause validation errors. To search your own repositories, use `user:YOUR_USERNAME` with your actual GitHub username, or use the List Repositories for Authenticated User endpoint instead. Qualifiers like `is:owner` are NOT valid for repository search.\nExamples:\n  \"tensorflow language:python stars:>1000\"\n  \"topic:react stars:>=10000\"\n  \"machine learning in:readme language:python\"\n  \"user:octocat\""},"sort":{"type":"string","enum":["stars","forks","help-wanted-issues","updated","created"],"description":"Specifies the field to sort the search results by. Options include `stars`, `forks`, `help-wanted-issues`, `updated` (recency of update), or `created` (creation date). If not provided, results are sorted by GitHub's default 'best match' ranking.\nExamples:\n  \"stars\"\n  \"forks\"\n  \"help-wanted-issues\"\n  \"updated\"\n  \"created\""}},"required":["q"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Search repositories","scopes":["public_repo"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GITHUB_UPDATE_AN_ISSUE","description":"Updates an existing GitHub issue's title, body, state, milestone, labels, or assignees; `state_reason` is only processed if `state` also changes, and use `null` or `[]` to clear applicable fields.","inputSchema":{"type":"object","properties":{"assignee":{"type":"string","description":"DEPRECATED: Username to assign; use `assignees`. Send `null` to unassign, omit to leave unchanged.\nExample: \"octocat\""},"assignees":{"type":"array","items":{"type":"string"},"description":"Replaces all existing assignees. Send `[]` to remove all; omit to leave unchanged. Requires push access for changes.\nExamples:\n  [\"octocat\",\"hubot\"]\n  [\"monalisa\"]\n  []"},"body":{"type":"string","description":"New issue body; send `null` to clear, omit to leave unchanged.\nExamples:\n  \"Updated details about the issue.\"\n  \"Steps to reproduce:\\n1. Do this\\n2. Do that\\nObserved behavior...\""},"issue_number":{"type":"integer","description":"Unique number identifying the issue.\nExamples:\n  \"1347\"\n  \"42\""},"labels":{"type":"array","items":{"type":"string"},"description":"Replaces all existing labels. Send `[]` to remove all; omit to leave unchanged. Requires push access for changes.\nExamples:\n  [\"bug\",\"documentation\"]\n  [\"enhancement\"]\n  []"},"milestone":{"type":"string","description":"Milestone ID (as string) or title. Send `null` to clear; omit to leave unchanged. Numeric ID recommended.\nExamples:\n  \"1\"\n  \"Q3 Sprint\"\n  \"42\""},"owner":{"type":"string","description":"Owner of the repository (case-insensitive).\nExamples:\n  \"octocat\"\n  \"my-organization\""},"repo":{"type":"string","description":"Repository name, without the `.git` extension (case-insensitive).\nExamples:\n  \"Spoon-Knife\"\n  \"my-awesome-project\""},"state":{"type":"string","enum":["open","closed"],"description":"New issue state; omit to leave unchanged."},"state_reason":{"type":"string","enum":["completed","not_planned","reopened"],"description":"Reason for state change, considered only if `state` also changes. Valid reasons depend on the new `state`."},"title":{"type":"string","description":"New issue title; send `null` to clear, omit to leave unchanged.\nExamples:\n  \"New title for issue\"\n  \"Bugfix: Solves critical problem X\""}},"required":["issue_number","owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update an issue","scopes":["repo","public_repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":true}},{"name":"GITHUB_UPDATE_A_PULL_REQUEST","description":"Updates an existing pull request, allowing changes to attributes like title, body, state, base branch, and maintainer modification settings.","inputSchema":{"type":"object","properties":{"base":{"type":["string","null"],"description":"The name of the branch to which you want your changes pulled. This must be an existing branch in the current repository. Cannot update the base branch to point to another repository. If None, the base branch remains unchanged.\nExample: \"main\"","default":null},"body":{"type":["string","null"],"description":"The new contents of the pull request. To remove the body, pass an empty string. If None, the body remains unchanged.\nExample: \"This PR updates the README.md to include details about the new /users endpoint.\"","default":null},"maintainer_can_modify":{"type":["boolean","null"],"description":"Indicates whether [maintainers can modify](https://docs.github.com/articles/allowing-changes-to-a-pull-request-branch-created-from-a-fork/) the pull request. If None, this setting remains unchanged.\nExamples:\n  true\n  false","default":null},"owner":{"type":"string","description":"The account owner of the repository. This name is not case-sensitive.\nExample: \"octocat\""},"pull_number":{"type":"integer","description":"The unique number that identifies the pull request within the repository.\nExample: \"1347\""},"repo":{"type":"string","description":"The name of the repository, without the `.git` extension. This name is not case-sensitive.\nExample: \"Hello-World\""},"state":{"anyOf":[{"type":"string","enum":["open","closed"],"description":"StateEnm"},{"type":"null"}],"description":"The new state of the pull request. Can be 'open' or 'closed'. If None, the state remains unchanged.\nExamples:\n  \"open\"\n  \"closed\"","default":null},"title":{"type":["string","null"],"description":"The new title for the pull request. If None, the title remains unchanged.\nExample: \"Update documentation for new API endpoint\"","default":null}},"required":["owner","pull_number","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update a pull request","scopes":["repo","public_repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":true}},{"name":"GITHUB_UPDATE_A_REPOSITORY","description":"Updates settings for an existing GitHub repository, such as name, description, visibility, merge strategies, and security configurations.","inputSchema":{"type":"object","properties":{"allow_auto_merge":{"type":"boolean","description":"Enables auto-merge for pull requests.","default":false},"allow_forking":{"type":["boolean","null"],"description":"Allows private forks of this repository. IMPORTANT: This setting can ONLY be changed for organization-owned repositories. Attempting to set this for user-owned repositories will result in a 422 error. Omit this field if you don't want to change the forking setting.","default":null},"allow_merge_commit":{"type":"boolean","description":"Allows merging pull requests via merge commits.","default":true},"allow_rebase_merge":{"type":"boolean","description":"Allows rebase-merging pull requests.","default":true},"allow_squash_merge":{"type":"boolean","description":"Allows squash-merging pull requests.","default":true},"allow_update_branch":{"type":"boolean","description":"Allows updating a pull request's head branch from the base branch if not strictly required for merging.","default":false},"archived":{"type":"boolean","description":"Archives the repository (making it read-only) or unarchives it.","default":false},"default_branch":{"type":"string","description":"Name of the default branch.\nExamples:\n  \"main\"\n  \"master\"\n  \"develop\""},"delete_branch_on_merge":{"type":"boolean","description":"Automatically deletes head branches after merging pull requests.","default":false},"description":{"type":"string","description":"Brief summary of the repository.\nExamples:\n  \"My updated project description.\"\n  \"A library for advanced data processing.\""},"has_issues":{"type":"boolean","description":"Enables GitHub Issues for this repository.","default":true},"has_projects":{"type":"boolean","description":"Enables GitHub Projects. Note: Organization settings might override this and cause an error if projects are disabled organization-wide.","default":true},"has_wiki":{"type":"boolean","description":"Enables the GitHub Wiki.","default":true},"homepage":{"type":"string","description":"URL of the project's homepage.\nExamples:\n  \"https://example.com/my-project\"\n  \"https://docs.my-library.dev\""},"is_template":{"type":"boolean","description":"Designates this repository as a template repository.","default":false},"merge_commit_message":{"type":"string","enum":["PR_BODY","PR_TITLE","BLANK"],"description":"Default message for merge commits: 'PR_BODY', 'PR_TITLE', or 'BLANK'. CONSTRAINT: If merge_commit_title is 'PR_TITLE', this must be 'PR_BODY' or 'BLANK'. Cannot be set when merge_commit_title is 'MERGE_MESSAGE'.\nExamples:\n  \"PR_BODY\"\n  \"PR_TITLE\"\n  \"BLANK\""},"merge_commit_title":{"type":"string","enum":["PR_TITLE","MERGE_MESSAGE"],"description":"Default title for merge commits: 'PR_TITLE' or 'MERGE_MESSAGE'. CONSTRAINT: If set to 'PR_TITLE', merge_commit_message must be 'PR_BODY' or 'BLANK'. If set to 'MERGE_MESSAGE', merge_commit_message must be blank/unset.\nExamples:\n  \"PR_TITLE\"\n  \"MERGE_MESSAGE\""},"name":{"type":"string","description":"New name for the repository (not case-sensitive).\nExamples:\n  \"new-repo-name\"\n  \"updated-project-x\""},"owner":{"type":"string","description":"Username or organization name of the repository owner (not case-sensitive).\nExamples:\n  \"octocat\"\n  \"my-organization\""},"private":{"type":"boolean","description":"Whether the repository is private. Note: Changing visibility might be restricted by organization policies, potentially causing a 422 error.","default":false},"repo":{"type":"string","description":"Name of the repository, without the `.git` extension (not case-sensitive).\nExamples:\n  \"Hello-World\"\n  \"my-awesome-project\""},"security__and__analysis__advanced__security__status":{"type":"string","description":"Manages GitHub Advanced Security. Set to 'enabled' or 'disabled'.\nExamples:\n  \"enabled\"\n  \"disabled\""},"security__and__analysis__secret__scanning__push__protection__status":{"type":"string","description":"Manages secret scanning push protection. Set to 'enabled' or 'disabled'.\nExamples:\n  \"enabled\"\n  \"disabled\""},"security__and__analysis__secret__scanning__status":{"type":"string","description":"Manages secret scanning. Set to 'enabled' or 'disabled'.\nExamples:\n  \"enabled\"\n  \"disabled\""},"squash_merge_commit_message":{"type":"string","enum":["PR_BODY","COMMIT_MESSAGES","BLANK"],"description":"Default message for squash merge commits: 'PR_BODY', 'COMMIT_MESSAGES', or 'BLANK'.\nExamples:\n  \"PR_BODY\"\n  \"COMMIT_MESSAGES\"\n  \"BLANK\""},"squash_merge_commit_title":{"type":"string","enum":["PR_TITLE","COMMIT_OR_PR_TITLE"],"description":"Default title for squash merge commits: 'PR_TITLE' or 'COMMIT_OR_PR_TITLE'.\nExamples:\n  \"PR_TITLE\"\n  \"COMMIT_OR_PR_TITLE\""},"use_squash_pr_title_as_default":{"type":"boolean","description":"DEPRECATED: Use `squash_merge_commit_title`. If true, squash merge commits use PR title; otherwise, commit message.","default":false},"visibility":{"type":"string","enum":["public","private"],"description":"Repository visibility.\nExamples:\n  \"public\"\n  \"private\""},"web_commit_signoff_required":{"type":"boolean","description":"Requires contributors to sign off on web-based commits.","default":false}},"required":["owner","repo"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update a repository","scopes":["repo"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":true}},{"name":"GMAIL_ADD_LABEL_TO_EMAIL","description":"Adds and/or removes specified Gmail labels for a message; ensure `message_id` and all `label_ids` are valid (use 'listLabels' for custom label IDs).","inputSchema":{"type":"object","properties":{"add_label_ids":{"type":"array","items":{"type":"string"},"description":"IMPORTANT: Label IDs are NOT the same as label names shown in Gmail UI. SYSTEM LABELS (use these exact IDs): INBOX, SPAM, TRASH, UNREAD, STARRED, IMPORTANT, CATEGORY_PERSONAL, CATEGORY_SOCIAL, CATEGORY_PROMOTIONS, CATEGORY_UPDATES, CATEGORY_FORUMS. Note: 'UPDATES', 'SOCIAL', 'PROMOTIONS', 'FORUMS', 'PERSONAL' are INVALID - you must use the full CATEGORY_ prefix (e.g., 'CATEGORY_UPDATES' not 'UPDATES'). CUSTOM LABELS: You MUST call 'listLabels' action first to get the label ID (format: 'Label_<number>', e.g., 'Label_1', 'Label_123'). Do NOT use the label name displayed in Gmail UI - the API requires the ID, not the name. Example: if listLabels returns {\"id\": \"Label_5\", \"name\": \"Work Projects\"}, use 'Label_5' (NOT 'Work Projects'). IMMUTABLE LABELS: SENT and DRAFT cannot be modified. A label cannot appear in both add_label_ids and remove_label_ids. At least one of 'add_label_ids' or 'remove_label_ids' must be non-empty.\nExamples:\n  \"STARRED\"\n  \"IMPORTANT\"\n  \"CATEGORY_UPDATES\"\n  \"Label_1\"","default":[]},"message_id":{"type":"string","description":"Immutable ID of the message to modify. Gmail message IDs are 15-16 character hexadecimal strings (e.g., '19b5c35f1c9eb3b6'). IMPORTANT: Do NOT use UUIDs (32-character strings like '093ca4662b214d5eba8f4ceeaad63433'), thread IDs, or internal system IDs - these will cause 'Invalid id value' errors. Obtain valid message IDs from: (1) 'GMAIL_FETCH_EMAILS' response 'messageId' field, (2) 'GMAIL_FETCH_MESSAGE_BY_THREAD_ID' response, or (3) 'GMAIL_LIST_THREADS' and then fetching thread messages.\nExamples:\n  \"19b5c35f1c9eb3b6\"\n  \"19b5c31f73477483\""},"remove_label_ids":{"type":"array","items":{"type":"string"},"description":"IMPORTANT: Label IDs are NOT the same as label names shown in Gmail UI. SYSTEM LABELS (use these exact IDs): INBOX, SPAM, TRASH, UNREAD, STARRED, IMPORTANT, CATEGORY_PERSONAL, CATEGORY_SOCIAL, CATEGORY_PROMOTIONS, CATEGORY_UPDATES, CATEGORY_FORUMS. Note: 'UPDATES', 'SOCIAL', 'PROMOTIONS', 'FORUMS', 'PERSONAL' are INVALID - you must use the full CATEGORY_ prefix (e.g., 'CATEGORY_UPDATES' not 'UPDATES'). CUSTOM LABELS: You MUST call 'listLabels' action first to get the label ID (format: 'Label_<number>', e.g., 'Label_1', 'Label_123'). Do NOT use the label name displayed in Gmail UI - the API requires the ID, not the name. IMMUTABLE LABELS: SENT and DRAFT cannot be modified. Common operations: to mark as read, REMOVE 'UNREAD'; to archive, REMOVE 'INBOX'. A label cannot appear in both add_label_ids and remove_label_ids. At least one of 'add_label_ids' or 'remove_label_ids' must be non-empty.\nExamples:\n  \"UNREAD\"\n  \"INBOX\"\n  \"CATEGORY_UPDATES\"\n  \"Label_1\"","default":[]},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["message_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Modify email labels","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GMAIL_BATCH_DELETE_MESSAGES","description":"Tool to permanently delete multiple Gmail messages in bulk. Use when you need to efficiently remove large numbers of emails (e.g., retention enforcement, mailbox hygiene).","inputSchema":{"type":"object","properties":{"messageIds":{"type":"array","items":{"type":"string"},"minItems":1,"description":"List of Gmail message IDs to delete. Each ID must be a 15-16 character hexadecimal string (e.g., '18c5f5d1a2b3c4d5'). Obtain IDs from actions like GMAIL_FETCH_EMAILS or GMAIL_LIST_THREADS - do not use human-readable descriptions.\nExample: [\"18c5f5d1a2b3c4d5\",\"18c5f5d1a2b3c4d6\"]"},"userId":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["messageIds"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Batch delete Gmail messages","scopes":["https://mail.google.com/"],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_BATCH_MODIFY_MESSAGES","description":"Modify labels on multiple Gmail messages in one efficient API call. Supports up to 1,000 messages per request for bulk operations like archiving, marking as read/unread, or applying custom labels.","inputSchema":{"type":"object","properties":{"addLabelIds":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"List of label IDs to add to the messages. Common label IDs: INBOX, STARRED, IMPORTANT, SENT, DRAFT, SPAM, TRASH, UNREAD. Use GMAIL_LIST_LABELS to get custom label IDs. At least one of add_label_ids or remove_label_ids must be provided.\nExamples:\n  [\"INBOX\",\"STARRED\"]\n  [\"Label_123\",\"Label_456\"]\n  [\"IMPORTANT\"]","default":null},"messageIds":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":1000,"description":"List of message IDs to modify. Maximum 1,000 message IDs per request. Get message IDs from GMAIL_FETCH_EMAILS or GMAIL_LIST_THREADS actions. Accepts 'messageIds', 'ids', or 'message_ids' as the parameter name.\nExamples:\n  [\"18c5f5d1a2b3c4d5\",\"18c5f5d1a2b3c4d6\"]\n  [\"msg_id_1\",\"msg_id_2\",\"msg_id_3\"]"},"removeLabelIds":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"List of label IDs to remove from the messages. Common use cases: Remove 'UNREAD' to mark as read, remove 'INBOX' to archive, remove 'SPAM' to unmark spam. IMPORTANT: 'DRAFT' cannot be removed via this action - it represents a special message state, not a removable label. To delete drafts, use GMAIL_DELETE_DRAFT instead. At least one of add_label_ids or remove_label_ids must be provided.\nExamples:\n  [\"UNREAD\"]\n  [\"INBOX\",\"UNREAD\"]\n  [\"SPAM\"]","default":null},"userId":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["messageIds"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Batch modify Gmail messages","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify"],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_CREATE_EMAIL_DRAFT","description":"Creates a Gmail email draft. All recipients (recipient_email, cc, bcc) are optional - drafts can be created without recipients and edited later before sending. At least one of subject or body must be provided. Supports To/Cc/Bcc, subject, plain/HTML body (ensure `is_html=True` for HTML), attachments, and threading. When creating a draft reply to an existing thread (thread_id provided), leave subject empty to stay in the same thread; setting a subject will create a NEW thread instead.","inputSchema":{"type":"object","properties":{"attachment":{"anyOf":[{"type":"object","properties":{"mimetype":{"type":"string","description":"The MIME type of the file\nExamples:\n  \"application/pdf\"\n  \"image/jpeg\"\n  \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\""},"name":{"type":"string","description":"The filename that will be used when uploading the file to the destination service\nExamples:\n  \"document.pdf\"\n  \"image.jpg\"\n  \"report.docx\""},"s3key":{"type":"string","description":"The S3 key of a publicly accessible file, typically returned from a previous download action that stored the file in S3. This key references an existing file that can be uploaded to another service.\nExample: \"47563/gmail/GET_ATTACHMENT/response/12345\""}},"required":["mimetype","name","s3key"],"additionalProperties":false,"description":"FileUploadable"},{"type":"null"}],"description":"File to attach to the email.","default":null},"bcc":{"type":"array","items":{"type":"string"},"description":"Blind Carbon Copy (BCC) recipients' email addresses. Each must be a valid email address (e.g., 'user@example.com') or display name format (e.g., 'Bob Jones <user@example.com>'). Plain names without email addresses are NOT valid. Optional for drafts (recipients can be added later before sending).\nExample: [\"bcc.recipient@example.com\",\"BCC User <bcc.user@example.com>\"]","default":[]},"body":{"type":["string","null"],"description":"Email body content (plain text or HTML); `is_html` must be True if HTML. Either subject or body must be provided. Can also be provided as 'message_body'.\nExamples:\n  \"Hello Team,\\n\\nPlease find the attached report for your review.\\n\\nBest regards,\\nYour Name\"\n  \"<h1>Meeting Confirmation</h1><p>This email confirms our meeting scheduled for next Tuesday.</p>\"","default":null},"cc":{"type":"array","items":{"type":"string"},"description":"Carbon Copy (CC) recipients' email addresses. Each must be a valid email address (e.g., 'user@example.com') or display name format (e.g., 'John Doe <user@example.com>'). Plain names without email addresses are NOT valid. Optional for drafts (recipients can be added later before sending).\nExample: [\"cc.recipient1@example.com\",\"CC User <cc.recipient2@example.com>\"]","default":[]},"extra_recipients":{"type":"array","items":{"type":"string"},"description":"Additional 'To' recipients' email addresses (not Cc or Bcc). Each must be a valid email address (e.g., 'user@example.com'), display name format (e.g., 'Jane Doe <user@example.com>'), or 'me' for the authenticated user. Plain names without email addresses are NOT valid. Should only be used if recipient_email is also provided.\nExample: [\"jane.doe@example.com\",\"Jane Doe <jane.doe@example.com>\"]","default":[]},"is_html":{"type":"boolean","description":"Set to True if `body` is already formatted HTML. When False, plain text newlines are auto-converted to <br/> tags. Both modes result in HTML email; this flag controls whether the body content is treated as raw HTML or plain text that gets HTML formatting applied.\nExamples:\n  true\n  false","default":false},"recipient_email":{"type":["string","null"],"description":"Primary recipient's email address. Must be a valid email address (e.g., 'user@example.com') or display name format (e.g., 'John Doe <user@example.com>'). A plain name without an email address (e.g., 'John Doe') is NOT valid - the '@' symbol and domain are required. Optional for drafts (recipients can be added later before sending). Use extra_recipients if you want to send to multiple recipients.\nExamples:\n  \"john.doe@example.com\"\n  \"John Doe <john.doe@example.com>\"","default":null},"subject":{"type":["string","null"],"description":"Email subject line. Either subject or body must be provided. When creating a draft reply to an existing thread (thread_id provided), leave this empty to stay in the same thread. Setting a subject will create a NEW thread instead.\nExamples:\n  \"Project Update Q3\"\n  \"Meeting Reminder\"","default":null},"thread_id":{"type":["string","null"],"description":"ID of an existing Gmail thread to reply to; omit for new thread.\nExample: \"17f45ec49a9c3f1b\"","default":null},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create email draft","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.send","https://www.googleapis.com/auth/gmail.compose"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_CREATE_LABEL","description":"Creates a new label with a unique name in the specified user's Gmail account.","inputSchema":{"type":"object","properties":{"background_color":{"anyOf":[{"type":"string","enum":["#000000","#434343","#666666","#999999","#cccccc","#efefef","#f3f3f3","#ffffff","#fb4c2f","#ffad47","#fad165","#16a766","#43d692","#4a86e8","#a479e2","#f691b3","#f6c5be","#ffe6c7","#fef1d1","#b9e4d0","#c6f3de","#c9daf8","#e4d7f5","#fcdee8","#efa093","#ffd6a2","#fce8b3","#89d3b2","#a0eac9","#a4c2f4","#d0bcf1","#fbc8d9","#e66550","#ffbc6b","#fcda83","#44b984","#68dfa9","#6d9eeb","#b694e8","#f7a7c0","#cc3a21","#eaa041","#f2c960","#149e60","#3dc789","#3c78d8","#8e63ce","#e07798","#ac2b16","#cf8933","#d5ae49","#0b804b","#2a9c68","#285bac","#653e9b","#b65775","#464646","#e7e7e7","#0d3472","#b6cff5","#0d3b44","#98d7e4","#3d188e","#e3d7ff","#711a36","#fbd3e0","#8a1c0a","#f2b2a8","#7a2e0b","#ffc8af","#7a4706","#ffdeb5","#594c05","#fbe983","#684e07","#fdedc1","#0b4f30","#b3efd3","#04502e","#a2dcc1","#c2c2c2","#4986e7","#2da2bb","#b99aff","#994a64","#f691b2","#ff7537","#ffad46","#662e37","#cca6ac","#094228","#42d692","#076239","#16a765","#1a764d","#1c4587","#41236d","#822111","#83334c","#a46a21","#aa8831","#ebdbde"],"description":"GmailLabelColor"},{"type":"null"}],"description":"Background color for the label. Gmail only accepts colors from a predefined palette of 102 specific hex values. Common color names like 'YELLOW', 'RED', 'BLUE', 'GREEN', 'ORANGE', 'PURPLE', 'PINK' are automatically mapped to the closest Gmail palette color. Provide either a common color name, a Gmail palette color name (e.g., 'ROYAL_BLUE', 'CARIBBEAN_GREEN'), or exact hex value (e.g., '#4a86e8', '#43d692'). If only background_color is provided without text_color, a complementary text color (white or black) will be auto-selected for optimal contrast. Full palette: https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.labels#Color\nExamples:\n  \"YELLOW\"\n  \"RED\"\n  \"BLUE\"\n  \"GREEN\"\n  \"ROYAL_BLUE\"\n  \"CARIBBEAN_GREEN\"\n  \"#4a86e8\"\n  \"#43d692\"","default":null},"label_list_visibility":{"type":"string","enum":["labelShow","labelShowIfUnread","labelHide"],"description":"Controls how the label is displayed in the label list in the Gmail sidebar. Valid values: 'labelShow' (always show), 'labelShowIfUnread' (show only if unread messages), 'labelHide' (hide from list).\nExamples:\n  \"labelShow\"\n  \"labelShowIfUnread\"\n  \"labelHide\"","default":"labelShow"},"label_name":{"type":"string","description":"REQUIRED. The name for the new label. Must be unique within the account, non-blank, maximum length 225 characters, cannot contain commas (','), not only whitespace, and must not be a reserved system label (e.g., INBOX, SENT, DRAFT, SPAM, TRASH, ALL_MAIL, CATEGORY_*). Forward slashes ('/') are allowed and used to create hierarchical nested labels (e.g., 'Work/Projects', 'Personal/Finance'). Periods ('.') are allowed and commonly used for numbering schemes (e.g., '1. Action Items', '2. Projects'). Note: 'name' is also accepted as an alias for this field.\nExamples:\n  \"Work\"\n  \"Important Documents\"\n  \"Receipts 2024\"\n  \"Work/Projects\"\n  \"Personal/Finance\"\n  \"1. Action Items\""},"message_list_visibility":{"type":"string","enum":["show","hide"],"description":"Controls how messages with this label are displayed in the message list. Valid values: 'show' or 'hide'. Note: These values are different from label_list_visibility - do NOT use 'labelShow' or 'labelHide' here.\nExamples:\n  \"show\"\n  \"hide\"","default":"show"},"text_color":{"anyOf":[{"type":"string","enum":["#000000","#434343","#666666","#999999","#cccccc","#efefef","#f3f3f3","#ffffff","#fb4c2f","#ffad47","#fad165","#16a766","#43d692","#4a86e8","#a479e2","#f691b3","#f6c5be","#ffe6c7","#fef1d1","#b9e4d0","#c6f3de","#c9daf8","#e4d7f5","#fcdee8","#efa093","#ffd6a2","#fce8b3","#89d3b2","#a0eac9","#a4c2f4","#d0bcf1","#fbc8d9","#e66550","#ffbc6b","#fcda83","#44b984","#68dfa9","#6d9eeb","#b694e8","#f7a7c0","#cc3a21","#eaa041","#f2c960","#149e60","#3dc789","#3c78d8","#8e63ce","#e07798","#ac2b16","#cf8933","#d5ae49","#0b804b","#2a9c68","#285bac","#653e9b","#b65775","#464646","#e7e7e7","#0d3472","#b6cff5","#0d3b44","#98d7e4","#3d188e","#e3d7ff","#711a36","#fbd3e0","#8a1c0a","#f2b2a8","#7a2e0b","#ffc8af","#7a4706","#ffdeb5","#594c05","#fbe983","#684e07","#fdedc1","#0b4f30","#b3efd3","#04502e","#a2dcc1","#c2c2c2","#4986e7","#2da2bb","#b99aff","#994a64","#f691b2","#ff7537","#ffad46","#662e37","#cca6ac","#094228","#42d692","#076239","#16a765","#1a764d","#1c4587","#41236d","#822111","#83334c","#a46a21","#aa8831","#ebdbde"],"description":"GmailLabelColor"},{"type":"null"}],"description":"Text color for the label. Gmail only accepts colors from a predefined palette of 102 specific hex values. Common color names like 'YELLOW', 'RED', 'BLUE', 'GREEN', 'ORANGE', 'PURPLE', 'PINK' are automatically mapped to the closest Gmail palette color. Provide either a common color name, a Gmail palette color name (e.g., 'BLACK', 'ROYAL_BLUE'), or exact hex value (e.g., '#000000', '#4a86e8'). If only text_color is provided without background_color, a complementary background color (white or black) will be auto-selected for optimal contrast. Full palette: https://developers.google.com/workspace/gmail/api/reference/rest/v1/users.labels#Color\nExamples:\n  \"BLACK\"\n  \"WHITE\"\n  \"YELLOW\"\n  \"RED\"\n  \"BLUE\"\n  \"GREEN\"\n  \"#000000\"\n  \"#ffffff\"\n  \"ROYAL_BLUE\"","default":null},"user_id":{"type":"string","description":"The email address of the user in whose account the label will be created.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["label_name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create label","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_DELETE_DRAFT","description":"Permanently deletes a specific Gmail draft using its ID; ensure the draft exists and the user has necessary permissions for the given `user_id`.","inputSchema":{"type":"object","properties":{"draft_id":{"type":"string","description":"Immutable ID of the draft to delete. Must be obtained from GMAIL_LIST_DRAFTS or GMAIL_CREATE_EMAIL_DRAFT actions. Draft IDs typically have an 'r' prefix (e.g., 'r-1234567890' or 'r1234567890').\nExamples:\n  \"r-8388446164079304564\"\n  \"r1234567890123456789\""},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user; 'me' is recommended.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["draft_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete Draft","scopes":["https://mail.google.com/"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"GMAIL_DELETE_LABEL","description":"Permanently DELETES a user-created Gmail label from the account (not from a message). WARNING: This action DELETES the label definition itself, removing it from all messages. System labels (INBOX, SENT, UNREAD, etc.) cannot be deleted. To add/remove labels from specific messages, use GMAIL_ADD_LABEL_TO_EMAIL action instead.","inputSchema":{"type":"object","properties":{"label_id":{"type":"string","description":"ID of the user-created label to be permanently DELETED from the account. Must be a custom label ID (format: 'Label_123'). System labels (INBOX, SENT, DRAFT, UNREAD, STARRED, IMPORTANT, SPAM, TRASH, CATEGORY_*) cannot be deleted. WARNING: This action permanently DELETES the label definition from your account - it does NOT remove a label from a message. To add/remove labels from messages, use GMAIL_ADD_LABEL_TO_EMAIL instead.\nExamples:\n  \"Label_123\"\n  \"Label_xyz789\""},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["label_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete label from account (permanent)","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_DELETE_MESSAGE","description":"Permanently deletes a specific email message by its ID from a Gmail mailbox; for `user_id`, use 'me' for the authenticated user or an email address to which the authenticated user has delegated access.","inputSchema":{"type":"object","properties":{"message_id":{"type":"string","description":"Identifier of the email message to delete.\nExamples:\n  \"185120e4428ba8cf\"\n  \"17a872b77b9e7a3b\""},"user_id":{"type":"string","description":"User's email address. The special value 'me' refers to the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["message_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete message","scopes":["https://mail.google.com/"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_FETCH_EMAILS","description":"Fetches a list of email messages from a Gmail account, supporting filtering, pagination, and optional full content retrieval.","inputSchema":{"type":"object","properties":{"ids_only":{"type":"boolean","description":"If true, only returns message IDs from the list API without fetching individual message details. Fastest option for getting just message IDs and thread IDs.\nExamples:\n  true\n  false","default":false},"include_payload":{"type":"boolean","description":"Set to true to include full message payload (headers, body, attachments); false for metadata only.\nExamples:\n  true\n  false","default":true},"include_spam_trash":{"type":"boolean","description":"Set to true to include messages from 'SPAM' and 'TRASH'.\nExamples:\n  true\n  false","default":false},"label_ids":{"type":"array","items":{"type":"string"},"description":"Filter by label IDs; only messages with all specified labels are returned. System label IDs (can be used directly): 'INBOX', 'SPAM', 'TRASH', 'UNREAD', 'STARRED', 'IMPORTANT', 'CATEGORY_PRIMARY' (alias 'CATEGORY_PERSONAL'), 'CATEGORY_SOCIAL', 'CATEGORY_PROMOTIONS', 'CATEGORY_UPDATES', 'CATEGORY_FORUMS'. IMPORTANT: For custom/user-created labels, you MUST use the label ID (e.g., 'Label_123456'), NOT the label name shown in Gmail UI. For example, if you have a label named 'BlocksToDo' in Gmail, you cannot pass 'BlocksToDo' - you must first call the 'listLabels' action to find the corresponding ID (something like 'Label_7890') and use that ID here. Passing a label name instead of ID for custom labels will result in an 'Invalid label' error.\nExamples:\n  \"INBOX\"\n  \"UNREAD\"\n  \"Label_123456\""},"max_results":{"type":"integer","minimum":1,"maximum":500,"description":"Maximum number of messages to retrieve per page.\nExamples:\n  \"10\"\n  \"100\"\n  \"500\"","default":1},"page_token":{"type":["string","null"],"description":"Token for retrieving a specific page, obtained from a previous response's `nextPageToken`. Must be a valid opaque token string from a previous API response. Do not pass arbitrary values. Omit for the first page.","default":null},"query":{"type":["string","null"],"description":"Gmail advanced search query (e.g., 'from:user subject:meeting'). Supports operators like 'from:', 'to:', 'subject:', 'label:', 'has:attachment', 'is:unread', 'after:YYYY/MM/DD', 'before:YYYY/MM/DD', AND/OR/NOT. Use quotes for exact phrases. Omit for no query filter.\nExamples:\n  \"from:john@example.com is:unread\"\n  \"subject:meeting has:attachment\"\n  \"after:2024/01/01 before:2024/02/01\"\n  \"is:important OR is:starred\"\n  \"label:work -label:spam\"","default":null},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"},"verbose":{"type":"boolean","description":"If false, uses optimized concurrent metadata fetching for faster performance (~75% improvement). If true, uses standard detailed message fetching. When false, only essential fields (subject, sender, recipient, time, labels) are guaranteed.\nExamples:\n  true\n  false","default":true}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Fetch emails","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.modify"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_FETCH_MESSAGE_BY_MESSAGE_ID","description":"Fetches a specific email message by its ID, provided the `message_id` exists and is accessible to the authenticated `user_id`.","inputSchema":{"type":"object","properties":{"format":{"type":"string","description":"Format for message content: 'minimal' (ID/labels), 'full' (complete data), 'raw' (base64url string), 'metadata' (ID/labels/headers).\nExamples:\n  \"minimal\"\n  \"full\"\n  \"raw\"\n  \"metadata\"","default":"full"},"message_id":{"type":"string","minLength":1,"description":"The Gmail API message ID (hexadecimal string, typically 15-16 characters like '19b11732c1b578fd'). Must be obtained from Gmail API responses (e.g., List Messages, Search Messages). Do NOT use email subjects, dates, sender names, or custom identifiers.\nExamples:\n  \"19b11732c1b578fd\"\n  \"18c5e5b5f5d5e5b5\"\n  \"1736ccf5d7b4d452\""},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"user@example.com\"\n  \"me\"","default":"me"}},"required":["message_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Fetch message by message ID","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_FETCH_MESSAGE_BY_THREAD_ID","description":"Retrieves messages from a Gmail thread using its `thread_id`, where the thread must be accessible by the specified `user_id`.","inputSchema":{"type":"object","properties":{"page_token":{"type":"string","description":"Opaque page token for fetching a specific page of messages if results are paginated.\nExample: \"CiAKGhIKJdealEffectivelyPageToken\"","default":""},"thread_id":{"type":"string","description":"Unique ID of the thread, obtainable from actions like 'listThreads' or 'fetchEmails'. Must not be empty. If prefixed with 'msg-f:', 'thread-f:', or similar, the prefix will be automatically stripped.\nExamples:\n  \"1849143210774856419\"\n  \"msg-f:1849143210774856419\""},"user_id":{"type":"string","description":"The email address of the user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["thread_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Fetch Message by Thread ID","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_FORWARD_MESSAGE","description":"Forward an existing Gmail message to specified recipients, preserving original body and attachments.","inputSchema":{"type":"object","properties":{"additional_text":{"type":["string","null"],"description":"Optional additional text to include before the forwarded content.\nExample: \"Please see the forwarded message below.\"","default":null},"message_id":{"type":"string","description":"ID of the message to forward. Obtain this from actions like 'List Messages' or 'Fetch Emails'.\nExample: \"17f45ec49a9c3f1b\""},"recipient_email":{"type":"string","description":"Email address to forward the message to.\nExample: \"john.doe@example.com\""},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["message_id","recipient_email"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Forward email message","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.compose","https://www.googleapis.com/auth/gmail.send","https://www.googleapis.com/auth/gmail.modify"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_GET_ATTACHMENT","description":"Retrieves a specific attachment by ID from a message in a user's Gmail mailbox, requiring valid message and attachment IDs.","inputSchema":{"type":"object","properties":{"attachment_id":{"type":"string","minLength":1,"description":"The internal Gmail attachment ID (NOT the filename). This is a system-generated token string like 'ANGjdJ8s...'. Obtain this ID from the 'attachmentId' field in the 'attachmentList' array returned by fetchEmails or fetchMessageByMessageId actions. Do NOT pass the filename (e.g., 'report.pdf').\nExamples:\n  \"ANGjdJ8sZ7example1234\"\n  \"A_PART0.1_18exampleAttachmentId7f9\""},"file_name":{"type":"string","minLength":1,"description":"Desired filename for the downloaded attachment. This is a required string field - do not pass null.\nExamples:\n  \"invoice.pdf\"\n  \"report.docx\""},"message_id":{"type":"string","minLength":1,"description":"Immutable ID of the message containing the attachment. This is a required string field - do not pass null. Obtain the message_id from Gmail API responses (e.g., fetchEmails, listThreads).\nExample: \"18exampleMessageId7f9\""},"user_id":{"type":"string","description":"User's email address ('me' for authenticated user).\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["attachment_id","file_name","message_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Gmail attachment","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_GET_AUTO_FORWARDING","description":"Tool to get the auto-forwarding setting for the specified account. Use when you need to retrieve the current auto-forwarding configuration including enabled status, forwarding email address, and message disposition.","inputSchema":{"type":"object","properties":{"user_id":{"type":"string","description":"The user's email address. The special value 'me' can be used to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Auto-Forwarding Settings","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_GET_CONTACTS","description":"Fetches contacts (connections) for the authenticated Google account, allowing selection of specific data fields and pagination.","inputSchema":{"type":"object","properties":{"include_other_contacts":{"type":"boolean","description":"Include 'Other Contacts' (interacted with but not explicitly saved) in addition to regular contacts; if true, fetches from both endpoints and merges results.","default":true},"page_token":{"type":"string","description":"Token to retrieve a specific page of results, obtained from 'nextPageToken' in a previous response."},"person_fields":{"type":"string","description":"Comma-separated person fields to retrieve for each contact (e.g., 'names,emailAddresses').\nExamples:\n  \"addresses\"\n  \"ageRanges\"\n  \"biographies\"\n  \"birthdays\"\n  \"coverPhotos\"\n  \"emailAddresses\"\n  \"events\"\n  \"genders\"\n  \"imClients\"\n  \"interests\"\n  \"locales\"\n  \"memberships\"\n  \"metadata\"\n  \"names\"\n  \"nicknames\"\n  \"occupations\"\n  \"organizations\"\n  \"phoneNumbers\"\n  \"photos\"\n  \"relations\"\n  \"residences\"\n  \"sipAddresses\"\n  \"skills\"\n  \"urls\"\n  \"userDefined\"","default":"emailAddresses,names,birthdays,genders"},"resource_name":{"type":"string","description":"Identifier for the person resource whose connections are listed; use 'people/me' for the authenticated user.","default":"people/me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get contacts","scopes":["https://www.googleapis.com/auth/contacts","https://www.googleapis.com/auth/contacts.readonly","https://www.googleapis.com/auth/contacts.other.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_GET_LANGUAGE_SETTINGS","description":"Tool to retrieve the language settings for a Gmail user. Use when you need to determine the display language preference for the authenticated user or a specific Gmail account.","inputSchema":{"type":"object","properties":{"user_id":{"type":"string","description":"The email address of the Gmail user whose language settings are to be retrieved, or the special value 'me' to indicate the currently authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Language Settings","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_GET_PEOPLE","description":"Retrieves either a specific person's details (using `resource_name`) or lists 'Other Contacts' (if `other_contacts` is true), with `person_fields` specifying the data to return.","inputSchema":{"type":"object","properties":{"other_contacts":{"type":"boolean","description":"If true, retrieves 'Other Contacts' (people interacted with but not explicitly saved), ignoring `resource_name` and enabling pagination/sync. If false, retrieves information for the single person specified by `resource_name`.","default":false},"page_size":{"type":"integer","minimum":1,"maximum":1000,"description":"The number of 'Other Contacts' to return per page. Applicable only when `other_contacts` is true.","default":10},"page_token":{"type":"string","description":"An opaque token from a previous response to retrieve the next page of 'Other Contacts' results. Applicable only when `other_contacts` is true and paginating.","default":""},"person_fields":{"type":"string","description":"A comma-separated field mask to restrict which fields on the person (or persons) are returned. Consult the Google People API documentation for a comprehensive list of valid fields.\nExamples:\n  \"names,emailAddresses\"\n  \"emailAddresses,names,birthdays,genders\"\n  \"addresses,phoneNumbers,metadata\"","default":"emailAddresses,names,birthdays,genders"},"resource_name":{"type":"string","description":"Resource name identifying the person for whom to retrieve information (like the authenticated user or a specific contact). Used only when `other_contacts` is false.\nExamples:\n  \"people/me\"\n  \"people/c12345678901234567890\"\n  \"people/102345678901234567890\"","default":"people/me"},"sync_token":{"type":"string","description":"A token from a previous 'Other Contacts' list call to retrieve only changes since the last sync; leave empty for an initial full sync. Applicable only when `other_contacts` is true.","default":""}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get People","scopes":["https://www.googleapis.com/auth/contacts.other.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_GET_PROFILE","description":"Retrieves key Gmail profile information (email address, message/thread totals, history ID) for a user.","inputSchema":{"type":"object","properties":{"user_id":{"type":"string","description":"The email address of the Gmail user whose profile is to be retrieved, or the special value 'me' to indicate the currently authenticated user.\nExamples:\n  \"user@example.com\"\n  \"me\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Profile","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.metadata"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_GET_VACATION_SETTINGS","description":"Tool to retrieve vacation responder settings for a Gmail user. Use when you need to check if out-of-office auto-replies are configured and view their content.","inputSchema":{"type":"object","properties":{"user_id":{"type":"string","description":"The email address of the Gmail user whose vacation settings are to be retrieved, or the special value 'me' to indicate the currently authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Vacation Settings","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly","https://mail.google.com/"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_LIST_CSE_IDENTITIES","description":"Tool to list client-side encrypted identities for an authenticated user. Use when you need to retrieve CSE identity configurations including key pair associations.","inputSchema":{"type":"object","properties":{"page_size":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}],"description":"The number of identities to return. If not provided, the page size will default to 20 entries.\nExamples:\n  20\n  50","default":null},"page_token":{"type":["string","null"],"description":"Pagination token indicating which page of identities to return.\nExample: \"ABCDEF123456\"","default":null},"user_id":{"type":"string","description":"The requester's primary email address. Use 'me' to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List CSE identities","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.settings.sharing"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_LIST_CSE_KEYPAIRS","description":"Tool to list client-side encryption key pairs for an authenticated user. Use when you need to retrieve CSE keypair configurations including public keys and enablement states. Supports pagination for large result sets.","inputSchema":{"type":"object","properties":{"page_size":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}],"description":"The number of key pairs to return per page. If not provided, the page size will default to 20 entries.\nExamples:\n  20\n  50","default":null},"page_token":{"type":["string","null"],"description":"Pagination token indicating which page of key pairs to return. Omit to return the first page.\nExample: \"ABCDEF123456\"","default":null},"user_id":{"type":"string","description":"The requester's primary email address. Use 'me' to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List CSE key pairs","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.settings.sharing"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_LIST_DRAFTS","description":"Retrieves a paginated list of email drafts from a user's Gmail account. Use verbose=true to get full draft details including subject, body, sender, and timestamp.","inputSchema":{"type":"object","properties":{"max_results":{"type":"integer","minimum":1,"maximum":500,"description":"Maximum number of drafts to return per page.\nExamples:\n  10\n  100\n  500","default":1},"page_token":{"type":"string","description":"Token from a previous response to retrieve a specific page of drafts.\nExample: \"CiaKJDhWSE5UURE9PSIsImMiOiJhYmMxMjMifQ==\"","default":""},"user_id":{"type":"string","description":"User's mailbox ID; use 'me' for the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"},"verbose":{"type":"boolean","description":"If true, fetches full draft details including subject, sender, recipient, body, and timestamp. If false, returns only draft IDs (faster).\nExamples:\n  true\n  false","default":false}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List drafts","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_LIST_HISTORY","description":"Tool to list Gmail mailbox change history since a known startHistoryId. Use when performing incremental mailbox syncs to fetch only new changes.","inputSchema":{"type":"object","properties":{"history_types":{"anyOf":[{"type":"array","items":{"type":"string","enum":["messageAdded","messageDeleted","labelAdded","labelRemoved"]}},{"type":"null"}],"description":"Filter by specific history types. Allowed values: messageAdded, messageDeleted, labelAdded, labelRemoved.\nExample: [\"messageAdded\",\"labelRemoved\"]","default":null},"label_id":{"type":["string","null"],"description":"Only return history records involving messages with this label ID.\nExample: \"INBOX\"","default":null},"max_results":{"type":"integer","minimum":1,"maximum":500,"description":"Maximum number of history records to return. Default is 100; max is 500.\nExamples:\n  100\n  500","default":100},"page_token":{"type":["string","null"],"description":"Token to retrieve a specific page of results.\nExample: \"ABCDEF123456\"","default":null},"start_history_id":{"type":"string","description":"Required. Returns history records after this ID. If the ID is invalid or too old, the API returns 404. Perform a full sync in that case. Should be a numeric string.\nExample: \"1234567890\""},"user_id":{"type":"string","description":"The user's email address. Use 'me' to specify the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["start_history_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List Gmail history","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_LIST_LABELS","description":"Retrieves a list of all system and user-created labels for the specified Gmail account.","inputSchema":{"type":"object","properties":{"user_id":{"type":"string","description":"Identifies the Gmail account (owner's email or 'me' for authenticated user) for which labels will be listed.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List Gmail labels","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.labels"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_LIST_SEND_AS","description":"Lists the send-as aliases for a Gmail account, including the primary address and custom 'from' aliases. Use when you need to retrieve available sending addresses for composing emails.","inputSchema":{"type":"object","properties":{"user_id":{"type":"string","description":"The user's email address or the special value 'me' to indicate the authenticated user whose send-as aliases will be retrieved.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List send-as aliases","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_LIST_SMIME_INFO","description":"Lists S/MIME configs for the specified send-as alias. Use when you need to retrieve all S/MIME certificate configurations associated with a specific send-as email address.","inputSchema":{"type":"object","properties":{"send_as_email":{"type":"string","description":"The email address that appears in the 'From:' header for mail sent using this alias.\nExamples:\n  \"alias@example.com\"\n  \"noreply@example.com\""},"user_id":{"type":"string","description":"The user's email address. The special value 'me' can be used to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["send_as_email"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List S/MIME configs","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.settings.sharing"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_LIST_THREADS","description":"Retrieves a list of email threads from a Gmail account, identified by `user_id` (email address or 'me'), supporting filtering and pagination.","inputSchema":{"type":"object","properties":{"max_results":{"type":"integer","minimum":1,"maximum":500,"description":"Maximum number of threads to return.\nExamples:\n  \"10\"\n  \"50\"\n  \"100\"","default":10},"page_token":{"type":"string","description":"Token from a previous response to retrieve a specific page of results; omit for the first page.\nExample: \"abcPageToken123\"","default":""},"query":{"type":"string","description":"Filter for threads, using Gmail search query syntax (e.g., 'from:user@example.com is:unread').\nExamples:\n  \"is:unread\"\n  \"from:john.doe@example.com\"\n  \"subject:important\"","default":""},"user_id":{"type":"string","description":"The user's email address or 'me' to specify the authenticated Gmail account.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"},"verbose":{"type":"boolean","description":"If false, returns threads with basic fields (id, snippet, historyId). If true, returns threads with complete message details including headers, body, attachments, and metadata for each message in the thread.\nExamples:\n  true\n  false","default":false}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List threads","scopes":["https://mail.google.com/"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_MODIFY_THREAD_LABELS","description":"Adds or removes specified existing label IDs from a Gmail thread, affecting all its messages; ensure the thread ID is valid.","inputSchema":{"type":"object","properties":{"add_label_ids":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"List of label IDs to add to the thread; these labels must exist. Accepts either a list or a JSON-encoded string that will be parsed. Note: If a label appears in both add_label_ids and remove_label_ids, the add operation takes priority.\nExamples:\n  \"STARRED\"\n  \"INBOX\"","default":null},"remove_label_ids":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}],"description":"List of label IDs to remove from the thread; these labels must exist. Accepts either a list or a JSON-encoded string that will be parsed. Note: Labels that appear in both add_label_ids and remove_label_ids will be automatically removed from this list (add takes priority).\nExamples:\n  \"IMPORTANT\"\n  \"CATEGORY_UPDATES\"","default":null},"thread_id":{"type":"string","description":"Immutable ID of the thread to modify.\nExample: \"18ea7715b619f09c\""},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"user@example.com\"\n  \"me\"","default":"me"}},"required":["thread_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Modify thread labels","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GMAIL_MOVE_TO_TRASH","description":"Moves an existing, non-deleted email message to the trash for the specified user.","inputSchema":{"type":"object","properties":{"message_id":{"type":"string","description":"Required. The unique identifier of the email message to move to trash. This is a hexadecimal string that can be obtained from listing or fetching emails.\nExample: \"1875f42779f726f2\""},"user_id":{"type":"string","description":"User's email address or 'me' for the authenticated user.\nExamples:\n  \"user@example.com\"\n  \"me\"","default":"me"}},"required":["message_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Move to Trash","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_PATCH_LABEL","description":"Patches the specified label.","inputSchema":{"type":"object","properties":{"color":{"anyOf":[{"type":"object","properties":{"backgroundColor":{"type":["string","null"],"description":"The background color of the label, represented as a hex string. Must be one of Gmail's predefined colors from the color palette. See: https://developers.google.com/workspace/gmail/api/guides/labels#color_palette\nExamples:\n  \"#ffffff\"\n  \"#f3f3f3\"\n  \"#efefef\"\n  \"#cccccc\"","default":null},"textColor":{"type":["string","null"],"description":"The text color of the label, represented as a hex string. Must be one of Gmail's predefined colors from the color palette. See: https://developers.google.com/workspace/gmail/api/guides/labels#color_palette\nExamples:\n  \"#000000\"\n  \"#434343\"\n  \"#666666\"\n  \"#ffffff\"","default":null}},"additionalProperties":false,"description":"PatchLabelColor"},{"type":"null"}],"description":"The color to assign to the label. Color is only available for labels that have their `type` set to `user`. At least one of 'name', 'messageListVisibility', 'labelListVisibility', or 'color' must be provided.","default":null},"id":{"type":"string","description":"The ID of the label to update.\nExample: \"LABEL_123\""},"labelListVisibility":{"type":["string","null"],"description":"The visibility of the label in the label list in the Gmail web interface. Allowed values: 'labelShow', 'labelShowIfUnread', 'labelHide'. At least one of 'name', 'messageListVisibility', 'labelListVisibility', or 'color' must be provided.\nExamples:\n  \"labelShow\"\n  \"labelShowIfUnread\"\n  \"labelHide\"","default":null},"messageListVisibility":{"type":["string","null"],"description":"The visibility of messages with this label in the message list in the Gmail web interface. Allowed values: 'show', 'hide'. At least one of 'name', 'messageListVisibility', 'labelListVisibility', or 'color' must be provided.\nExamples:\n  \"show\"\n  \"hide\"","default":null},"name":{"type":["string","null"],"description":"The display name of the label. At least one of 'name', 'messageListVisibility', 'labelListVisibility', or 'color' must be provided.\nExample: \"My Updated Label\"","default":null},"userId":{"type":"string","description":"The user's email address. The special value `me` can be used to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\""}},"required":["id","userId"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Patch Label","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GMAIL_REPLY_TO_THREAD","description":"Sends a reply within a specific Gmail thread using the original thread's subject, requiring a valid `thread_id` and at least one of recipient_email, cc, or bcc must be provided. Supports attachments via the `attachment` parameter with valid `s3key`, `mimetype`, and `name`.","inputSchema":{"type":"object","properties":{"attachment":{"anyOf":[{"type":"object","properties":{"mimetype":{"type":"string","description":"The MIME type of the file\nExamples:\n  \"application/pdf\"\n  \"image/jpeg\"\n  \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\""},"name":{"type":"string","description":"The filename that will be used when uploading the file to the destination service\nExamples:\n  \"document.pdf\"\n  \"image.jpg\"\n  \"report.docx\""},"s3key":{"type":"string","description":"The S3 key of a publicly accessible file, typically returned from a previous download action that stored the file in S3. This key references an existing file that can be uploaded to another service.\nExample: \"47563/gmail/GET_ATTACHMENT/response/12345\""}},"required":["mimetype","name","s3key"],"additionalProperties":false,"description":"FileUploadable"},{"type":"null"}],"description":"File to attach to the reply. Just Provide file path here","default":null},"bcc":{"type":"array","items":{"type":"string"},"description":"Blind Carbon Copy (BCC) recipients' email addresses in format 'user@domain.com'. Each address must include both username and domain separated by '@'. At least one of cc, bcc, or recipient_email must be provided.\nExample: [\"bcc.recipient@example.com\"]","default":[]},"cc":{"type":"array","items":{"type":"string"},"description":"Carbon Copy (CC) recipients' email addresses in format 'user@domain.com'. Each address must include both username and domain separated by '@'. At least one of cc, bcc, or recipient_email must be provided.\nExample: [\"cc.recipient1@example.com\",\"cc.recipient2@example.com\"]","default":[]},"extra_recipients":{"type":"array","items":{"type":"string"},"description":"Additional 'To' recipients' email addresses in format 'user@domain.com' (not Cc or Bcc). Each address must include both username and domain separated by '@'. Should only be used if recipient_email is also provided.\nExample: [\"jane.doe@example.com\",\"another.person@example.com\"]","default":[]},"is_html":{"type":"boolean","description":"Indicates if `message_body` is HTML; if True, body must be valid HTML, if False, body should not contain HTML tags.\nExamples:\n  true\n  false","default":false},"message_body":{"type":"string","description":"Content of the reply message, either plain text or HTML.\nExample: \"Dear Sir, Nice talking to you. Yours respectfully, John\"","default":""},"recipient_email":{"type":["string","null"],"description":"Primary recipient's email address in format 'user@domain.com'. Must include both username and domain separated by '@'. Required if cc and bcc is not provided, else can be optional. Use extra_recipients if you want to send to multiple recipients.\nExample: \"john@doe.com\"","default":null},"thread_id":{"type":"string","description":"Identifier of the Gmail thread for the reply. Must be a valid hexadecimal string, typically 15-16 characters long (e.g., '169eefc8138e68ca').\nExample: \"169eefc8138e68ca\""},"user_id":{"type":"string","description":"Identifier for the user sending the reply; 'me' refers to the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["thread_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Reply to email thread","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.compose","https://www.googleapis.com/auth/gmail.send"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_SEARCH_PEOPLE","description":"Searches contacts by matching the query against names, nicknames, emails, phone numbers, and organizations, optionally including 'Other Contacts'.","inputSchema":{"type":"object","properties":{"other_contacts":{"type":"boolean","description":"When True, searches both saved contacts and 'Other Contacts' (people you've interacted with but not explicitly saved). Note: This restricts person_fields to only 'emailAddresses', 'metadata', 'names', 'phoneNumbers'. When False, searches only saved contacts but allows all person_fields including 'organizations', 'addresses', etc.","default":true},"pageSize":{"type":"integer","minimum":0,"maximum":30,"description":"Maximum results to return; values >30 are capped to 30 by the API.","default":10},"person_fields":{"type":"string","description":"Comma-separated fields to return (e.g., 'names,emailAddresses'). When 'other_contacts' is true, only 'emailAddresses', 'metadata', 'names', 'phoneNumbers' are allowed. For full field access including 'organizations', set 'other_contacts' to false.\nExamples:\n  \"addresses\"\n  \"ageRanges\"\n  \"biographies\"\n  \"birthdays\"\n  \"coverPhotos\"\n  \"emailAddresses\"\n  \"events\"\n  \"genders\"\n  \"imClients\"\n  \"interests\"\n  \"locales\"\n  \"memberships\"\n  \"metadata\"\n  \"names\"\n  \"nicknames\"\n  \"occupations\"\n  \"organizations\"\n  \"phoneNumbers\"\n  \"photos\"\n  \"relations\"\n  \"residences\"\n  \"sipAddresses\"\n  \"skills\"\n  \"urls\"\n  \"userDefined\"","default":"emailAddresses,metadata,names,phoneNumbers"},"query":{"type":"string","description":"Matches contact names, nicknames, email addresses, phone numbers, and organization fields."}},"required":["query"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Search People","scopes":["https://www.googleapis.com/auth/contacts","https://www.googleapis.com/auth/contacts.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_SEND_DRAFT","description":"Sends the specified, existing draft to the recipients in the To, Cc, and Bcc headers.","inputSchema":{"type":"object","properties":{"draft_id":{"type":"string","description":"The ID of the draft to send. Draft IDs are typically alphanumeric strings (e.g., 'r99885592323229922'). Important: Do not confuse draft_id with message_id - they are different identifiers. Use GMAIL_LIST_DRAFTS to retrieve valid draft IDs, or GMAIL_CREATE_EMAIL_DRAFT to create a new draft and get its ID.\nExample: \"r99885592323229922\""},"user_id":{"type":"string","description":"The user's email address. The special value `me` can be used to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["draft_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Send Draft","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_SEND_EMAIL","description":"Sends an email via Gmail API using the authenticated user's Google profile display name. At least one of 'to' (or 'recipient_email'), 'cc', or 'bcc' must be provided. At least one of subject or body must be provided. Requires `is_html=True` if the body contains HTML. For attachments, you must provide a FileUploadable object with valid `s3key` (obtained from a previous file download action like GMAIL_GET_ATTACHMENT), `mimetype` (e.g., 'image/png', 'application/pdf'), and `name` (filename). All common file types including PNG, JPG, PDF, MP4, etc. are supported. Gmail API limits total message size to ~25 MB after base64 encoding.","inputSchema":{"type":"object","properties":{"attachment":{"type":"object","properties":{"mimetype":{"type":"string","description":"The MIME type of the file\nExamples:\n  \"application/pdf\"\n  \"image/jpeg\"\n  \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\""},"name":{"type":"string","description":"The filename that will be used when uploading the file to the destination service\nExamples:\n  \"document.pdf\"\n  \"image.jpg\"\n  \"report.docx\""},"s3key":{"type":"string","description":"The S3 key of a publicly accessible file, typically returned from a previous download action that stored the file in S3. This key references an existing file that can be uploaded to another service.\nExample: \"47563/gmail/GET_ATTACHMENT/response/12345\""}},"required":["mimetype","name","s3key"],"additionalProperties":false,"description":"File to attach. FileUploadable object where 'name' is the attachment filename, 's3key' is the S3 key from a previously uploaded/downloaded file, and 'mimetype' is the file's MIME type (e.g., 'image/png', 'application/pdf'). Gmail API limits: total message size (including attachments after base64 encoding) must not exceed ~25 MB. For reference, a 5 MB file becomes ~6.7 MB when base64 encoded. Omit or set to null for no attachment."},"bcc":{"type":"array","items":{"type":"string"},"description":"Blind Carbon Copy (BCC) recipients' email addresses. At least one of 'to'/'recipient_email', 'cc', or 'bcc' must be provided.\nExample: [\"auditor@example.com\"]","default":[]},"body":{"type":["string","null"],"description":"Email content (plain text or HTML). Either subject or body must be provided for the email to be sent. If HTML, `is_html` must be `True`.\nExamples:\n  \"Hello team, let's discuss the project updates tomorrow.\"\n  \"<h1>Welcome!</h1><p>Thank you for signing up.</p>\"\n  \"\"","default":null},"cc":{"type":"array","items":{"type":"string"},"description":"Carbon Copy (CC) recipients' email addresses. At least one of 'to'/'recipient_email', 'cc', or 'bcc' must be provided.\nExample: [\"manager@example.com\",\"teamlead@example.com\"]","default":[]},"extra_recipients":{"type":"array","items":{"type":"string"},"description":"Additional 'To' recipients' email addresses (not Cc or Bcc). Should only be used if recipient_email is also provided.\nExample: [\"jane.doe@example.com\",\"support@example.com\"]","default":[]},"is_html":{"type":"boolean","description":"Set to `True` if the email body contains HTML tags.","default":false},"recipient_email":{"type":["string","null"],"description":"Primary recipient's email address. You can also use 'to' as an alias for this parameter. At least one of 'to'/'recipient_email', 'cc', or 'bcc' must be provided. Use extra_recipients if you want to send to multiple recipients. Use the special value 'me' to send to your own authenticated email address.\nExamples:\n  \"john@doe.com\"\n  \"me\"","default":null},"subject":{"type":["string","null"],"description":"Subject line of the email. Either subject or body must be provided for the email to be sent.\nExamples:\n  \"Project Update Meeting\"\n  \"Your Weekly Newsletter\"","default":null},"user_id":{"type":"string","description":"User's email address; the literal 'me' refers to the authenticated user.\nExamples:\n  \"user@example.com\"\n  \"me\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Send Email","scopes":["https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.compose","https://www.googleapis.com/auth/gmail.send"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_SETTINGS_GET_IMAP","description":"Retrieves the IMAP settings for a Gmail user account, including whether IMAP is enabled, auto-expunge behavior, expunge behavior, and maximum folder size.","inputSchema":{"type":"object","properties":{"user_id":{"type":"string","description":"The user's email address or the special value 'me' to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get IMAP Settings","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_SETTINGS_GET_POP","description":"Tool to retrieve POP settings for a Gmail account. Use when you need to check the current POP configuration including access window and message disposition.","inputSchema":{"type":"object","properties":{"user_id":{"type":"string","description":"The user's email address. The special value 'me' can be used to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get POP settings","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GMAIL_SETTINGS_SEND_AS_GET","description":"Tool to retrieve a specific send-as alias configuration for a Gmail user. Use when you need to get details about a send-as email address including display name, signature, SMTP settings, and verification status. Fails with HTTP 404 if the specified address is not a member of the send-as collection.","inputSchema":{"type":"object","properties":{"send_as_email":{"type":"string","description":"The send-as alias email address to retrieve. This is the email address that appears in the 'From:' header.\nExamples:\n  \"alias@example.com\"\n  \"pranai@usefulagents.com\""},"user_id":{"type":"string","description":"The email address of the Gmail user whose send-as alias to retrieve, or the special value 'me' to indicate the authenticated user.\nExamples:\n  \"me\"\n  \"user@example.com\"","default":"me"}},"required":["send_as_email"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get send-as alias","scopes":["https://www.googleapis.com/auth/gmail.settings.basic","https://mail.google.com/","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GOOGLECALENDAR_ACL_DELETE","description":"Deletes an access control rule from a Google Calendar. Use when you need to remove sharing permissions for a user, group, or domain.","inputSchema":{"type":"object","properties":{"calendar_id":{"type":"string","description":"Calendar identifier. To retrieve calendar IDs call the calendarList.list method. If you want to access the primary calendar of the currently logged in user, use the \"primary\" keyword.\nExamples:\n  \"primary\"\n  \"user@example.com\""},"rule_id":{"type":"string","description":"ACL rule identifier.\nExamples:\n  \"user:test@example.com\"\n  \"group:team@example.com\"\n  \"default\""}},"required":["calendar_id","rule_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete ACL Rule","scopes":["https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/calendar.acls"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"GOOGLECALENDAR_ACL_GET","description":"Retrieves a specific access control rule for a calendar. Use when you need to check permissions for a specific user, group, or domain.","inputSchema":{"type":"object","properties":{"calendar_id":{"type":"string","description":"Calendar identifier. To retrieve calendar IDs call the calendarList.list method. If you want to access the primary calendar of the currently logged in user, use the \"primary\" keyword.\nExample: \"primary\""},"rule_id":{"type":"string","description":"ACL rule identifier in the format 'scope_type:scope_value'. Valid scope types are: 'user' (email address), 'group' (group email), 'domain' (domain name). Examples: 'user:john@example.com', 'group:team@example.com', 'domain:example.com'. Note: 'me' is NOT a valid keyword for rule_id (unlike 'primary' for calendar_id). You must use an actual email address or domain. The rule must already exist on the calendar - use GOOGLECALENDAR_LIST_ACL_RULES to find valid rule IDs.\nExamples:\n  \"user:email@domain.com\"\n  \"group:group@domain.com\"\n  \"domain:example.com\""}},"required":["calendar_id","rule_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get ACL Rule","scopes":["https://www.googleapis.com/auth/calendar.readonly","https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/calendar.acls","https://www.googleapis.com/auth/calendar.acls.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GOOGLECALENDAR_ACL_INSERT","description":"Creates an access control rule for a calendar. Use when you need to grant sharing permissions to a user, group, or domain.","inputSchema":{"type":"object","properties":{"calendar_id":{"type":"string","description":"Calendar identifier. To retrieve calendar IDs call the calendarList.list method. If you want to access the primary calendar of the currently logged in user, use the \"primary\" keyword.\nExamples:\n  \"primary\"\n  \"user@example.com\""},"role":{"type":"string","enum":["none","freeBusyReader","reader","writer","owner"],"description":"The role assigned to the scope. Possible values: \"none\" - Provides no access; \"freeBusyReader\" - Provides read access to free/busy information; \"reader\" - Provides read access to the calendar; \"writer\" - Provides read and write access to the calendar; \"owner\" - Provides ownership of the calendar.\nExamples:\n  \"reader\"\n  \"writer\"\n  \"owner\""},"scope":{"type":"object","properties":{"type":{"type":"string","enum":["default","user","group","domain"],"description":"The type of the scope. Possible values: \"default\" - The public scope (any user); \"user\" - Limits the scope to a single user; \"group\" - Limits the scope to a group; \"domain\" - Limits the scope to a domain.\nExamples:\n  \"user\"\n  \"group\"\n  \"domain\"\n  \"default\""},"value":{"type":["string","null"],"description":"The email address of a user or group, or the name of a domain, depending on the scope type. Omitted for type 'default'.\nExamples:\n  \"user@example.com\"\n  \"group@example.com\"\n  \"example.com\"","default":null}},"required":["type"],"additionalProperties":false,"description":"The extent to which calendar access is granted by this ACL rule. Specifies who gets the access (user, group, domain, or default)."},"send_notifications":{"type":["boolean","null"],"description":"Whether to send notifications about the calendar sharing change. Optional. The default is true.\nExamples:\n  true\n  false","default":null}},"required":["calendar_id","role","scope"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create ACL Rule","scopes":["https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/calendar.acls"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GOOGLECALENDAR_ACL_PATCH","description":"Updates an existing access control rule for a calendar using patch semantics (partial update). This allows modifying specific fields without affecting other properties. IMPORTANT: The ACL rule must already exist on the calendar. This action cannot create new rules. If you receive a 404 Not Found error, the rule does not exist - use ACL insert to create it first, or use ACL list to verify available rules. Each patch request consumes three quota units. For domain-type ACL rules, if PATCH fails with 500 error, this action will automatically fallback to UPDATE method.","inputSchema":{"type":"object","properties":{"calendar_id":{"type":"string","description":"Calendar identifier. To retrieve calendar IDs call the calendarList.list method. If you want to access the primary calendar of the currently logged in user, use the \"primary\" keyword.\nExamples:\n  \"primary\"\n  \"example@group.calendar.google.com\""},"role":{"type":["string","null"],"description":"The role assigned to the scope. Possible values are: \"none\" - Provides no access; \"freeBusyReader\" - Provides read access to free/busy information; \"reader\" - Provides read access to the calendar (private events appear but details are hidden); \"writer\" - Provides read and write access to the calendar (private events and details are visible); \"owner\" - Provides ownership of the calendar (all permissions of writer plus ability to see and manipulate ACLs).\nExamples:\n  \"reader\"\n  \"writer\"\n  \"owner\"","default":null},"rule_id":{"type":"string","description":"ACL rule identifier of an existing rule. IMPORTANT: The rule must already exist on the calendar - this action cannot create new rules, only modify existing ones. Use the ACL list action to find existing rule IDs, or use the ACL insert action to create a new rule first. Format: 'type:value', such as 'user:email@example.com' or 'group:group@example.com'.\nExamples:\n  \"user:test.user@example.com\"\n  \"group:team@example.com\"\n  \"domain:example.com\""},"scope":{"anyOf":[{"type":"object","properties":{"type":{"type":"string","description":"The type of the scope. Possible values are: \"default\" - The public scope; \"user\" - Limits the scope to a single user; \"group\" - Limits the scope to a group; \"domain\" - Limits the scope to a domain.\nExamples:\n  \"user\"\n  \"group\"\n  \"domain\""},"value":{"type":["string","null"],"description":"The email address of a user or group, or the name of a domain, depending on the scope type. Omitted for type 'default'.\nExamples:\n  \"user@example.com\"\n  \"example.com\"","default":null}},"required":["type"],"additionalProperties":false,"description":"AclRuleScope"},{"type":"null"}],"description":"The extent to which calendar access is granted by this ACL rule. Optional for patch operations.","default":null},"send_notifications":{"type":["boolean","null"],"description":"Whether to send notifications about the calendar sharing change. Note that there are no notifications on access removal. Optional. The default is True.\nExamples:\n  true\n  false","default":null}},"required":["calendar_id","rule_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Patch ACL Rule","scopes":["https://www.googleapis.com/auth/calendar.acls","https://www.googleapis.com/auth/calendar"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":true}},{"name":"GOOGLECALENDAR_ACL_WATCH","description":"Tool to watch for changes to ACL resources. Use when you need to set up real-time notifications for access control list modifications on a calendar.","inputSchema":{"type":"object","properties":{"address":{"type":"string","description":"The address where notifications are delivered for this channel.\nExample: \"https://example.com/notifications\""},"calendarId":{"type":"string","description":"Calendar identifier. To retrieve calendar IDs call the calendarList.list method. If you want to access the primary calendar of the currently logged in user, use the \"primary\" keyword.\nExample: \"primary\""},"id":{"type":"string","description":"A UUID or similar unique string that identifies this channel.\nExample: \"01234567-89ab-cdef-0123456789ab\""},"maxResults":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}],"description":"Maximum number of entries returned on one result page. By default the value is 100 entries. The page size can never be larger than 250 entries. Optional.","default":null},"pageToken":{"type":["string","null"],"description":"Token specifying which result page to return. Optional.","default":null},"params":{"anyOf":[{"type":"object","properties":{"ttl":{"type":["string","null"],"description":"Time-to-live in seconds for the notification channel. Default is 604800 seconds (one week).\nExample: \"3600\"","default":null}},"additionalProperties":false,"description":"AclWatchRequestParams"},{"type":"null"}],"description":"Additional parameters controlling delivery channel behavior. Optional.","default":null},"showDeleted":{"type":["boolean","null"],"description":"Whether to include deleted ACLs in the result. Deleted ACLs are represented by role equal to 'none'. Deleted ACLs will always be included if syncToken is provided. Optional.","default":null},"syncToken":{"type":["string","null"],"description":"Token obtained from the nextSyncToken field returned on the last page of results from the previous list request. It makes the result of this list request contain only entries that have changed since then. All entries deleted since the previous list request will always be in the result set and it is not allowed to set showDeleted to False. Optional.","default":null},"token":{"type":["string","null"],"description":"An arbitrary string delivered to the target address with each notification delivered over this channel. Optional.\nExample: \"target=myApp-myAclChannelDest\"","default":null},"type":{"type":"string","description":"The type of delivery mechanism used for this channel. Valid values are \"web_hook\" or \"webhook\".\nExample: \"web_hook\"","default":"web_hook"}},"required":["address","calendarId","id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Watch ACL Changes","scopes":["https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/calendar.acls","https://www.googleapis.com/auth/calendar.acls.readonly"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GOOGLECALENDAR_BATCH_EVENTS","description":"Execute up to 1000 event mutations (create/patch/delete) in one Google Calendar HTTP batch request with per-item status/results. Use this to materially reduce round-trips for bulk operations like migrations, cleanup, or large-scale updates.","inputSchema":{"type":"object","properties":{"fail_fast":{"type":"boolean","description":"If true, stop processing after the first batch containing any 4xx error (except 404 on DELETE). Default is false.","default":false},"operations":{"type":"array","items":{"type":"object","properties":{"body":{"anyOf":[{"type":"object","properties":{},"additionalProperties":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"boolean"},{"type":"object","properties":{},"additionalProperties":true},{"type":"array"}]}},{"type":"null"}],"description":"Request body containing event resource data. Required for POST and PATCH, omitted for DELETE.\nExample: {\"end\":{\"dateTime\":\"2025-01-16T11:00:00\",\"timeZone\":\"UTC\"},\"start\":{\"dateTime\":\"2025-01-16T10:00:00\",\"timeZone\":\"UTC\"},\"summary\":\"Team Meeting\"}","default":null},"calendar_id":{"type":"string","description":"Calendar identifier (email address or 'primary' for main calendar).\nExamples:\n  \"primary\"\n  \"user@example.com\""},"event_id":{"type":["string","null"],"description":"Event identifier. Required for PATCH and DELETE operations, omitted for POST (create).\nExample: \"abc123def456ghi789\"","default":null},"method":{"type":"string","enum":["POST","PATCH","DELETE"],"description":"HTTP method for this operation: POST (create event), PATCH (update event), or DELETE (remove event).\nExamples:\n  \"POST\"\n  \"PATCH\"\n  \"DELETE\""},"op_id":{"type":"string","description":"Client-chosen identifier for this operation, used to correlate request with response.\nExamples:\n  \"op1\"\n  \"create_meeting_1\"\n  \"delete_old_event\""},"query_params":{"anyOf":[{"type":"object","properties":{},"additionalProperties":{"anyOf":[{"type":"string"},{"type":"integer"},{"type":"boolean"}]}},{"type":"null"}],"description":"Query parameters for the operation (e.g., sendUpdates, conferenceDataVersion, maxAttendees).\nExample: {\"conferenceDataVersion\":1,\"sendUpdates\":\"all\"}","default":null}},"required":["calendar_id","method","op_id"],"additionalProperties":false,"description":"Single operation in a batch request."},"minItems":1,"maxItems":1000,"description":"List of batch operations to execute. Maximum 1000 operations per request."}},"required":["operations"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Batch Events","scopes":["https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/calendar.events"],"readOnlyHint":false,"openWorldHint":false,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GOOGLECALENDAR_CALENDAR_LIST_DELETE","description":"Tool to remove a calendar from the user's calendar list. Use when you need to unsubscribe from or hide a calendar from the user's list.","inputSchema":{"type":"object","properties":{"calendar_id":{"type":"string","description":"Calendar identifier. To retrieve calendar IDs call the calendarList.list method. If you want to access the primary calendar of the currently logged in user, use the 'primary' keyword.\nExamples:\n  \"primary\"\n  \"example_calendar_id@group.calendar.google.com\""}},"required":["calendar_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove Calendar from List","scopes":["https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/calendar.app.created","https://www.googleapis.com/auth/calendar.calendarlist"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"GOOGLECALENDAR_CALENDAR_LIST_GET","description":"Retrieves metadata for a SINGLE specific calendar from the user's calendar list by its calendar ID. This action requires a calendarId parameter and returns details about that one calendar only. NOTE: This does NOT list all calendars. To list all calendars in the user's calendar list, use GOOGLECALENDAR_CALENDAR_LIST_LIST instead.","inputSchema":{"type":"object","properties":{"calendarId":{"type":"string","description":"Required. The calendar identifier for the single calendar to retrieve. Use 'primary' for the primary calendar of the authenticated user, or provide a specific calendar ID (e.g., an email address or group calendar ID). To find calendar IDs, first use GOOGLECALENDAR_CALENDAR_LIST_LIST to list all calendars.\nExamples:\n  \"primary\"\n  \"user@example.com\"\n  \"calendarid@group.calendar.google.com\""}},"required":["calendarId"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get Single Calendar by ID","scopes":["https://www.googleapis.com/auth/calendar.readonly","https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/calendar.app.created","https://www.googleapis.com/auth/calendar.calendarlist","https://www.googleapis.com/auth/calendar.calendarlist.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GOOGLECALENDAR_CALENDAR_LIST_INSERT","description":"Inserts an existing calendar into the user's calendar list.","inputSchema":{"type":"object","properties":{"background_color":{"type":["string","null"],"description":"The background color of the calendar in the Web UI. (Hexadecimal color code)\nExample: \"#000000\"","default":null},"color_id":{"type":["string","null"],"description":"The color of the calendar. This is an ID referring to an entry in the calendarCore color palette.\nExample: \"1\"","default":null},"color_rgb_format":{"type":["boolean","null"],"description":"Whether to use the foregroundColor and backgroundColor fields to write the calendar colors (RGB). If this feature is used, the index-based colorId field will be set to the best matching option automatically. Optional. The default is False.","default":null},"default_reminders":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"method":{"type":"string","description":"The method used by this reminder (e.g., 'email', 'popup')."},"minutes":{"type":"integer","description":"Number of minutes before the start of the event when the reminder should trigger."}},"required":["method","minutes"],"additionalProperties":false,"description":"EventReminder"}},{"type":"null"}],"description":"The default reminders that the authenticated user has for this calendar.","default":null},"foreground_color":{"type":["string","null"],"description":"The foreground color of the calendar in the Web UI. (Hexadecimal color code)\nExample: \"#FFFFFF\"","default":null},"hidden":{"type":["boolean","null"],"description":"Whether the calendar has been hidden from the list. Accepts only boolean values: true or false. If not specified, the API defaults to false.","default":null},"id":{"type":"string","description":"The identifier of the calendar to insert. Must be a valid calendar ID in email format (e.g., 'user@example.com' for a user's calendar or 'calendarid@group.calendar.google.com' for a shared calendar). Note: The 'primary' keyword is not supported for this operation - use the actual email address of the primary calendar instead. The calendar must exist and you must have appropriate access permissions.\nExamples:\n  \"examplecalendar@group.calendar.google.com\"\n  \"user@example.com\""},"notification_settings":{"anyOf":[{"type":"object","properties":{"notifications":{"anyOf":[{"type":"array","items":{"type":"object","properties":{"method":{"type":"string","description":"The method used by this notification (e.g., 'email')."},"type":{"type":"string","description":"The type of notification (e.g., 'eventCreation', 'eventChange')."}},"required":["method","type"],"additionalProperties":false,"description":"Notification"}},{"type":"null"}],"description":"The list of notifications.","default":null}},"additionalProperties":false,"description":"NotificationSetting"},{"type":"null"}],"description":"The notifications that the authenticated user is receiving for this calendar.","default":null},"selected":{"type":["boolean","null"],"description":"Whether the calendar is selected and visible in the calendar list. Accepts only boolean values: true or false. If not specified, the API defaults to false.","default":null},"summary_override":{"type":["string","null"],"description":"The summary that the authenticated user has set for this calendar.","default":null}},"required":["id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Insert Calendar into List","scopes":["https://www.googleapis.com/auth/calendar.calendarlist","https://www.googleapis.com/auth/calendar"],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"GOOGLECALENDAR_CALENDAR_LIST_LIST","description":"Returns the calendars on the user's calendar list. Use when you need to retrieve all calendars visible to the authenticated user.","inputSchema":{"type":"object","properties":{"maxResults":{"anyOf":[{"type":"integer","minimum":1,"maximum":250},{"type":"null"}],"description":"Maximum number of entries returned on one result page. By default the value is 100 entries. The page size can never be larger than 250 entries. Optional.","default":null},"minAccessRole":{"anyOf":[{"type":"string","enum":["freeBusyReader","owner","reader","writer"],"description":"MinAccessRole"},{"type":"null"}],"description":"The minimum access role for the user in the returned entries. Optional. The default is no restriction.\nExamples:\n  \"freeBusyReader\"\n  \"owner\"\n  \"reader\"\n  \"writer\"","default":null},"pageToken":{"type":["string","null"],"description":"Token specifying which result page to return. Optional.","default":null},"showDeleted":{"type":["boolean","null"],"description":"Whether to include deleted calendar list entries in the result. Optional. The default is False.","default":null},"showHidden":{"type":["boolean","null"],"description":"Whether to show hidden entries. Optional. The default is False.","default":null},"syncToken":{"type":["string","null"],"description":"Token obtained from the nextSyncToken field returned on the last page of results from the previous list request. It makes the result of this list request contain only entries that have changed since then. If only read-only fields changed, the entry won't be returned. All entries deleted and hidden since the previous list request will always be in the result set and it is not allowed to set showDeleted neither showHidden to False. To ensure client state consistency minAccessRole query parameter cannot be specified together with nextSyncToken. If the syncToken expires, the server will respond with a 410 GONE response code and the client should clear its storage and perform a full synchronization without any syncToken. Learn more about incremental synchronization. Optional. The default is to return all entries.","default":null}},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"List Calendar List","scopes":["https://www.googleapis.com/auth/calendar.readonly","https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/calendar.calendarlist","https://www.googleapis.com/auth/calendar.calendarlist.readonly"],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"GOOGLECALENDAR_CALENDAR_LIST_PATCH","description":"Updates an existing calendar on the user's calendar list using patch semantics. This method allows partial updates, modifying only the specified fields.","inputSchema":{"type":"object","properties":{"backgroundColor":{"type":["string","null"],"description":"Hex color for calendar background.\nExample: \"#0088aa\"","default":null},"calendar_id":{"type":"string","description":"Calendar identifier. To retrieve calendar IDs call the calendarList.list method. Use \"primary\" keyword for the currently logged in user's primary calendar.\nExamples:\n  \"primary\"\n  \"examplecalendar@group.calendar.google.com\"\n  \"c_abc123def456@group.calendar.google.com\""},"col