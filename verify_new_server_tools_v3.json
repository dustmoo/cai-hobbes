event: message
data: {"result":{"tools":[{"name":"CLICKUP_ADD_DEPENDENCY","description":"Adds a 'waiting on' or 'blocking' dependency to a task, requiring either `depends_on` (task becomes waiting on) or `dependency_of` (task becomes blocking), but not both; `team_id` is required if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"If true, `task_id` and related task IDs are custom (text-based), requiring `team_id`.\nExamples:\n  \"true\"\n  \"false\"","default":null},"dependency_of":{"type":["string","null"],"description":"ID of the task that will depend on `task_id` ('blocking' relationship). Use this or `depends_on`, not both.\nExamples:\n  \"task_id_C\"\n  \"custom_ref_789\"","default":null},"depends_on":{"type":["string","null"],"description":"ID of the task that `task_id` will depend on ('waiting on' relationship). Use this or `dependency_of`, not both.\nExamples:\n  \"task_id_B\"\n  \"custom_ref_456\"","default":null},"task_id":{"type":"string","description":"Unique identifier of the task to which a dependency relationship will be added.\nExamples:\n  \"123\"\n  \"custom_id_abc\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Team ID, required if `custom_task_ids` is true to look up tasks by custom IDs (unique per team).\nExamples:\n  \"12345\"\n  \"67890\"","default":null}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add dependency","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_TAG_TO_TASK","description":"Adds an existing tag to a specified task; team_id is required if custom_task_ids is true.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"A boolean flag indicating whether the `task_id` provided is a custom task ID. If `true`, the `team_id` must also be provided.\nExamples:\n  true\n  false"},"tag_name":{"type":"string","description":"The name of the tag to add to the task. The tag must already exist in the workspace.\nExamples:\n  \"urgent\"\n  \"frontend_dev\""},"task_id":{"type":"string","description":"The ID of the task to which the tag will be added. This can be the standard task ID or a custom task ID if `custom_task_ids` is set to `true`.\nExamples:\n  \"task_abc_123\"\n  \"custom_id_456\""},"team_id":{"type":"integer","description":"The ID of the team (formerly Workspace) to which the task belongs. This is required only if `custom_task_ids` is set to `true`. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  123456\n  789012"}},"required":["tag_name","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add tag to task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_ADD_TASK_LINK","description":"Links two existing and accessible ClickUp tasks, identified by `task_id` (source) and `links_to` (target).","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"Set to `true` to indicate that `task_id` and `links_to` are custom task IDs rather than standard numerical IDs. If `true`, `team_id` must also be provided.\nExamples:\n  \"true\"\n  \"false\"","default":null},"links_to":{"type":"string","description":"The ID of the target task.\nExamples:\n  \"a5s6d7f8\"\n  \"target_task_id_example\""},"task_id":{"type":"string","description":"The ID of the source task.\nExamples:\n  \"q1w2e3r4\"\n  \"task_id_example\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The ID of the team, used when `custom_task_ids` is true to identify tasks by custom IDs. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"45678\"","default":null}},"required":["links_to","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Add task link","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_A_TIME_ENTRY","description":"Creates a new time entry for a specified team.","inputSchema":{"type":"object","properties":{"assignee":{"type":"integer","description":"The user ID of the person to assign this time entry to. Workspace owners and admins can assign to any user ID. Workspace members can only assign to their own user ID.\nExample: 555123"},"billable":{"type":"boolean","description":"Indicates whether the time entry is billable. Set to `true` if billable, `false` or omit if not.\nExamples:\n  true\n  false"},"custom_task_ids":{"type":"boolean","description":"If `true`, the `tid` parameter will be interpreted as a custom task ID. If this is `true`, the `team_id` query parameter must also be provided to specify the team context for the custom task ID.\nExamples:\n  true\n  false"},"description":{"type":"string","description":"An optional description for the time entry.\nExample: \"Worked on API integration module\""},"duration":{"type":"integer","description":"The duration of the time entry in milliseconds. Note: If `start` and `end` (or `stop`) times are also provided in the request, the ClickUp API will calculate the duration based on `start` and `end`/`stop`, and this `duration` field's value might be ignored or overridden by the server.\nExample: 3600000"},"end":{"type":"integer","description":"Alias for `stop`. The end time of the time entry, as a Unix timestamp in milliseconds. If both `start` and `end` are provided, the API will use these to determine the entry's actual duration, potentially overriding the `duration` field sent in the request.\nExample: 1672534800000"},"start":{"type":"integer","description":"The start time of the time entry, as a Unix timestamp in milliseconds.\nExample: 1672531200000"},"stop":{"type":"integer","description":"The stop time of the time entry, as a Unix timestamp in milliseconds. If both `start` and `stop` are provided, the API will use these to determine the entry's actual duration, potentially overriding the `duration` field sent in the request.\nExample: 1672534800000"},"tags":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"An array of Tag objects to apply to the time entry. Each Tag object should define 'name' (string), 'tag_fg' (hex color string for foreground), and 'tag_bg' (hex color string for background). This feature is available for users on the ClickUp Business Plan and above.\nExample: \"[{\\\"name\\\": \\\"Urgent\\\", \\\"tag_fg\\\": \\\"#FF0000\\\", \\\"tag_bg\\\": \\\"#FFFFFF\\\"}, {\\\"name\\\": \\\"ClientX\\\", \\\"tag_fg\\\": \\\"#0000FF\\\", \\\"tag_bg\\\": \\\"#EEEEEE\\\"}]\""},"team_Id":{"type":"integer","description":"The Workspace ID (also called Team ID in ClickUp API) where the time entry will be added. This goes in the URL path.\nExample: 123456"},"team_id":{"type":"integer","description":"The ID of the Team, required only if `custom_task_ids` is set to `true`. This specifies the team context for the custom task ID. Example: `custom_task_ids=true&team_id=123`.\nExample: 789012"},"tid":{"type":"string","description":"The ID of the task to associate this time entry with. If `custom_task_ids` is `true`, this should be the custom task ID.\nExamples:\n  \"abc123xyz\"\n  \"custom_id_456\""}},"required":["duration","start","team_Id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_FOLDER","description":"Creates a new ClickUp Folder within the specified Space, which must exist and be accessible.","inputSchema":{"type":"object","properties":{"name":{"type":"string","description":"The name of the Folder to be created.\nExample: \"New Project Folder\""},"space_id":{"type":"integer","description":"Numerical ID of the Space in which to create the Folder.\nExample: \"12345678\""}},"required":["name","space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create folder","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_GOAL","description":"Creates a new goal in a ClickUp Team (Workspace).","inputSchema":{"type":"object","properties":{"color":{"type":"string","description":"Hex color string to associate with the goal.\nExamples:\n  \"#FF5733\"\n  \"#33FF57\""},"description":{"type":"string","description":"Detailed description for the goal.\nExample: \"Achieve a 20% increase in Q3 sales.\""},"due_date":{"type":"integer","description":"Due date for the goal, as a Unix timestamp in milliseconds.\nExample: 1672444800000"},"multiple_owners":{"type":"boolean","description":"Set to `true` if the goal will have multiple owners; `false` for a single owner.\nExamples:\n  true\n  false"},"name":{"type":"string","description":"Name for the goal.\nExample: \"Q3 Sales Target\""},"owners":{"type":"array","items":{"type":"integer"},"description":"List of user IDs to be assigned as owners of the goal.\nExample: [183,281]"},"team_id":{"type":"integer","description":"Numeric ID of the ClickUp Team (Workspace) where the goal will be created.\nExample: 123456"}},"required":["color","description","due_date","multiple_owners","name","owners","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create goal","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_LIST","description":"Creates a new list in ClickUp within an existing folder. This action requires a folder_id - lists cannot be created directly in a Space using this action. If you need to create a list directly in a Space (without placing it in a folder), use the 'CLICKUP_CREATE_FOLDERLESS_LIST' action with space_id instead.","inputSchema":{"type":"object","properties":{"assignee":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Optional. Numerical user ID of the assignee.\nExample: \"9876543\"","default":null},"content":{"type":["string","null"],"description":"Optional descriptive content or notes for the list.\nExamples:\n  \"Detailed plan for all Q3 marketing activities.\"\n  \"Tasks related to the initial phase of Project Alpha.\"","default":null},"due_date":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Optional due date for the list, represented as a POSIX timestamp in milliseconds. For example, `1695110307000` for September 19, 2023, 07:58:27 AM GMT.\nExample: \"1695110307000\"","default":null},"due_date_time":{"type":["boolean","null"],"description":"Optional. A boolean flag indicating whether the `due_date` includes a specific time. If `True`, the time component of `due_date` is respected. If `False` or not provided, the list is considered due on the entire day specified by `due_date`.\nExamples:\n  \"true\"\n  \"false\"","default":null},"folder_id":{"type":"integer","description":"The unique numerical identifier of the folder where the new list will be created. Note: This action creates a list within an existing folder. A folder_id is required and space_id cannot be used. If you want to create a list directly in a Space (without a folder), use the 'CLICKUP_CREATE_FOLDERLESS_LIST' action instead.\nExample: \"123456789\""},"name":{"type":"string","description":"The name to be assigned to the new list.\nExamples:\n  \"Q3 Marketing Plan\"\n  \"Project Alpha Tasks\""},"priority":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Optional priority level for the list. Integer values map to: 1 (Urgent), 2 (High), 3 (Normal), 4 (Low).\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\"","default":null},"status":{"type":["string","null"],"description":"Optional. Defines the list's color in the ClickUp UI (e.g., 'red', 'blue'). **Important:** This 'status' refers to the visual color of the list itself, not the workflow statuses (like 'To Do', 'In Progress') of tasks within the list.\nExamples:\n  \"red\"\n  \"blue\"\n  \"custom_color_status\"","default":null}},"required":["folder_id","name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_SPACE","description":"Creates a new ClickUp Space within a specified Workspace, allowing feature configuration which defaults to Workspace settings if unspecified.","inputSchema":{"type":"object","properties":{"features__checklists__enabled":{"type":"boolean","description":"Enable/disable Checklists. Defaults to Workspace setting if `None`.\nExample: true"},"features__custom__fields__enabled":{"type":"boolean","description":"Enable/disable Custom Fields. Defaults to Workspace setting if `None`.\nExample: true"},"features__dependency__warning__enabled":{"type":"boolean","description":"Enable/disable Dependency Warning (shows conflict warnings). Defaults to Workspace setting if `None`.\nExample: true"},"features__due__dates__enabled":{"type":"boolean","description":"Enable/disable Due Dates. Defaults to Workspace setting if `None`.\nExample: true"},"features__due__dates__remap__closed__due__date":{"type":"boolean","description":"Enable/disable closed subtask due date remapping (if Due Dates & subtask remapping enabled). Defaults to Workspace setting if `None`.\nExample: false"},"features__due__dates__remap__due__dates":{"type":"boolean","description":"Enable/disable subtask due date remapping (if Due Dates enabled). Defaults to Workspace setting if `None`.\nExample: true"},"features__due__dates__start__date":{"type":"boolean","description":"Enable/disable Start Date for Due Dates (if Due Dates enabled). Defaults to Workspace setting if `None`.\nExample: true"},"features__portfolios__enabled":{"type":"boolean","description":"Enable/disable Portfolios. Defaults to Workspace setting if `None`.\nExample: true"},"features__remap__dependencies__enabled":{"type":"boolean","description":"Enable/disable Remap Dependencies (auto-adjusts task dates). Defaults to Workspace setting if `None`.\nExample: true"},"features__tags__enabled":{"type":"boolean","description":"Enable/disable Tags. Defaults to Workspace setting if `None`.\nExample: true"},"features__time__estimates__enabled":{"type":"boolean","description":"Enable/disable Time Estimates. Defaults to Workspace setting if `None`.\nExample: true"},"features__time__tracking__enabled":{"type":"boolean","description":"Enable/disable Time Tracking. Defaults to Workspace setting if `None`.\nExample: true"},"multiple_assignees":{"type":"boolean","description":"Enable/disable multiple assignees for tasks in this Space.\nExample: true"},"name":{"type":"string","description":"Name for the new Space.\nExample: \"Marketing Q3 Campaign\""},"team_id":{"type":"integer","description":"Numeric ID of the Workspace (Team) for the new Space.\nExample: \"123456\""}},"required":["multiple_assignees","name","team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create space","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_TASK","description":"Creates a new ClickUp task in a specific list, optionally as a subtask if a `parent` task ID (which cannot be a subtask itself and must be in the same list) is provided.","inputSchema":{"type":"object","properties":{"assignees":{"type":"array","items":{"type":"integer"},"description":"User IDs to assign to the task.\nExamples:\n  \"183\"\n  \"281\""},"check_required_custom_fields":{"type":"boolean","description":"`True` to enforce filling all required Custom Fields upon creation."},"custom_fields":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"Custom fields to apply. See ClickUp API for structure."},"custom_item_id":{"type":"integer","description":"Custom task type ID. Omit or use `null` for standard tasks (recommended). Custom task types including Milestones (ID `1`) are subject to workspace plan quotas. Only specify a custom_item_id if you have confirmed the workspace has available quota for that task type. Use GET /team/{team_id}/custom_item to check available custom task types and their quotas."},"custom_task_ids":{"type":"boolean","description":"Enables referencing tasks by custom task ID; requires `team_id` if `true`."},"description":{"type":"string","description":"Task's detailed description."},"due_date":{"type":"integer","description":"Due date as a Unix timestamp in milliseconds.\nExample: \"1700000000000\""},"due_date_time":{"type":"boolean","description":"`True` if `due_date` includes a specific time, `false` if it's an all-day task."},"links_to":{"type":"string","description":"ID of an existing task to link as a dependency."},"list_id":{"type":"integer","description":"The ID of the list where the task will be created."},"name":{"type":"string","description":"The name of the new task.\nExample: \"Implement user authentication module\""},"notify_all":{"type":"boolean","description":"`True` to send notifications to all task watchers, including the creator."},"parent":{"type":"string","description":"ID of an existing task to be the parent (creating a subtask). Parent must not be a subtask and must be in the same list."},"priority":{"type":"integer","description":"Priority level: 1 (Urgent), 2 (High), 3 (Normal), 4 (Low).\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\""},"start_date":{"type":"integer","description":"Start date as a Unix timestamp in milliseconds.\nExample: \"1690000000000\""},"start_date_time":{"type":"boolean","description":"`True` if `start_date` includes a specific time, `false` if it's an all-day task."},"status":{"type":"string","description":"Status to set for the task. Must be an exact match (case-sensitive) to one of the status names configured in the target list. Each ClickUp list has its own set of available statuses. Use the GET /list/{list_id} endpoint to retrieve available statuses before creating tasks. If omitted, the task will be created with the list's default status."},"tags":{"type":"array","items":{"type":"string"},"description":"Tag names to apply.\nExamples:\n  \"important\"\n  \"backend_dev\""},"team_id":{"type":"integer","description":"Team ID, required only if `custom_task_ids` is `true`."},"time_estimate":{"type":"integer","description":"Estimated time to complete, in milliseconds.\nExample: \"3600000\""}},"required":["list_id","name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create a task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_CREATE_TASK_COMMENT","description":"Adds a comment to a ClickUp task; `team_id` is required if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"assignee":{"type":"integer","description":"The user ID of the person to whom this specific comment should be assigned or mentioned. This assigns the comment, not the task.\nExamples:\n  183\n  54321"},"comment_text":{"type":"string","description":"The text content for the comment. Supports ClickUp's comment formatting (e.g., mentions, markdown).\nExamples:\n  \"@JohnDoe please review this.\"\n  \"Progress update: 75% complete.\"\n  \"This is an important update!\""},"custom_task_ids":{"type":"boolean","description":"Set to `true` to indicate that the `task_id` provided is a custom task ID. If `true`, the `team_id` must also be provided."},"notify_all":{"type":"boolean","description":"If `true`, notifications for this comment will be sent to all users watching the task, including the comment's creator. If `false`, notifications will be sent according to standard ClickUp notification rules (e.g., to mentioned users, comment assignee)."},"task_id":{"type":"string","description":"Unique task identifier for the comment. Can be standard or custom if `custom_task_ids` is true.\nExamples:\n  \"abc123xyz\"\n  \"custom-task-001\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Team ID, required if `custom_task_ids` is true to locate the task by its custom ID.\nExamples:\n  123\n  456","default":null}},"required":["assignee","comment_text","notify_all","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Create task comment","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_A_TIME_ENTRY","description":"Deletes an existing time entry, specified by `timer_id`, from a Workspace identified by `team_id`.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"Unique identifier of the Workspace from which the time entry will be deleted.\nExample: \"1234567\""},"timer_id":{"type":"integer","description":"Unique identifier of the time entry to be deleted.\nExample: \"9876543\""}},"required":["team_id","timer_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_COMMENT","description":"Deletes an existing comment from a task using its `comment_id`.","inputSchema":{"type":"object","properties":{"comment_id":{"type":"integer","description":"The unique identifier of the comment to be deleted.\nExamples:\n  \"123\"\n  \"456\""}},"required":["comment_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete comment","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_DELETE_DEPENDENCY","description":"Removes a dependency relationship for a task. Provide exactly one of: `depends_on` to remove a 'waiting on' dependency (task_id is blocked by another task), or `dependency_of` to remove a 'blocking' dependency (another task is blocked by task_id). `team_id` is required if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"If true, interprets `task_id` and the dependency task ID as custom task IDs; `team_id` also required.\nExamples:\n  \"true\"\n  \"false\"","default":null},"dependency_of":{"type":["string","null"],"description":"Identifier of the task that depends on `task_id` (i.e., this task is blocked by `task_id`). Provide this to remove a 'blocking' dependency. Mutually exclusive with `depends_on` - exactly one must be provided.\nExample: \"ghi789rst\"","default":null},"depends_on":{"type":["string","null"],"description":"Identifier of the task that `task_id` depends on (i.e., `task_id` is waiting on this task). Provide this to remove a 'waiting on' dependency. Mutually exclusive with `dependency_of` - exactly one must be provided.\nExample: \"def456uvw\"","default":null},"task_id":{"type":"string","description":"Identifier of the task from which the dependency relationship will be removed.\nExample: \"abc123xyz\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Numeric team ID, required only when `custom_task_ids` is true to scope custom task IDs.\nExample: \"12345\"","default":null}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete dependency","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_FOLDER","description":"Permanently and irreversibly deletes a specified folder and all its contents (Lists, Tasks) if the folder_id exists.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"The unique numerical identifier of the folder to be deleted."}},"required":["folder_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete folder","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_GOAL","description":"Permanently removes an existing Goal, identified by its `goal_id`, from the Workspace.","inputSchema":{"type":"object","properties":{"goal_id":{"type":"string","description":"The unique identifier (UUID) of the Goal to be deleted.\nExample: \"900e-462d-a849-4a216b06d930\""}},"required":["goal_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete goal","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_LIST","description":"Permanently deletes an existing List and all its contents; this action is destructive and irreversible via the API.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"The unique numerical identifier of the List to be deleted. This ID can be found by navigating to the List in ClickUp; the ID is often present in the URL.\nExamples:\n  \"123\"\n  \"4567\""}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_SPACE","description":"Permanently deletes a specified Space in ClickUp; this action is irreversible as the Space cannot be recovered via the API.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"Unique numerical ID of the Space to be deleted.\nExample: \"183090932\""}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete space","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_TASK","description":"Permanently deletes a task, using its standard ID or a custom task ID (requires `custom_task_ids=true` and `team_id`).","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Set to `true` if `task_id` is a custom ID (requires `team_id` if `true`).\nExamples:\n  \"true\"\n  \"false\""},"task_id":{"type":"string","description":"Unique ID of the task to delete. Can be a standard ID or a custom task ID (if custom, `custom_task_ids` must be `true`).\nExample: \"1a2b3c4d\""},"team_id":{"type":"integer","description":"Team ID. Required only if `custom_task_ids` is `true` to identify the team for the custom task ID.\nExample: \"98765\""}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_DELETE_TASK_LINK","description":"Deletes an existing link, effectively a dependency or relationship, between two ClickUp tasks; set `custom_task_ids=true` and provide `team_id` if using custom task IDs.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"If `task_id` and `links_to` refer to custom task IDs (rather than standard ClickUp task IDs), this parameter must be set to `true`. Setting this to `true` also requires `team_id` to be provided. Defaults to `false` if not specified.\nExample: \"true\""},"links_to":{"type":"string","description":"The ID of the second task involved in the link. If `custom_task_ids` is `true`, this should be its custom task ID.\nExamples:\n  \"task_id_2\"\n  \"custom_task_xyz\""},"task_id":{"type":"string","description":"The ID of the first task involved in the link. If `custom_task_ids` is `true`, this should be its custom task ID.\nExamples:\n  \"task_id_1\"\n  \"custom_task_abc\""},"team_id":{"type":"integer","description":"The numerical ID of the team. This parameter is required and used only when `custom_task_ids` is set to `true` to correctly scope the custom task IDs. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"456\""}},"required":["links_to","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Delete task link","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_GET_AUTHORIZED_USER","description":"Retrieves the details of the currently authenticated ClickUp user.","inputSchema":{"type":"object","properties":{},"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get authorized user","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_CUSTOM_TASK_TYPES","description":"Retrieves all custom task types available within a specified Workspace (team_id).","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"Numeric ID of the Workspace (formerly Team) for which to retrieve custom task types.\nExample: \"12345678\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get custom task types","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_FOLDER","description":"Retrieves detailed information about a specific folder in ClickUp.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"The unique identifier of the folder.\nExample: \"123456789\""}},"required":["folder_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get folder","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_FOLDERS","description":"Retrieves Folders within a specified ClickUp Space, ensuring `space_id` is valid, with an option to filter by archived status.","inputSchema":{"type":"object","properties":{"archived":{"type":["boolean","null"],"description":"Filter Folders by archived status. `True` for archived, `False` for unarchived. Omit to return both.\nExamples:\n  \"true\"\n  \"false\"","default":null},"space_id":{"type":"integer","description":"The unique numeric identifier of the Space from which to retrieve Folders.\nExamples:\n  \"1234567\"\n  \"9876543\""}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get folders","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_GOAL","description":"Retrieves detailed information for an existing ClickUp Goal, specified by its unique `goal_id`.","inputSchema":{"type":"object","properties":{"goal_id":{"type":"string","description":"The unique identifier (UUID) of the Goal to retrieve.\nExamples:\n  \"900e-462d-a849-4a216b06d930\"\n  \"123a-bcde-567f-ghij-890k123l456m\""}},"required":["goal_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get goal","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_GOALS","description":"Retrieves goals for a specified ClickUp Workspace (Team); the `team_id` must be valid and accessible.","inputSchema":{"type":"object","properties":{"include_completed":{"type":["boolean","null"],"description":"If true, include completed goals in the response.\nExamples:\n  true\n  false","default":null},"team_id":{"type":"integer","description":"The unique numerical identifier of the Workspace (Team) for which to retrieve goals.\nExamples:\n  123456\n  987654"}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get goals","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_LIST","description":"Retrieves detailed information for an existing List in ClickUp, identified by its unique `list_id`.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"The unique identifier for the List to retrieve. This ID can be found by right-clicking a List in the ClickUp sidebar, selecting 'Copy link', and the ID is the last part of the URL after '/l/' or '/li/'.\nExample: \"12345678\""}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get list","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_LIST_MEMBERS","description":"Retrieves all members of a specific, existing ClickUp List by its ID.","inputSchema":{"type":"object","properties":{"list_id":{"type":"integer","description":"Unique identifier of the ClickUp List. Found by extracting the numerical ID from the List's URL in ClickUp.\nExample: \"123456789\""}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get list members","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_LISTS","description":"Retrieves all lists within a specified, existing ClickUp folder, optionally filtering by archived status.","inputSchema":{"type":"object","properties":{"archived":{"type":["boolean","null"],"description":"Filter lists by archived status. If `true`, returns archived lists; if `false` or omitted, returns unarchived lists.\nExamples:\n  \"true\"\n  \"false\"","default":null},"folder_id":{"type":"integer","description":"The unique identifier of the Folder from which to retrieve lists.\nExample: \"1800000000\""}},"required":["folder_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get lists","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_SPACE","description":"Retrieves detailed information for an existing Space in a ClickUp Workspace, identified by its unique space_id.","inputSchema":{"type":"object","properties":{"space_id":{"type":"integer","description":"Unique ID of the Space to retrieve.\nExamples:\n  \"1234567\"\n  \"9876543\""}},"required":["space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get space","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_SPACES","description":"Retrieves Spaces for a Team ID; member information for private Spaces is returned only if the authenticated user is a member.","inputSchema":{"type":"object","properties":{"archived":{"type":["boolean","null"],"description":"Filter by archived status (`true` for archived, `false` for active); API default if omitted.\nExamples:\n  \"true\"\n  \"false\"","default":null},"team_id":{"type":"integer","description":"Identifier for the Team (Workspace).\nExample: 1234567"}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get spaces","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASK","description":"Retrieves comprehensive details for a ClickUp task by its ID, supporting standard or custom task IDs (requires `team_id` for custom IDs).","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"Set to `true` to indicate that the `task_id` provided is a custom task ID. If `true`, `team_id` must also be provided. If omitted or `false` (default), `task_id` is treated as a standard task ID.\nExamples:\n  \"true\"\n  \"false\"","default":null},"include_markdown_description":{"type":["boolean","null"],"description":"Set to `true` to return the task description in Markdown format. If omitted or `false` (default), the description is returned in plain text. For example: `?include_markdown_description=true`.\nExamples:\n  \"true\"\n  \"false\"","default":null},"include_subtasks":{"type":["boolean","null"],"description":"Set to `true` to include subtasks in the task details response. If omitted or `false` (default), subtasks are not included.\nExamples:\n  \"true\"\n  \"false\"","default":null},"task_id":{"type":"string","description":"The unique identifier of the task to retrieve. This can be the standard ClickUp task ID or a custom task ID if `custom_task_ids` is set to `true` (in which case `team_id` is also required).\nExamples:\n  \"9hz\"\n  \"custom_id_example\"\n  \"abc123_def456\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The ID of the team. This parameter is required and used only when `custom_task_ids` is set to `true` to identify the custom task ID within that specific team. For example: `custom_task_ids=true&team_id=123`.\nExamples:\n  \"123\"\n  \"456789\"","default":null}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get task","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASK_COMMENTS","description":"Retrieves up to 25 comments for a specified task, supporting pagination using `start` and `start_id` to fetch older comments.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Indicates if `task_id` is a custom task ID; if true, `team_id` is required.\nExamples:\n  \"true\"\n  \"false\""},"start":{"type":"integer","description":"Unix timestamp (in milliseconds) of the oldest visible comment, used with `start_id` for paginating older comments.\nExample: \"1678886400000\""},"start_id":{"type":"string","description":"ID of the oldest visible comment, used with `start` for paginating older comments.\nExample: \"abc-123-xyz-789\""},"task_id":{"type":"string","description":"Unique identifier of the task. Can be a standard or custom task ID (if `custom_task_ids` is true).\nExamples:\n  \"task123\"\n  \"custom_abc\""},"team_id":{"type":"integer","description":"Team ID, required if `custom_task_ids` is true.\nExample: \"123456\""}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get task comments","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASK_MEMBERS","description":"Retrieves users with explicit access (directly assigned or shared) to a specific existing task, excluding users with inherited permissions.","inputSchema":{"type":"object","properties":{"task_id":{"type":"string","description":"The unique identifier of the task for which to retrieve members.\nExample: \"900900202020\""}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get task members","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TASKS","description":"Retrieves tasks from a specified ClickUp list; only tasks whose home is the given list_id are returned.","inputSchema":{"type":"object","properties":{"archived":{"type":"boolean","description":"Include or exclude archived tasks."},"assignees":{"type":"array","items":{"type":"string"},"description":"Filter tasks by assignee user IDs. Accepts a single ID or a list of IDs. IDs can be numeric (e.g., 212519251) or strings (e.g., '212519251').\nExamples:\n  [\"212519251\",\"987654321\"]\n  212519251"},"custom_fields":{"type":"array","items":{"type":"string"},"description":"Filter tasks by custom field values. Provide a list of JSON strings, each defining a custom field filter. Example for a single filter: '[{\"field_id\":\"field_id_1\",\"operator\":\"=\",\"value\":\"field_value_1\"}]'. For multiple filters: '[{\"field_id\":\"field_id_1\",\"operator\":\"=\",\"value\":\"field_value_1\"}, {\"field_id\":\"field_id_2\",\"operator\":\"<\",\"value\":5}]'. See ClickUp API documentation for more on filtering with Custom Fields.\nExample: [\"{\\\"field_id\\\":\\\"abcdefghi12345678\\\",\\\"operator\\\":\\\"=\\\",\\\"value\\\":\\\"1234\\\"}\",\"{\\\"field_id\\\":\\\"jklmnop123456\\\",\\\"operator\\\":\\\"<\\\",\\\"value\\\":\\\"5\\\"}\"]"},"custom_items":{"type":"array","items":{"type":"integer"},"description":"Filter by custom task types. For example: `?custom_items[]=0&custom_items[]=1300`. Including `0` returns tasks. Including `1` returns Milestones. Including any other number returns the custom task type as defined in your Workspace."},"date_created_gt":{"type":"integer","description":"Filter tasks with a creation date greater than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_created_lt":{"type":"integer","description":"Filter tasks with a creation date less than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_done_gt":{"type":"integer","description":"Filter tasks with a completion date greater than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_done_lt":{"type":"integer","description":"Filter tasks with a completion date less than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_updated_gt":{"type":"integer","description":"Filter tasks with an update date greater than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"date_updated_lt":{"type":"integer","description":"Filter tasks with an update date less than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"due_date_gt":{"type":"integer","description":"Filter tasks with a due date greater than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"due_date_lt":{"type":"integer","description":"Filter tasks with a due date less than the provided Unix timestamp in milliseconds.\nExample: 1609459200000"},"include_closed":{"type":"boolean","description":"Include tasks with a closed status.\nExamples:\n  true\n  false"},"include_markdown_description":{"type":"boolean","description":"Return task descriptions in Markdown format.\nExample: true"},"list_id":{"type":"integer","description":"The ID of the list to retrieve tasks from. To find the list_id, copy the link to the list from the ClickUp UI; the list_id is the number following '/li' in the URL.\nExample: 123456789"},"order_by":{"type":"string","description":"Field to order tasks by. Valid options are: 'id', 'created', 'updated', and 'due_date'.\nExamples:\n  \"id\"\n  \"created\"\n  \"updated\"\n  \"due_date\""},"page":{"type":"integer","description":"The page number of results to fetch, starting at 0. Each page can contain up to 100 tasks.\nExamples:\n  0\n  1\n  2"},"reverse":{"type":"boolean","description":"Display tasks in reverse order based on the 'order_by' field.\nExamples:\n  true\n  false"},"statuses":{"type":"array","items":{"type":"string"},"description":"Filter tasks by their status. Pass a list of status strings. Use URL encoding for statuses with spaces (e.g., 'to%20do'). To include closed tasks, use the `include_closed` parameter.\nExample: [\"to do\",\"in progress\"]"},"subtasks":{"type":"boolean","description":"Include subtasks in the results.\nExamples:\n  true\n  false"},"tags":{"type":"array","items":{"type":"string"},"description":"Filter tasks by a list of tag names. Use URL encoding for tags with spaces (e.g., 'this%20tag').\nExample: [\"tag1\",\"this tag\"]"}},"required":["list_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get tasks","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TEAMS","description":"Retrieves user groups (Teams) from a ClickUp Workspace, typically requiring `team_id` (Workspace ID), with an option to filter by `group_ids`.","inputSchema":{"type":"object","properties":{"group_ids":{"type":["string","null"],"description":"Comma-separated string of user group IDs to filter results; if omitted, all user groups in the Workspace are returned.\nExample: \"03g1f034-71e4-4f10-8ced-987514848f02,a9b8c7d6-e5f4-g3h2-i1j0-k9l8m7n6o5p4\"","default":null},"team_id":{"type":"integer","description":"ID of the ClickUp Workspace (Team ID) from which to retrieve user groups. Must be a valid positive integer representing an existing workspace. Use the CLICKUP_AUTHORIZATION_GET_WORK_SPACE_LIST action to retrieve available workspace IDs.\nExample: \"90161390966\""}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get teams","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_TRACKED_TIME","description":"Retrieves tracked time for a task using a legacy endpoint; prefer newer Time Tracking API endpoints for managing time entries.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"Set to `true` if the `task_id` provided is a custom task ID. If `true`, the `team_id` must also be provided.\nExample: true"},"task_id":{"type":"string","description":"The ID of the task for which to retrieve tracked time. This can be the standard task ID or a custom task ID if `custom_task_ids` is set to `true`.\nExample: \"abc123efg\""},"team_id":{"type":"integer","description":"The ID of the team. This is required and used only when the `custom_task_ids` parameter is set to `true`. For example: `custom_task_ids=true&team_id=123`.\nExample: 1234567"}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get tracked time","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_GET_USER","description":"Retrieves detailed information for a specific user within a ClickUp Workspace (Team), available only for Workspaces on the ClickUp Enterprise Plan.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"ID of the Team (Workspace) containing the user.\nExample: \"18251903\""},"user_id":{"type":"integer","description":"ID of the user whose details are to be retrieved.\nExample: \"5539995\""}},"required":["team_id","user_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Get user","scopes":[],"readOnlyHint":true,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_REMOVE_CUSTOM_FIELD_VALUE","description":"Removes an existing value from a Custom Field on a specific task; this does not delete the Custom Field definition or its predefined options.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":"boolean","description":"If true, `task_id` is a custom task ID, and `team_id` must also be provided.\nExamples:\n  \"true\"\n  \"false\""},"field_id":{"type":"string","description":"UUID of the Custom Field whose value will be removed from the task.\nExample: \"b8a8-48d8-a0c6-b4200788a683\""},"task_id":{"type":"string","description":"Identifier of the task. If `custom_task_ids` is true, this is the custom task ID; otherwise, it's the standard task ID.\nExamples:\n  \"standard_task_id_1\"\n  \"custom_task_ABC\""},"team_id":{"type":"integer","description":"Numeric ID of the team, required only if `custom_task_ids` is true to identify the task by its custom ID.\nExamples:\n  \"123\"\n  \"45678\""}},"required":["field_id","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove custom field value","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_REMOVE_TAG_FROM_TASK","description":"Removes a tag from a specified task by disassociating it (does not delete the tag from Workspace), succeeding even if the tag is not on the task.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"Set to `true` if you are using a custom task ID (instead of the default task ID) to identify the task. If `true`, the `team_id` must also be provided.","default":null},"tag_name":{"type":"string","description":"The name of the tag to remove from the task. Tag names are case-sensitive.\nExamples:\n  \"urgent\"\n  \"frontend\"\n  \"bug-fix\""},"task_id":{"type":"string","description":"The ID of the task from which the tag will be removed. This can be the standard task ID or a custom task ID if `custom_task_ids` is set to `true`.\nExamples:\n  \"task_abc_123\"\n  \"custom_id_456\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The Workspace (Team) ID associated with the task.\nExamples:\n  123456\n  789012","default":null}},"required":["tag_name","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Remove tag from task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":true,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_SET_CUSTOM_FIELD_VALUE","description":"Sets or updates a Custom Field's value for a task; the new value (with type-dependent structure, e.g., `{\"value\": \"text\"}` or `{\"value\": 123, \"value_options\": {\"currency_type\":\"USD\"}}`) is provided in the JSON request body.","inputSchema":{"type":"object","properties":{"custom_task_ids":{"type":["boolean","null"],"description":"If true, `task_id` is treated as a Custom Task ID, and `team_id` is required.","default":null},"field_id":{"type":"string","description":"UUID of the Custom Field to update (must be in standard UUID format with hyphens, e.g., '0f079e26-feef-410d-8e8d-2a21a057ee5e'). Obtainable via 'Get Accessible Custom Fields' or 'Get Task' endpoints.\nExamples:\n  \"062f7a9a-5c92-4180-bb59-82a66947fed2\"\n  \"c2b5e1f3-0a8d-4e6f-9b2c-7123456789ab\""},"task_id":{"type":"string","description":"Task ID to update. Standard ID, or Custom Task ID if `custom_task_ids` is true.\nExamples:\n  \"abc123de\"\n  \"task-xyz-789\""},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"Team ID, required if `custom_task_ids` is true.\nExamples:\n  \"123\"\n  \"45678\"","default":null},"value":{"description":"The value to set for the Custom Field. Structure depends on field type: Text/Short Text: string (e.g., 'Hello'). Number/Currency/Emoji(Rating): number (e.g., 42). Checkbox: boolean (true/false). Dropdown: option UUID string from type_config.options (e.g., '7a4e5845-8496-4b9f-9097-843b9c737692'). Date: Unix timestamp in milliseconds (e.g., 1645502400000). Email: valid email string. Phone: string with country code (e.g., '+1 123 456 7890'). URL: valid URL string. Labels: array of label UUIDs from type_config (e.g., ['label_id_1', 'label_id_2']). Users/Tasks: object with 'add' and/or 'rem' arrays of IDs (e.g., {'add': ['id1'], 'rem': ['id2']}). Location: object with 'location' (lat/lng) and 'formatted_address' (e.g., {'location': {'lat': -28.0, 'lng': 153.4}, 'formatted_address': 'Gold Coast, Australia'}). Manual Progress: object with 'current' value (e.g., {'current': 50}).\nExamples:\n  \"Hello World\"\n  42\n  true\n  \"7a4e5845-8496-4b9f-9097-843b9c737692\"\n  1645502400000"},"value_options":{"anyOf":[{"type":"object","properties":{},"additionalProperties":true},{"type":"null"}],"description":"Optional settings for certain field types. For Date fields: {'time': true} to display time in ClickUp UI. For Currency fields: {'currency_type': 'USD'} to specify currency.\nExamples:\n  {\"time\":true}\n  {\"currency_type\":\"USD\"}","default":null}},"required":["field_id","task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Set custom field value","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_START_A_TIME_ENTRY","description":"Starts a new time entry (timer) in the specified Team (Workspace), optionally associating it with a task, adding a description, setting billable status, or applying tags (tags feature requires Business Plan or higher).","inputSchema":{"type":"object","properties":{"billable":{"type":["boolean","null"],"description":"Specifies if the time entry is billable.\nExamples:\n  true\n  false","default":null},"custom_task_ids":{"type":["boolean","null"],"description":"If set to `true`, the `tid` field will be interpreted as a custom task ID. Requires `team_id` query parameter to be set for custom task ID resolution.\nExample: true","default":null},"description":{"type":["string","null"],"description":"Description for the time entry.\nExamples:\n  \"Working on API integration\"\n  \"Client meeting follow-up\"","default":null},"tags":{"anyOf":[{"type":"array","items":{"type":"object","properties":{},"additionalProperties":{"type":"string"}}},{"type":"null"}],"description":"Array of tag objects (each with \"name\", optionally \"tag_bg\", \"tag_fg\" for colors) to apply. This feature requires Business Plan or higher. E.g., `[{\"name\": \"Urgent\", \"tag_bg\": \"#FF0000\"}]`.\nExample: [\"[{\\\"name\\\": \\\"billed\\\", \\\"tag_bg\\\": \\\"#000000\\\"}]\",\"[{\\\"name\\\": \\\"dev work\\\"}]\"]","default":null},"team_Id":{"type":"integer","description":"The Workspace ID (also called Team ID in ClickUp API) for this time entry. This goes in the URL path.\nExample: 123456"},"team_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The ID of the team for resolving custom task IDs. Required only if `custom_task_ids` is set to `true`. For example: `custom_task_ids=true&team_id=123`.\nExample: 123","default":null},"tid":{"type":["string","null"],"description":"The ID of the task to associate with this time entry. If `custom_task_ids` is true, this should be the custom task ID.\nExamples:\n  \"task_abc_123\"\n  \"custom_id_456\"","default":null}},"required":["team_Id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Start a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_STOP_A_TIME_ENTRY","description":"Stops the authenticated user's currently active time entry in the specified Team (Workspace), which requires an existing time entry to be running.","inputSchema":{"type":"object","properties":{"team_id":{"type":"integer","description":"The unique numeric identifier of the Team (Workspace) where the time entry is being tracked.\nExamples:\n  1234567\n  8765432"}},"required":["team_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Stop a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_A_TIME_ENTRY","description":"Updates an existing ClickUp time entry; provide `start` and `end` times together, and include `team_id` as a query param (request field `team_id_1`) if `custom_task_ids` is true.","inputSchema":{"type":"object","properties":{"billable":{"type":"boolean","description":"Indicates whether the time entry is billable.\nExamples:\n  \"true\"\n  \"false\""},"custom_task_ids":{"type":"boolean","description":"If `true`, `tid` is interpreted as a custom task ID, and the `team_id` query parameter (request field `team_id_1`) must also be provided.\nExamples:\n  \"true\"\n  \"false\""},"description":{"type":"string","description":"A new description for the time entry.\nExample: \"Completed initial draft of the report\""},"duration":{"type":"integer","description":"New duration of the time entry in milliseconds; can be an alternative to `start` and `end` times.\nExample: \"3600000\""},"end":{"type":"integer","description":"New end time (Unix timestamp in milliseconds). If provided, `start` must also be provided.\nExample: \"1678890000000\""},"start":{"type":"integer","description":"New start time (Unix timestamp in milliseconds). If provided, `end` must also be provided.\nExample: \"1678886400000\""},"tag_action":{"type":"string","description":"Specifies how to handle `tags` (e.g., 'add', 'remove').\nExamples:\n  \"add\"\n  \"remove\""},"tags":{"type":"array","items":{"type":"object","properties":{},"additionalProperties":true},"description":"List of tag objects (e.g., `{'name': 'your-tag'}`) for the time entry. Time tracking labels are for Business Plan and above users.\nExample: [{\"name\":\"Design\"},{\"name\":\"Development\"}]"},"team_id":{"type":"integer","description":"The Team (Workspace) ID, as a query parameter; required if `custom_task_ids` is `true`."},"tid":{"type":"string","description":"The ID of the task for this time entry; if `custom_task_ids` is `true`, this should be the custom task ID.\nExamples:\n  \"av1-123\"\n  \"custom_task_id_example\""},"timer_id":{"type":"integer","description":"The unique identifier of the time entry to update. Path parameter."}},"required":["tags","team_id","timer_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update a time entry","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_COMMENT","description":"Updates an existing task comment's text, assignee (who must be a valid workspace member), or resolution status, requiring a valid existing comment_id.","inputSchema":{"type":"object","properties":{"assignee":{"type":"integer","description":"User ID of the assignee for the comment.\nExamples:\n  183\n  281"},"comment_id":{"type":"integer","description":"The unique identifier of the comment to be updated.\nExample: 123456789"},"comment_text":{"type":"string","description":"The new text content for the comment.\nExamples:\n  \"Please review this updated design mockup.\"\n  \"Let's discuss this in our next meeting.\""},"resolved":{"type":"boolean","description":"Set to `true` to mark the comment as resolved, or `false` to mark it as unresolved.\nExamples:\n  true\n  false"}},"required":["assignee","comment_id","comment_text","resolved"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update comment","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_UPDATE_FOLDER","description":"Updates the name of an existing folder in ClickUp.","inputSchema":{"type":"object","properties":{"folder_id":{"type":"integer","description":"Unique identifier of the folder to update."},"name":{"type":"string","description":"New name for the folder.\nExamples:\n  \"Updated Project Documents\"\n  \"Q4 Marketing Initiatives\""}},"required":["folder_id","name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update folder","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":true,"updateHint":false}},{"name":"CLICKUP_UPDATE_GOAL","description":"Updates attributes of an existing ClickUp goal, identified by its `goal_id`.","inputSchema":{"type":"object","properties":{"add_owners":{"type":"array","items":{"type":"integer"},"description":"User IDs to add as owners.\nExample: [403,512]"},"color":{"type":"string","description":"New color (hex code).\nExample: \"#FF0000\""},"description":{"type":"string","description":"New description for the goal.\nExample: \"Finalize the Q3 marketing strategy and present to stakeholders.\""},"due_date":{"type":"integer","description":"New due date (Unix timestamp in milliseconds).\nExample: 1678886400000"},"goal_id":{"type":"string","description":"Unique identifier (UUID) of the goal to update.\nExample: \"900e-462d-a849-4a216b06d930\""},"name":{"type":"string","description":"New name for the goal.\nExample: \"Q3 Marketing Strategy Finalization\""},"rem_owners":{"type":"array","items":{"type":"integer"},"description":"User IDs to remove as owners.\nExample: [183,281]"}},"required":["add_owners","color","description","due_date","goal_id","name","rem_owners"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update goal","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_LIST","description":"Updates attributes of an existing ClickUp list, such as its name, content, due date, priority, assignee, or color status, identified by its `list_id`.","inputSchema":{"type":"object","properties":{"assignee":{"type":"string","description":"User ID to be set as the assignee for the list, replacing any existing assignee.\nExamples:\n  \"183\"\n  \"456789\""},"content":{"type":"string","description":"New description or informational content for the list.\nExamples:\n  \"All tasks related to Project Alpha release.\"\n  \"Detailed plan for Q3 marketing initiatives.\""},"due_date":{"type":"integer","description":"New due date for the list, as a Unix timestamp in milliseconds (e.g., `1672531199000` for Dec 31, 2022, 11:59:59 PM UTC).\nExamples:\n  \"1672531199000\"\n  \"1704067199000\""},"due_date_time":{"type":"boolean","description":"Indicates if `due_date` includes a specific time; if `false`, it's an all-day event.\nExamples:\n  true\n  false"},"list_id":{"type":"string","description":"ID of the list to be updated."},"name":{"type":"string","description":"New name for the list.\nExamples:\n  \"Project Alpha Tasks\"\n  \"Q3 Marketing Plan\""},"priority":{"type":"integer","description":"Priority level: `1` (Urgent), `2` (High), `3` (Normal), `4` (Low), or `0` to unset.\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\"\n  \"0\""},"status":{"type":"string","description":"Color for the list (e.g., 'red' or '#FF0000'), visually representing its status (not task status).\nExamples:\n  \"blue\"\n  \"red\"\n  \"#2CA01C\"\n  \"darkorange\""},"unset_status":{"type":"boolean","description":"Set to `true` to remove the list's color, overriding `status`; if `false`, `status` updates or maintains current color.\nExamples:\n  true\n  false"}},"required":["assignee","content","due_date","due_date_time","list_id","name","priority","status","unset_status"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update list","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_SPACE","description":"Updates an existing ClickUp Space, allowing modification of its name, color, privacy, and feature settings (ClickApps).","inputSchema":{"type":"object","properties":{"admin_can_manage":{"type":["boolean","null"],"description":"Whether admins can manage this private Space. This is an Enterprise Plan feature. Must be omitted for non-Enterprise workspaces.\nExample: true","default":null},"color":{"type":"string","description":"The new color for the Space, in hexadecimal format.\nExample: \"#a2d2ff\""},"features__checklists__enabled":{"type":["boolean","null"],"description":"Enable or disable the Checklists ClickApp.\nExample: true","default":null},"features__custom_fields__enabled":{"type":["boolean","null"],"description":"Enable or disable the Custom Fields ClickApp.\nExample: true","default":null},"features__dependency_warning__enabled":{"type":["boolean","null"],"description":"Enable or disable Dependency Warning for the Task Dependencies ClickApp.\nExample: true","default":null},"features__due_dates__enabled":{"type":["boolean","null"],"description":"Enable or disable the Due Dates ClickApp.\nExample: true","default":null},"features__due_dates__remap_closed_due_date":{"type":["boolean","null"],"description":"Enable or disable remapping of closed due dates for the Due Dates ClickApp.\nExample: true","default":null},"features__due_dates__remap_due_dates":{"type":["boolean","null"],"description":"Enable or disable remapping of due dates for the Due Dates ClickApp.\nExample: true","default":null},"features__due_dates__start_date":{"type":["boolean","null"],"description":"Enable or disable Start Dates for the Due Dates ClickApp.\nExample: true","default":null},"features__portfolios__enabled":{"type":["boolean","null"],"description":"Enable or disable the Portfolios ClickApp.\nExample: true","default":null},"features__remap_dependencies__enabled":{"type":["boolean","null"],"description":"Enable or disable Remap Dependencies for the Task Dependencies ClickApp.\nExample: true","default":null},"features__tags__enabled":{"type":["boolean","null"],"description":"Enable or disable the Tags ClickApp. When any feature parameter is provided, all feature keys must be included (due_dates, time_estimates, time_tracking, remap_dependencies, custom_fields, dependency_warning, tags, checklists, portfolios).\nExample: true","default":null},"features__time_estimates__enabled":{"type":["boolean","null"],"description":"Enable or disable the Time Estimates ClickApp.\nExample: true","default":null},"features__time_tracking__enabled":{"type":["boolean","null"],"description":"Enable or disable the Time Tracking ClickApp.\nExample: true","default":null},"multiple_assignees":{"type":"boolean","description":"Whether tasks in this Space can have multiple assignees.\nExample: true"},"name":{"type":"string","description":"The new name for the Space.\nExample: \"Updated Space Name\""},"private":{"type":"boolean","description":"Whether the Space should be private.\nExample: true"},"space_id":{"type":"integer","description":"The ID of the Space to update.\nExample: 123456"}},"required":["color","multiple_assignees","name","private","space_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update space","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}},{"name":"CLICKUP_UPDATE_TASK","description":"Updates attributes of an existing task; `team_id` is required if `custom_task_ids` is true, use a single space (\" \") for `description` to clear it, and provide at least one modifiable field.","inputSchema":{"type":"object","properties":{"archived":{"type":"boolean","description":"True to archive, false to unarchive.\nExamples:\n  \"true\"\n  \"false\""},"assignees__add":{"type":"array","items":{"type":"integer"},"description":"List of user IDs to add as assignees.\nExamples:\n  \"[183]\"\n  \"[123, 456]\""},"assignees__rem":{"type":"array","items":{"type":"integer"},"description":"List of user IDs to remove as assignees.\nExamples:\n  \"[789]\"\n  \"[101, 202]\""},"custom_item_id":{"type":"integer","description":"Custom task type ID. Use `1` for Milestone, its ID for custom type. Omit/`None` to make regular task (API's 'null' equivalent).\nExamples:\n  \"1\"\n  \"2\""},"custom_task_ids":{"type":"boolean","description":"If true, `task_id` is a custom ID and `team_id` is required.\nExamples:\n  \"true\"\n  \"false\""},"description":{"type":"string","description":"New task description; use a single space (\" \") to clear.\nExamples:\n  \"Updated task details.\"\n  \" \""},"due_date":{"type":"integer","description":"New due date (Unix timestamp in milliseconds).\nExamples:\n  \"1678886400000\"\n  \"1700000000000\""},"due_date_time":{"type":"boolean","description":"True if `due_date` includes time, false if all-day.\nExamples:\n  \"true\"\n  \"false\""},"name":{"type":"string","description":"New task name.\nExamples:\n  \"Finalize Q3 Report\"\n  \"Urgent: Fix login bug\""},"parent":{"type":"string","description":"ID of new parent task to make this a subtask; cannot convert subtask to regular task this way.\nExamples:\n  \"task_id_parent_abc\"\n  \"task_id_parent_xyz\""},"priority":{"type":"integer","description":"Priority: 1 (Urgent), 2 (High), 3 (Normal), 4 (Low). Omit or `None` to remove.\nExamples:\n  \"1\"\n  \"2\"\n  \"3\"\n  \"4\""},"start_date":{"type":"integer","description":"New start date (Unix timestamp in milliseconds).\nExamples:\n  \"1678880000000\"\n  \"1690000000000\""},"start_date_time":{"type":"boolean","description":"True if `start_date` includes time, false if all-day.\nExamples:\n  \"true\"\n  \"false\""},"status":{"type":"string","description":"New task status (case-sensitive, must be valid in Workspace).\nExamples:\n  \"in progress\"\n  \"complete\"\n  \"To Do\""},"task_id":{"type":"string","description":"Unique task identifier; use custom task ID if `custom_task_ids` is true.\nExamples:\n  \"abc123xyz\"\n  \"custom-id-007\""},"team_id":{"type":"integer","description":"Team ID, required if `custom_task_ids` is true.\nExample: \"123456\""},"time_estimate":{"type":"integer","description":"New time estimate in milliseconds.\nExamples:\n  \"3600000\"\n  \"7200000\""}},"required":["task_id"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"},"annotations":{"title":"Update task","scopes":[],"readOnlyHint":false,"openWorldHint":true,"destructiveHint":false,"idempotentHint":false,"updateHint":false}}]},"jsonrpc":"2.0","id":1}

