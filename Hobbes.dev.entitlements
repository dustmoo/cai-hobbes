<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ===== NO SANDBOX FOR DEVELOPMENT ===== -->
    <!-- Development builds run without sandbox for easier debugging -->

    <!-- ===== APP IDENTIFICATION ===== -->
    <key>com.apple.application-identifier</key>
    <string>ABXVW6PWCW.ai.clearmirror.cai-hobbes</string>
    <key>com.apple.developer.team-identifier</key>
    <string>ABXVW6PWCW</string>

    <!-- ===== KEYCHAIN ACCESS ===== -->
    <!-- Shared keychain group allows dev/release to access same secrets -->
    <key>keychain-access-groups</key>
    <array>
        <string>ABXVW6PWCW.ai.clearmirror.cai-hobbes</string>
    </array>
</dict>
</plist>
